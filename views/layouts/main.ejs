<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %><%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.nama_instansi) ? siteSettings.nama_instansi + ' ' + (siteSettings.sub_instansi || '') : 'DISKOMINFOSANTIK Kab. Bekasi' %></title>
    
    <!-- Open Graph SEO Meta Tags -->
    <% if (typeof og !== 'undefined') { %>
        <meta property="og:title" content="<%= og.title %>">
        <meta property="og:description" content="<%= og.description %>">
        <meta property="og:image" content="<%= og.image %>">
        <meta property="og:url" content="<%= og.url %>">
        <meta property="og:type" content="article">
        <meta name="twitter:card" content="summary_large_image">
    <% } else { %>
        <meta property="og:title" content="Portal <%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.nama_instansi) ? siteSettings.nama_instansi : 'DISKOMINFOSANTIK' %> <%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.sub_instansi) ? siteSettings.sub_instansi : 'Kabupaten Bekasi' %>">
        <meta property="og:description" content="<%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.deskripsi_singkat) ? siteSettings.deskripsi_singkat : 'Pusat Pelayanan Digital Masyarakat' %>">
        <meta property="og:image" content="<%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.logo_url) ? siteSettings.logo_url : '/images/logo.png' %>">
        <meta property="og:type" content="website">
    <% } %>
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Favicon Icon Tab Browser Dinamis -->
    <link rel="icon" type="image/png" href="<%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.favicon_url) ? siteSettings.favicon_url : '/images/logo.png' %>">

    <% if (typeof siteSettings !== 'undefined' && siteSettings) { %>
    <!-- INJEKSI WARNA TEMA DINAMIS ADMIN KE SEMUA HALAMAN -->
    <style id="site-dynamic-theme-vars">
        :root {
            --orange-primary: <%= siteSettings.warna_primer || '#ff6b00' %>;
            --orange-hover: <%= siteSettings.warna_primer_hover || '#e05e00' %>;
            --orange-subtle: <%= siteSettings.warna_primer_subtle || 'rgba(255, 107, 0, 0.12)' %>;
            --gradient-primary: linear-gradient(135deg, <%= siteSettings.warna_primer || '#ff6b00' %>, <%= siteSettings.warna_primer_light || '#ff8c3b' %>);
            <% if (siteSettings.warna_sekunder) { %>
            --navy-dark: <%= siteSettings.warna_sekunder %>;
            --navy-primary: <%= siteSettings.warna_sekunder %>;
            <% } %>
        }
    </style>
    <% } %>

    <!-- Anti-flicker Theme Initialization (Loads before DOM paint) -->
    <script>
        (function() {
            try {
                const savedTheme = localStorage.getItem('diskominfo_theme');
                if (savedTheme === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.setAttribute('data-theme', 'light');
                }
            } catch (e) {
                console.warn('Theme storage error:', e);
            }
        })();
    </script>
</head>
<body class="bg-light-surface">



    <!-- Header / Navbar -->
    <%- include('../partials/header') %>

    <!-- Main Dynamic Content -->
    <main>
        <%- body %>
    </main>

    <!-- Footer -->
    <%- include('../partials/footer') %>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Theme Controller Script -->
    <script>
        (function() {
            const themeBtn = document.getElementById('themeToggleBtn');

            function applyThemeUI(isDark) {
                if (themeBtn) {
                    themeBtn.setAttribute('title', isDark ? 'Beralih ke Tampilan Terang' : 'Beralih ke Tampilan Midnight Navy');
                    themeBtn.setAttribute('aria-label', isDark ? 'Beralih ke Tampilan Terang' : 'Beralih ke Tampilan Midnight Navy');
                }

                // Adaptasi Warna Font Chart.js secara dinamis
                if (window.Chart && typeof Chart.defaults !== 'undefined') {
                    Chart.defaults.color = isDark ? '#cbd5e1' : '#64748b';
                    if (Chart.defaults.borderColor) {
                        Chart.defaults.borderColor = isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.06)';
                    }
                }

                // Beritahukan halaman jika ada komponen kustom (misal map leaflet / grafik)
                window.dispatchEvent(new CustomEvent('themeChanged', { detail: { isDark, theme: isDark ? 'dark' : 'light' } }));
            }

            // Sync saat halaman pertama kali load
            const initialDark = document.documentElement.getAttribute('data-theme') === 'dark';
            applyThemeUI(initialDark);

            if (themeBtn) {
                themeBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const currentlyDark = document.documentElement.getAttribute('data-theme') === 'dark';
                    const targetTheme = currentlyDark ? 'light' : 'dark';

                    document.documentElement.setAttribute('data-theme', targetTheme);
                    localStorage.setItem('diskominfo_theme', targetTheme);
                    applyThemeUI(targetTheme === 'dark');
                });
            }
        })();
    </script>

    <!-- SweetAlert2 Modern UI -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Modul Alert Kustom & Pengganti Dialog Browser -->
    <script src="/js/site-alerts.js"></script>

    <!-- Modul Animasi Interaktif Ramah Warga -->
    <script src="/js/site-animations.js"></script>
</body>
</html>