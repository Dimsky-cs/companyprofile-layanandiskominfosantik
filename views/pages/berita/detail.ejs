<!-- BANNER HEADER ARTIKEL -->
<section class="hero-mesh text-white py-5">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row">
            <div class="col-lg-10">
                <!-- Breadcrumb Navigasi -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb small mb-2">
                        <li class="breadcrumb-item"><a href="/" class="text-white opacity-75 text-decoration-none">Beranda</a></li>
                        <li class="breadcrumb-item"><a href="/berita" class="text-white opacity-75 text-decoration-none">Berita</a></li>
                        <li class="breadcrumb-item active text-warning" style="color: var(--orange-primary) !important;"><%= berita.nama_kategori || 'Kabar Instansi' %></li>
                    </ol>
                </nav>

                <!-- Judul Artikel -->
                <h1 class="display-6 fw-bold mb-3" style="line-height: 1.3;"><%= berita.judul %></h1>

                <!-- Meta Informasi -->
                <div class="d-flex flex-wrap align-items-center gap-3 small text-light opacity-80">
                    <span class="d-flex align-items-center"><i class="bi bi-person-fill me-1.5 text-warning" style="color: var(--orange-primary) !important;"></i> <%= berita.penulis || 'Redaksi Diskominfo' %></span>
                    <span>•</span>
                    <span class="d-flex align-items-center"><i class="bi bi-calendar3 me-1.5"></i> <%= new Date(berita.created_at).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></span>
                    <span>•</span>
                    <span class="d-flex align-items-center"><i class="bi bi-clock me-1.5"></i> <%= readTime || 2 %> min read</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- KONTEN UTAMA & SIDEBAR -->
<div class="container py-5">
    <div class="row g-5">
        
        <!-- KOLOM KONTEN BACAAN (KIRI) -->
        <div class="col-lg-8">
            <div class="card-modern p-4 p-md-5 border-0 shadow-sm">

                <!-- Lencana Terverifikasi Resmi -->
                <div class="verified-release-box d-flex align-items-center justify-content-between p-3 rounded-3 border mb-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-patch-check-fill fs-4 verified-icon"></i>
                        <div>
                            <strong class="d-block small verified-title">Rilis Resmi Terverifikasi</strong>
                            <span class="verified-sub" style="font-size: 0.75rem;">Diterbitkan oleh DISKOMINFOSANTIK Kabupaten Bekasi</span>
                        </div>
                    </div>
                    <span class="badge rounded-pill px-3 py-1.5" style="background-color: var(--orange-primary); color: white; font-size: 0.72rem;">Verified Source</span>
                </div>

                <!-- Gambar Sampul Utama Artikel -->
                <% if (berita.gambar) { %>
                    <div class="mb-4 rounded-4 overflow-hidden shadow-sm">
                        <img src="<%= berita.gambar %>" alt="<%= berita.judul %>" class="w-100" style="max-height: 450px; object-fit: cover;">
                    </div>
                <% } %>

                <!-- Teks Isi Konten Artikel -->
                <article class="article-content lh-lg text-secondary fs-6 mb-5" id="articleBody" style="line-height: 1.85; font-size: 1.05rem;">
                    <%- berita.konten %>
                </article>

                <hr class="my-4">

                <!-- TOMBOL BAGIKAN ARTIKEL -->
                <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 pt-2">
                    <strong class="small text-dark d-flex align-items-center">
                        <i class="bi bi-share-fill me-2 text-warning" style="color: var(--orange-primary) !important;"></i> 
                        Bagikan Artikel Ini:
                    </strong>
                    <div class="d-flex gap-2">
                        <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(berita.judul + ' - ' + 'http://localhost:3000/berita/' + berita.slug) %>" target="_blank" class="btn btn-sm btn-success px-3 rounded-3 d-flex align-items-center gap-1.5 shadow-sm">
                            <i class="bi bi-whatsapp"></i> WhatsApp
                        </a>
                        <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(berita.judul) %>&url=<%= encodeURIComponent('http://localhost:3000/berita/' + berita.slug) %>" target="_blank" class="btn btn-sm btn-dark px-3 rounded-3 d-flex align-items-center gap-1.5 shadow-sm">
                            <i class="bi bi-twitter-x"></i> X / Twitter
                        </a>
                        <button onclick="copyArticleLink()" class="btn btn-sm btn-outline-dark px-3 rounded-3 d-flex align-items-center gap-1.5">
                            <i class="bi bi-link-45deg"></i> Salin Link
                        </button>
                    </div>
                </div>

            </div>
        </div>

        <!-- KOLOM SIDEBAR REKOMENDASI (KANAN) -->
        <div class="col-lg-4">
            <div class="card-modern p-4 border-0 shadow-sm sticky-top" style="top: 90px; z-index: 10;">
                <h6 class="fw-bold mb-3 border-bottom pb-2.5 d-flex align-items-center justify-content-between text-navy-title">
                    <span>Berita Terkini Lainnya</span>
                    <i class="bi bi-newspaper text-muted"></i>
                </h6>
                
                <div class="d-flex flex-column gap-3">
                    <% if (beritaTerkait && beritaTerkait.length > 0) { %>
                        <% beritaTerkait.forEach(item => { %>
                            <div class="d-flex gap-3 align-items-center">
                                <img src="<%= item.gambar || 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=200&auto=format&fit=crop&q=60' %>" class="rounded-3 object-fit-cover shrink-0" style="width: 75px; height: 75px;" alt="<%= item.judul %>">
                                <div>
                                    <h6 class="small fw-bold mb-1" style="line-height: 1.35;">
                                        <a href="/berita/<%= item.slug %>" class="text-dark text-decoration-none hover-orange">
                                            <%= item.judul.length > 55 ? item.judul.substring(0, 55) + '...' : item.judul %>
                                        </a>
                                    </h6>
                                    <span class="small text-muted" style="font-size: 0.72rem;">
                                        <i class="bi bi-calendar3 me-1"></i> <%= new Date(item.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                    </span>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="small text-muted mb-0">Belum ada berita terkait lainnya.</p>
                    <% } %>
                </div>

                <hr class="my-4">
                <a href="/berita" class="btn btn-sm btn-navy w-100 rounded-3 fw-semibold">
                    <i class="bi bi-grid me-1 text-warning" style="color: var(--orange-primary) !important;"></i> Lihat Semua Berita
                </a>
            </div>
        </div>

    </div>
</div>

<!-- NOTIFIKASI TOAST SUKSES SALIN LINK -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
    <div id="copyToast" class="toast align-items-center text-white bg-dark border-0 rounded-3 shadow" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body small">
                <i class="bi bi-check-circle-fill text-success me-1.5"></i> Link artikel berhasil disalin ke papan klip!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<!-- SCRIPT SALIN LINK TOAST -->
<script>
    function copyArticleLink() {
        navigator.clipboard.writeText(window.location.href).then(() => {
            const toastEl = document.getElementById('copyToast');
            if (window.bootstrap && window.bootstrap.Toast) {
                const toast = new bootstrap.Toast(toastEl, { delay: 2500 });
                toast.show();
            } else {
                alert('✅ Link artikel berhasil disalin!');
            }
        }).catch(err => {
            console.error('Gagal menyalin:', err);
        });
    }
</script>