<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verifikasi Keabsahan Dokumen Digital - DISKOMINFOSANTIK Kab. Bekasi</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <!-- Anti-flicker Theme Initialization -->
    <script>
        (function() {
            try {
                const savedTheme = localStorage.getItem('diskominfo_theme');
                if (savedTheme === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.setAttribute('data-theme', 'light');
                }
            } catch (e) {}
        })();
    </script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #071527 0%, #0a2540 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 15px;
        }
        .verify-card {
            background: #ffffff;
            border-radius: 28px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
            max-width: 680px;
            width: 100%;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }
        .verify-header {
            background: linear-gradient(135deg, #0a2540 0%, #163d66 100%);
            padding: 32px 30px;
            color: #fff;
            text-align: center;
            position: relative;
        }
        .verified-badge {
            width: 76px;
            height: 76px;
            background: #10b981;
            border: 4px solid #fff;
            box-shadow: 0 10px 25px rgba(16, 185, 129, 0.35);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.2rem;
            color: #fff;
            margin: -40px auto 16px;
            position: relative;
            z-index: 2;
        }
        /* DARK MODE DUKUNGAN VERIFIKASI */
        [data-theme="dark"] .verify-card {
            background: #0f2238 !important;
            border: 1.5px solid #1e3d63 !important;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7) !important;
        }
        [data-theme="dark"] .verify-card .bg-light {
            background-color: #0b1a2c !important;
            border-color: #1e3d63 !important;
        }
        [data-theme="dark"] .verify-card .text-dark {
            color: #f8fafc !important;
        }
        [data-theme="dark"] .verify-card .text-muted {
            color: #94a3b8 !important;
        }
        [data-theme="dark"] .verify-card .border-top {
            border-color: #1e3d63 !important;
        }
        [data-theme="dark"] .verify-card .text-warning-emphasis {
            color: #fbbf24 !important;
        }
        [data-theme="dark"] .verify-card .badge.bg-warning {
            background-color: rgba(245, 158, 11, 0.25) !important;
            color: #fbbf24 !important;
            border: 1px solid rgba(245, 158, 11, 0.4) !important;
        }
    </style>
</head>
<body>

    <div class="verify-card">
        
        <!-- HEADER KOP DINAS -->
        <div class="verify-header">
            <div class="d-flex align-items-center justify-content-center gap-3 mb-2">
                <img src="/images/logo.png" alt="Logo Bekasi" style="width: 48px; height: auto;">
                <div class="text-start">
                    <h6 class="mb-0 fw-bold tracking-wide text-white">DISKOMINFOSANTIK</h6>
                    <small class="text-white-50" style="font-size: 0.72rem; letter-spacing: 0.5px;">KABUPATEN BEKASI</small>
                </div>
            </div>
            <p class="small text-light opacity-75 mb-0">Sistem Verifikasi Otentikasi & Integritas Dokumen Elektronik</p>
        </div>

        <div class="p-4 p-md-5">

            <!-- BADGE STATUS CENTANG HIJAU -->
            <% if (surat.status === 'Disetujui') { %>
                <div class="verified-badge bg-success">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
                <div class="text-center mb-4">
                    <h4 class="fw-bold text-success mb-1">DOKUMEN RESMI TERVERIFIKASI</h4>
                    <p class="text-muted small">Dokumen ini SAH, ASLI, dan DITERBITKAN secara resmi oleh Dinas Komunikasi, Informatika, Persandian dan Statistik Kabupaten Bekasi.</p>
                </div>
            <% } else if (surat.status === 'Ditolak') { %>
                <div class="verified-badge bg-danger" style="box-shadow: 0 10px 25px rgba(239, 68, 68, 0.35);">
                    <i class="bi bi-x-circle-fill"></i>
                </div>
                <div class="text-center mb-4">
                    <h4 class="fw-bold text-danger mb-1">PERMOHONAN DITOLAK</h4>
                    <p class="text-muted small">Dokumen permohonan ini berstatus DITOLAK oleh dinas dan tidak berlaku sebagai izin/rekomendasi.</p>
                </div>
            <% } else { %>
                <div class="verified-badge bg-warning" style="box-shadow: 0 10px 25px rgba(245, 158, 11, 0.35);">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div class="text-center mb-4">
                    <h4 class="fw-bold text-warning-emphasis mb-1">DOKUMEN DALAM PROSES VERIFIKASI</h4>
                    <p class="text-muted small">Permohonan ini telah terdaftar di sistem dan saat ini sedang dalam proses review/disposisi kedinasan.</p>
                </div>
            <% } %>

            <!-- TABEL DETAIL METADATA DOKUMEN -->
            <div class="bg-light rounded-4 p-3.5 border mb-4">
                <div class="row g-2.5 small">
                    <div class="col-sm-5 text-muted">Nomor Tiket Permohonan</div>
                    <div class="col-sm-7 fw-bold font-monospace text-primary"><%= surat.nomor_surat %></div>

                    <div class="col-sm-5 text-muted">Nomor Surat Dinas Resmi</div>
                    <div class="col-sm-7 fw-bold font-monospace text-dark">500.12.7/<%= Number(surat.id) + 120 %>/DISKOMINFOSANTIK/<%= new Date().getFullYear() %></div>

                    <div class="col-sm-5 text-muted">Nama Pemohon</div>
                    <div class="col-sm-7 fw-bold text-dark"><%= surat.nama_pemohon %></div>

                    <div class="col-sm-5 text-muted">Asal Instansi / Universitas</div>
                    <div class="col-sm-7 text-dark"><%= surat.asal_instansi || '-' %></div>

                    <div class="col-sm-5 text-muted">Perihal / Jenis Layanan</div>
                    <div class="col-sm-7 fw-bold text-dark"><%= surat.jenis_surat %></div>

                    <div class="col-sm-5 text-muted">Waktu Pengajuan</div>
                    <div class="col-sm-7 text-muted"><%= new Date(surat.created_at).toLocaleString('id-ID') %> WIB</div>

                    <div class="col-sm-5 text-muted">Status Legalitas</div>
                    <div class="col-sm-7">
                        <span class="badge <%= surat.status === 'Disetujui' ? 'bg-success' : (surat.status === 'Ditolak' ? 'bg-danger' : 'bg-warning text-dark') %> px-2.5 py-1 rounded-pill">
                            <%= surat.status %>
                        </span>
                    </div>

                    <% if (surat.catatan_petugas) { %>
                    <div class="col-sm-5 text-muted">Disposisi / Catatan Petugas</div>
                    <div class="col-sm-7 text-dark fst-italic">"<%= surat.catatan_petugas %>"</div>
                    <% } %>
                </div>
            </div>

            <!-- TOMBOL AKSI DOKUMEN -->
            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                <% if (surat.status === 'Disetujui') { %>
                    <a href="/surat/cetak-resmi/<%= surat.nomor_surat %>" target="_blank" class="btn btn-primary px-4 py-2.5 rounded-pill fw-bold small">
                        <i class="bi bi-file-earmark-check-fill me-1"></i> Buka Surat Balasan Resmi
                    </a>
                <% } %>
                <a href="/surat/cetak-permohonan/<%= surat.nomor_surat %>" target="_blank" class="btn btn-outline-secondary px-4 py-2.5 rounded-pill fw-bold small">
                    <i class="bi bi-file-earmark-text-fill me-1"></i> Buka Surat Pemohon
                </a>
                <a href="/surat?tracking=<%= surat.nomor_surat %>" class="btn btn-outline-dark px-4 py-2.5 rounded-pill fw-bold small">
                    <i class="bi bi-arrow-left me-1"></i> Lacak di Portal
                </a>
            </div>

            <div class="text-center mt-4 pt-2 border-top">
                <small class="text-muted" style="font-size: 0.75rem;">
                    <i class="bi bi-shield-lock-fill text-success me-1"></i>
                    Validasi Terenkripsi DISKOMINFOSANTIK Kabupaten Bekasi • Waktu Pengecekan: <%= new Date().toLocaleString('id-ID') %> WIB
                </small>
            </div>

        </div>

    </div>

</body>
</html>
