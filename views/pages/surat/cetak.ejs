<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tanda Terima Pengajuan Surat - <%= surat.nomor_surat %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Times New Roman', Times, serif; color: #000; background: #fff; }
        .kop-surat {
            border-bottom: 3px double #000;
            padding-bottom: 12px;
            margin-bottom: 24px;
            position: relative;
            min-height: 85px;
        }
        .kop-logo {
            position: absolute;
            left: 5px;
            top: 2px;
            width: 75px;
            height: auto;
            max-height: 85px;
            object-fit: contain;
        }
        .kop-text {
            text-align: center;
            padding-left: 80px;
            padding-right: 80px;
        }
        @media (max-width: 576px) {
            .kop-logo {
                position: static;
                display: block;
                margin: 0 auto 10px;
                width: 65px;
            }
            .kop-text {
                padding-left: 0;
                padding-right: 0;
            }
        }
        @media print {
            .no-print { display: none !important; }
            body { padding: 0; }
            .kop-surat { border-bottom: 3px double #000 !important; }
        }
    </style>
</head>
<body class="p-4 p-md-5">

    <div class="no-print text-end mb-4">
        <button onclick="window.print()" class="btn btn-primary btn-sm"><i class="bi bi-printer"></i> Cetak / Simpan PDF</button>
        <button onclick="window.close()" class="btn btn-secondary btn-sm">Tutup</button>
    </div>

    <!-- KOP RESMI -->
    <div class="kop-surat position-relative">
        <img src="<%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.logo_url) ? siteSettings.logo_url : '/images/logo.png' %>" alt="Logo Pemkab Bekasi" class="kop-logo">
        <div class="kop-text">
            <h5 class="mb-0 fw-bold" style="letter-spacing: 0.5px; font-size: 13pt;">PEMERINTAH KABUPATEN BEKASI</h5>
            <h4 class="mb-0 fw-bold" style="letter-spacing: 0.5px; font-size: 14pt;">DINAS KOMUNIKASI, INFORMATIKA, PERSANDIAN DAN STATISTIK</h4>
            <p class="small mb-0" style="font-size: 9pt;">Komplek Perkantoran Pemkab Bekasi, Desa Sukamahi, Kec. Cikarang Pusat, Jawa Barat 17530</p>
            <p class="small mb-0" style="font-size: 8.5pt;">Email: diskominfo@bekasikab.go.id | Telepon: (021) 89970000</p>
        </div>
    </div>

    <div class="text-center mb-4">
        <h5 class="fw-bold text-decoration-underline mb-1">BUKTI TANDA TERIMA PENGAJUAN SURAT MANDIRI</h5>
        <p class="small">NOMOR TIKET DISPATCH: <strong><%= surat.nomor_surat %></strong></p>
    </div>

    <p class="small">Telah diterima permohonan pelayanan persuratan digital dengan rincian data sebagai berikut:</p>

    <table class="table table-bordered small align-middle">
        <tr>
            <th style="width: 30%;">Nomor Tracking / Tiket</th>
            <td><strong><%= surat.nomor_surat %></strong></td>
        </tr>
        <tr>
            <th>Nama Pemohon</th>
            <td><%= surat.nama_pemohon %></td>
        </tr>
        <tr>
            <th>NIK / Nomor Induk</th>
            <td><%= surat.nik %></td>
        </tr>
        <tr>
            <th>Asal Instansi / Lembaga</th>
            <td><%= surat.asal_instansi || '-' %></td>
        </tr>
        <tr>
            <th>Kontak Pemohon</th>
            <td><%= surat.no_hp %> (<%= surat.email %>)</td>
        </tr>
        <tr>
            <th>Jenis Permohonan</th>
            <td><strong><%= surat.jenis_surat %></strong></td>
        </tr>
        <tr>
            <th>Keperluan</th>
            <td><%= surat.keperluan %></td>
        </tr>
        <tr>
            <th>Waktu Pengajuan</th>
            <td><%= new Date(surat.created_at).toLocaleString('id-ID') %> WIB</td>
        </tr>
        <tr>
            <th>Status Saat Ini</th>
            <td><span class="badge bg-secondary"><%= surat.status %></span></td>
        </tr>
        <% if (surat.catatan_petugas) { %>
        <tr>
            <th>Catatan Petugas</th>
            <td><%= surat.catatan_petugas %></td>
        </tr>
        <% } %>
    </table>

    <div class="row align-items-center mt-5 pt-3">
        <div class="col-8">
            <p class="small text-muted mb-1">Pindai QR Code untuk memantau status secara realtime:</p>
            <% if (qrImage) { %>
                <img src="<%= qrImage %>" alt="QR Validasi" style="width: 100px; height: 100px;">
            <% } %>
        </div>
        <div class="col-4 text-center">
            <p class="small mb-4">Cikarang Pusat, <%= new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %><br>Sistem Persuratan Elektronik</p>
            <br>
            <p class="small fw-bold mb-0">DISKOMINFOSANTIK KAB. BEKASI</p>
        </div>
    </div>

</body>
</html>