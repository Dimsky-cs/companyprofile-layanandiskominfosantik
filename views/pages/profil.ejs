                    </div>
                </div>

                <!-- Jam Operasional Kedinasan -->
                <div class="p-3 rounded-3 bg-light border d-flex align-items-center justify-content-between mt-auto">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-white shadow-sm border d-flex align-items-center justify-content-center text-primary flex-shrink-0" style="width: 38px; height: 38px;">
                            <i class="bi bi-clock-history fs-6"></i>
                        </div>
                        <div>
                            <div class="fw-bold small text-dark">Jam Operasional Pelayanan</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Senin – Jumat : 08.00 – 16.00 WIB</div>
                        </div>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small fw-semibold">
                        Hari Kerja
                    </span>
                </div>
            </div>

            <!-- Kolom Kanan: Peta Google Maps Asli dari Database -->
            <div class="col-lg-7">
                <div class="h-100 rounded-4 overflow-hidden border shadow-sm position-relative d-flex flex-column" style="min-height: 420px; background: var(--bg-card-subtle, #F1F5F9);">
                    <!-- Badge Floating Lokasi -->
                    <div class="position-absolute top-0 start-0 m-3" style="z-index: 2;">
                        <span class="badge shadow-sm px-3 py-2 rounded-pill fw-semibold border d-inline-flex align-items-center gap-1.5" style="font-size: 0.78rem; background: var(--bg-card, #ffffff); color: var(--text-main, #0f172a);">
                            <i class="bi bi-geo-alt-fill text-danger"></i> Titik Lokasi Resmi
                        </span>
                    </div>

                    <% 
                        let cleanMapSrc = '';
                        if (dataProfil && dataProfil.gmaps_iframe && dataProfil.gmaps_iframe.trim() !== '') {
                            const m = dataProfil.gmaps_iframe.match(/src=["'](.*?)["']/);
                            cleanMapSrc = m ? m[1] : (dataProfil.gmaps_iframe.startsWith('http') ? dataProfil.gmaps_iframe.trim() : '');
                        }
                    %>
                    <% if (cleanMapSrc) { %>
                        <iframe src="<%= cleanMapSrc %>" width="100%" height="100%" style="border:0; min-height: 420px; flex-grow: 1; display: block;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    <% } else { %>
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted p-5 text-center flex-grow-1" style="min-height: 420px;">
                            <div class="rounded-circle shadow-sm border d-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; background: var(--bg-card, #ffffff);">
                                <i class="bi bi-geo-alt fs-2 text-danger opacity-75"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">Titik Lokasi Peta Belum Dikonfigurasi</h6>
                            <p class="small text-muted mb-0" style="max-width: 380px;">Tautan Google Maps Embed belum dimasukkan pada menu pengaturan Profil di CMS.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

</div>