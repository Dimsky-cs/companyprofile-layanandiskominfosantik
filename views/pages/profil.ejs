                <div class="modal-body inspector-body">
                    <!-- Deskripsi & Tugas Kedinasan (Satu-satunya fokus sesuai permintaan) -->
                    <div class="inspector-desc-card">
                        <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom border-secondary border-opacity-25">
                            <i class="bi bi-card-text text-primary fs-5"></i>
                            <span class="inspector-desc-title">Penjelasan Posisi & Tugas Dinas</span>
                        </div>
                        <p class="mb-0 inspector-desc-text" id="inspectorRoleDesc">
                            -
                        </p>
                    </div>
                </div>
                <div class="modal-footer inspector-footer">
                    <button type="button" class="btn btn-secondary btn-sm px-4 rounded-pill fw-bold" data-bs-dismiss="modal">Tutup</button>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPT INTERAKTIF SOTK SIMPEL & ROBUST -->
    <script>
    (function() {
        const rawEl = document.getElementById('allNodesData');
        if (!rawEl) return;

        let allNodes = [];
        try {
            allNodes = JSON.parse(rawEl.textContent || '[]');
        } catch(e) {
            allNodes = [];
        }

        // Map lookup untuk rincian modal inspector
        const nodeMap = new Map();
        allNodes.forEach(n => {
            nodeMap.set(Number(n.id), Object.assign({}, n, {
                id: Number(n.id),
                parent_id: (n.parent_id !== null && n.parent_id !== undefined && n.parent_id !== '') ? Number(n.parent_id) : null,
                children: []
            }));
        });

        // Hubungkan relasi anak & atasan
        const roots = [];
        nodeMap.forEach(n => {
            if (n.parent_id !== null && nodeMap.has(n.parent_id)) {
                nodeMap.get(n.parent_id).children.push(n);
            } else {
                roots.push(n);
            }
        });

        // ==============================================================
        // ENGINE ULTRA DINAMIS KANVAS SVG (SINKRON 100% IDENTIK DENGAN ADMIN)
        // ==============================================================
        let PUB_CARD_W = 220;
        let PUB_CARD_H = 88;
        let PUB_H_GAP  = 36;
        let PUB_V_GAP  = 72;
        let PUB_PAD    = 40;
        let pubElbowRatio = 0.50;
        let pubLineStyle  = 'orthogonal';
        let pubCustomPositions = new Map();
        let pubWingNodeIds = new Set();
        let pubNonWingNodeIds = new Set();

        let publicZoom = 1;
        let publicPanX = 0;
        let publicPanY = 0;
        let publicIsDragging = false;
        let publicStartX = 0;
        let publicStartY = 0;
        let publicNodeMap = new Map();
        let publicRoots = [];
        let publicRootTree = null;

        function applyPublicDefaultCoordinates(nodes, posMap) {
            if (!nodes || nodes.length === 0) return;
            const kadin = nodes.find(n => n.parent_id === null || (n.jabatan || '').toLowerCase().includes('kepala dinas')) || nodes[0];
            const sek = nodes.find(n => (n.jabatan || '').toLowerCase().includes('sekretar') || n.tipe_posisi === 'STAFF_SAYAP');
            const subbag = (sek ? nodes.find(n => n.parent_id === sek.id) : null) || nodes.find(n => (n.jabatan || '').toLowerCase().includes('sub') || (n.jabatan || '').toLowerCase().includes('kasubag'));
            const fung = nodes.find(n => (n.jabatan || '').toLowerCase().includes('fungsional') || (n.jabatan || '').toLowerCase().includes('koordinator'));
            
            let bidangList = nodes.filter(n => {
                if (kadin && n.id === kadin.id) return false;
                if (sek && n.id === sek.id) return false;
                if (subbag && n.id === subbag.id) return false;
                if (fung && n.id === fung.id) return false;
                return n.parent_id === (kadin ? kadin.id : null) || (n.jabatan || '').toLowerCase().includes('bidang');
            });

            bidangList.sort((a, b) => {
                const getRank = (item) => {
                    const j = (item.jabatan || '').toLowerCase();
                    if (j.includes('informasi dan komunikasi') || j.includes('ikp')) return 1;
                    if (j.includes('teknologi')) return 2;
                    if (j.includes('statistik')) return 3;
                    if (j.includes('persandian')) return 4;
                    return 5 + (Number(item.urutan) || 1);
                };
                return getRank(a) - getRank(b);
            });

            const startX = 60;
            const bGap = 36;
            const bY = 420;

            bidangList.forEach((b, idx) => {
                const bx = startX + idx * (PUB_CARD_W + bGap);
                posMap.set(Number(b.id), { x: bx, y: bY });
            });

            const totalSpan = bidangList.length > 0 ? (bidangList.length * PUB_CARD_W + (bidangList.length - 1) * bGap) : 988;
            const centerSpineX = startX + totalSpan / 2;
            const kadinX = Math.round(centerSpineX - PUB_CARD_W / 2);

            if (kadin) {
                posMap.set(Number(kadin.id), { x: kadinX, y: 40 });
            }
            if (sek) {
                const sekX = Math.round(centerSpineX + 180);
                posMap.set(Number(sek.id), { x: Math.max(sekX, 740), y: 160 });
            }
            if (subbag) {
                const subX = Math.round(centerSpineX + 268);
                posMap.set(Number(subbag.id), { x: Math.max(subX, 828), y: 290 });
            }
            if (fung) {
                posMap.set(Number(fung.id), { x: kadinX, y: 230 });
            }
        }

        // Baca config tersimpan dari admin dashboard
        let pubHasSavedPositions = false;
        const savedConfigEl = document.getElementById('publicBaganConfig');
        if (savedConfigEl && savedConfigEl.textContent) {
            try {
                const cfg = JSON.parse(savedConfigEl.textContent);
                if (cfg && typeof cfg === 'object') {
                    if (Array.isArray(cfg.wingNodes)) {
                        pubWingNodeIds = new Set(cfg.wingNodes.map(Number));
                    }
                    if (Array.isArray(cfg.nonWingNodes)) {
                        pubNonWingNodeIds = new Set(cfg.nonWingNodes.map(Number));
                    }
                    if (typeof cfg.elbowRatio === 'number') pubElbowRatio = cfg.elbowRatio;
                    if (typeof cfg.vGap === 'number') PUB_V_GAP = cfg.vGap;
                    if (typeof cfg.hGap === 'number') PUB_H_GAP = cfg.hGap;
                    if (cfg.lineStyle) pubLineStyle = (cfg.lineStyle === 'kedinasan' ? 'orthogonal' : cfg.lineStyle);
                    if (cfg.customPositions && typeof cfg.customPositions === 'object' && Object.keys(cfg.customPositions).length > 0) {
                        pubCustomPositions.clear();
                        for (const [k, v] of Object.entries(cfg.customPositions)) {
                            if (v && typeof v.x === 'number' && typeof v.y === 'number') {
                                pubCustomPositions.set(Number(k), { x: v.x, y: v.y });
                            }
                        }
                        pubHasSavedPositions = true;
                    }
                }
            } catch(e) {
                console.warn('Error parse publicBaganConfig:', e);
            }
        }
        if (!pubHasSavedPositions && allNodes && allNodes.length > 0) {
            applyPublicDefaultCoordinates(allNodes, pubCustomPositions);
        }

        // Siapkan struktur node hierarki untuk kanvas
        allNodes.forEach(n => {
            publicNodeMap.set(Number(n.id), Object.assign({}, n, {
                id: Number(n.id),
                parent_id: (n.parent_id !== null && n.parent_id !== undefined && n.parent_id !== '') ? Number(n.parent_id) : null,
                children: [],
                isCollapsed: false,
                isRoot: false,
                isParent: false,
                isLeaf: false,
                level: 0
            }));
        });

        publicRoots = [];
        publicNodeMap.forEach(n => {
            if (n.parent_id !== null && publicNodeMap.has(n.parent_id)) {
                publicNodeMap.get(n.parent_id).children.push(n);
            } else {
                publicRoots.push(n);
            }
        });

        publicNodeMap.forEach(n => {
            n.children.sort((a, b) => (Number(a.urutan) || 1) - (Number(b.urutan) || 1) || a.id - b.id);
        });
        publicRoots.sort((a, b) => (Number(a.urutan) || 1) - (Number(b.urutan) || 1) || a.id - b.id);

        function markPublicMeta(n, lvl) {
            n.level = lvl;
            n.isRoot = n.parent_id === null;
            n.isParent = n.children.length > 0;
            n.isLeaf = n.children.length === 0;
            n.children.forEach(c => markPublicMeta(c, lvl + 1));
        }
        publicRoots.forEach(r => markPublicMeta(r, 0));

        if (publicRoots.length === 1) {
            publicRootTree = publicRoots[0];
        } else {
            publicRootTree = {
                id: '__pub_virtual__',
                jabatan: 'Pimpinan Kedinasan',
                nama_pejabat: '',
                isRoot: true,
                isParent: true,
                isLeaf: false,
                level: 0,
                children: publicRoots,
                isCollapsed: false,
                isVirtual: true
            };
        }

        function measurePublicWidth(node) {
            if (node.isCollapsed || node.children.length === 0) {
                node._w = PUB_CARD_W;
            } else {
                let total = 0;
                node.children.forEach((c, idx) => {
                    measurePublicWidth(c);
                    total += c._w + (idx > 0 ? PUB_H_GAP : 0);
                });
                node._w = Math.max(PUB_CARD_W, total);
            }
            return node._w;
        }

        function assignPublicCoords(node, leftX, topY) {
            if (pubCustomPositions.has(node.id)) {
                const saved = pubCustomPositions.get(node.id);
                node._x = saved.x;
                node._y = saved.y;
            } else {
                node._y = topY;
                node._x = leftX + (node._w - PUB_CARD_W) / 2;
            }

            if (!node.isCollapsed && node.children.length > 0) {
                let curX = leftX;
                node.children.forEach(c => {
                    assignPublicCoords(c, curX, topY + PUB_CARD_H + PUB_V_GAP);
                    curX += c._w + PUB_H_GAP;
                });
            }
        }

        let pubMaxRight = 0;
        let pubMaxBottom = 0;
        function computePublicBounds(node) {
            pubMaxRight = Math.max(pubMaxRight, node._x + PUB_CARD_W);
            pubMaxBottom = Math.max(pubMaxBottom, node._y + PUB_CARD_H);
            if (!node.isCollapsed && node.children.length > 0) {
                node.children.forEach(computePublicBounds);
            }
        }

        function renderPublicTree() {
            if (!publicRootTree) return;
            const stage    = document.getElementById('publicTreeStage');
            const svg      = document.getElementById('publicTreeSvg');
            const cardsBox = document.getElementById('publicTreeCardsBox');
            if (!stage || !svg || !cardsBox) return;

            measurePublicWidth(publicRootTree);
            assignPublicCoords(publicRootTree, PUB_PAD, PUB_PAD);

            pubMaxRight = 0;
            pubMaxBottom = 0;
            computePublicBounds(publicRootTree);

            const canvasW = Math.max(1400, pubMaxRight + PUB_PAD * 3);
            const canvasH = Math.max(800, pubMaxBottom + PUB_PAD * 3);

            stage.style.width = canvasW + 'px';
            stage.style.height = canvasH + 'px';
            svg.setAttribute('width', canvasW);
            svg.setAttribute('height', canvasH);

            cardsBox.innerHTML = '';
            renderPublicCards(publicRootTree, cardsBox);
            redrawPublicSvgOnly();
            updatePublicStageTransform();
        }

        function renderPublicCards(node, cardsBox) {
            if (!node.isVirtual) {
                const card = document.createElement('div');
                const roleClass = getPublicNodeClass(node);
                card.className = `org-card ${roleClass}`;
                card.style.left = node._x + 'px';
                card.style.top  = node._y + 'px';
                card.setAttribute('data-id', node.id);

                const personHtml = node.nama_pejabat 
                    ? `<div class="org-card-name">${escapeHtml(node.nama_pejabat)}</div>` 
                    : '';

                card.innerHTML = `
                    <div class="org-card-title">${escapeHtml(node.jabatan)}</div>
                    ${personHtml}
                `;

                card.addEventListener('click', () => {
                    openNodeInspectorById(node.id);
                });

                cardsBox.appendChild(card);
            }

            if (!node.isCollapsed && node.children.length > 0) {
                node.children.forEach(c => renderPublicCards(c, cardsBox));
            }
        }

        function redrawPublicSvgOnly() {
            const svg = document.getElementById('publicTreeSvg');
            if (!svg || !publicRootTree) return;
            svg.innerHTML = '';
            renderPublicLinesRecursive(publicRootTree, svg);
        }

        function isPublicWingChild(c, allChildren) {
            if (!c) return false;
            const cId = Number(c.id);
            if (pubWingNodeIds.has(cId)) return true;
            if (pubNonWingNodeIds.has(cId)) return false;

            const tip = (c.tipe_posisi || '').toUpperCase();
            if (tip === 'STAFF_SAYAP') return true;
            if (tip === 'LINE_BIDANG' || tip === 'ROOT') return false;

            const jab = (c.jabatan || '').toLowerCase();
            if (jab.includes('sekretar') || jab.includes('staf ahli') || jab.includes('fungsional') || jab.includes('koordinator')) {
                return true;
            }
            if (allChildren && allChildren.length > 1) {
                const maxY = Math.max(...allChildren.map(ch => ch._y));
                if (maxY - c._y > PUB_CARD_H * 0.7) {
                    return true;
                }
            }
            return false;
        }

        function renderPublicLinesRecursive(node, svg) {
            if (!node.isCollapsed && node.children.length > 0) {
                const parentBottomX = node._x + PUB_CARD_W / 2;
                const parentBottomY = node.isVirtual ? node._y : node._y + PUB_CARD_H;
                const elbowY = parentBottomY + PUB_V_GAP * pubElbowRatio;

                if (pubLineStyle === 'curve') {
                    node.children.forEach(c => {
                        const childX = c._x + PUB_CARD_W / 2;
                        drawPublicSvgBezier(svg, parentBottomX, parentBottomY, childX, c._y);
                    });
                } else if (pubLineStyle === 'direct') {
                    node.children.forEach(c => {
                        const childX = c._x + PUB_CARD_W / 2;
                        drawPublicSvgLine(svg, parentBottomX, parentBottomY, childX, c._y);
                    });
                } else {
                    // Orthogonal / Siku Standar & Sayap Menyatu Dinamis
                    if (node.children.length === 1) {
                        const child = node.children[0];
                        const childX = child._x + PUB_CARD_W / 2;
                        if (Math.abs(parentBottomX - childX) < 8) {
                            drawPublicSvgLine(svg, parentBottomX, parentBottomY, parentBottomX, child._y);
                        } else {
                            const stepY = parentBottomY + (child._y - parentBottomY) * pubElbowRatio;
                            drawPublicSvgLine(svg, parentBottomX, parentBottomY, parentBottomX, stepY);
                            drawPublicSvgLine(svg, parentBottomX, stepY, childX, stepY);
                            drawPublicSvgLine(svg, childX, stepY, childX, child._y);
                        }
                    } else {
                        const wingChildren = node.children.filter(c => isPublicWingChild(c, node.children));
                        const lineChildren = node.children.filter(c => !isPublicWingChild(c, node.children));

                        if (wingChildren.length > 0 && lineChildren.length > 0) {
                            // HIERARKI KEDINASAN DUA TIER: SAYAP MENYATU + LINI BAWAH
                            const minLineY = Math.min(...lineChildren.map(c => c._y));
                            const lineBarY = minLineY - Math.max(22, Math.round(PUB_V_GAP * (1 - pubElbowRatio)));

                            // 1. Tulang Punggung Vertikal Menyatu (Central Spine)
                            drawPublicSvgLine(svg, parentBottomX, parentBottomY, parentBottomX, lineBarY);

                            // 2. Cabang ke Sayap (Menyatu dari Tulang Vertikal)
                            wingChildren.forEach(w => {
                                const wCenterX = w._x + PUB_CARD_W / 2;
                                const wingBranchY = parentBottomY + (w._y - parentBottomY) * pubElbowRatio;
                                drawPublicSvgLine(svg, parentBottomX, wingBranchY, wCenterX, wingBranchY);
                                drawPublicSvgLine(svg, wCenterX, wingBranchY, wCenterX, w._y);

                                // Garis koordinasi putus-putus untuk fungsional jika ada sekretariat
                                const isFung = (w.jabatan || '').toLowerCase().includes('fungsional') || (w.jabatan || '').toLowerCase().includes('koordinator');
                                if (isFung) {
                                    const sek = wingChildren.find(item => (item.jabatan || '').toLowerCase().includes('sekretar'));
                                    if (sek) {
                                        const sekBottomX = sek._x + PUB_CARD_W / 2;
                                        const sekBottomY = sek._y + PUB_CARD_H;
                                        const fMidY = sekBottomY + 16;
                                        drawPublicSvgDashedLine(svg, sekBottomX, sekBottomY, sekBottomX, fMidY);
                                        drawPublicSvgDashedLine(svg, sekBottomX, fMidY, wCenterX, fMidY);
                                        drawPublicSvgDashedLine(svg, wCenterX, fMidY, wCenterX, w._y);
                                    }
                                }
                            });

                            // 3. Garis Busbar Horizontal Distribusi Bidang
                            const lineXs = lineChildren.map(c => c._x + PUB_CARD_W / 2);
                            const minLineX = Math.min(parentBottomX, ...lineXs);
                            const maxLineX = Math.max(parentBottomX, ...lineXs);
                            drawPublicSvgLine(svg, minLineX, lineBarY, maxLineX, lineBarY);

                            // 4. Drop Garis Vertikal Menuju Atap Masing-Masing Bidang
                            lineChildren.forEach(c => {
                                const cX = c._x + PUB_CARD_W / 2;
                                drawPublicSvgLine(svg, cX, lineBarY, cX, c._y);
                            });
                        } else if (wingChildren.length > 0 && lineChildren.length === 0) {
                            // Semua anak sayap menyatu
                            const maxWingY = Math.max(...wingChildren.map(w => w._y));
                            const lastBranchY = parentBottomY + (maxWingY - parentBottomY) * pubElbowRatio;
                            drawPublicSvgLine(svg, parentBottomX, parentBottomY, parentBottomX, lastBranchY);

                            wingChildren.forEach(w => {
                                const wCenterX = w._x + PUB_CARD_W / 2;
                                const wingBranchY = parentBottomY + (w._y - parentBottomY) * pubElbowRatio;
                                drawPublicSvgLine(svg, parentBottomX, wingBranchY, wCenterX, wingBranchY);
                                drawPublicSvgLine(svg, wCenterX, wingBranchY, wCenterX, w._y);
                            });
                        } else {
                            // Semua anak lini bawah standar busbar
                            drawPublicSvgLine(svg, parentBottomX, parentBottomY, parentBottomX, elbowY);

                            const childXs = node.children.map(c => c._x + PUB_CARD_W / 2);
                            const minX = Math.min(parentBottomX, ...childXs);
                            const maxX = Math.max(parentBottomX, ...childXs);
                            drawPublicSvgLine(svg, minX, elbowY, maxX, elbowY);

                            node.children.forEach(c => {
                                const childX = c._x + PUB_CARD_W / 2;
                                drawPublicSvgLine(svg, childX, elbowY, childX, c._y);
                            });
                        }
                    }
                }

                node.children.forEach(c => renderPublicLinesRecursive(c, svg));
            }
        }

        function drawPublicSvgLine(svg, x1, y1, x2, y2) {
            const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            line.setAttribute('x1', Math.round(x1));
            line.setAttribute('y1', Math.round(y1));
            line.setAttribute('x2', Math.round(x2));
            line.setAttribute('y2', Math.round(y2));
            line.setAttribute('class', 'public-tree-line');
            svg.appendChild(line);
        }

        function drawPublicSvgDashedLine(svg, x1, y1, x2, y2) {
            const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            line.setAttribute('x1', Math.round(x1));
            line.setAttribute('y1', Math.round(y1));
            line.setAttribute('x2', Math.round(x2));
            line.setAttribute('y2', Math.round(y2));
            line.setAttribute('class', 'public-tree-line');
            line.setAttribute('stroke-dasharray', '5,4');
            svg.appendChild(line);
        }

        function drawPublicSvgBezier(svg, x1, y1, x2, y2) {
            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            const midY = (y1 + y2) / 2;
            const d = `M ${Math.round(x1)} ${Math.round(y1)} C ${Math.round(x1)} ${Math.round(midY)}, ${Math.round(x2)} ${Math.round(midY)}, ${Math.round(x2)} ${Math.round(y2)}`;
            path.setAttribute('d', d);
            path.setAttribute('class', 'public-tree-line');
            svg.appendChild(path);
        }

        function getPublicNodeClass(node) {
            const jab = (node.jabatan || '').toLowerCase();
            const tip = (node.tipe_posisi || '').toUpperCase();
            if (node.isRoot || tip === 'ROOT' || jab.includes('kepala dinas')) {
                return 'org-card-root';
            }
            if (tip === 'STAFF_SAYAP' || jab.includes('sekretar')) {
                return 'org-card-sekretariat';
            }
            if (jab.startsWith('kepala bidang') || jab.startsWith('kabid') || (tip === 'LINE_BIDANG' && node.isParent)) {
                return 'org-card-bidang';
            }
            if (jab.includes('kasubag') || jab.includes('subbag') || jab.includes('ketua tim') || jab.includes('seksi')) {
                return 'org-card-tim';
            }
            return 'org-card-pelaksana';
        }

        function updatePublicStageTransform() {
            const stage = document.getElementById('publicTreeStage');
            if (stage) {
                stage.style.transform = `translate(${publicPanX}px, ${publicPanY}px) scale(${publicZoom})`;
            }
        }

        // Interaksi Drag Pan & Zoom Kanvas
        const publicViewport = document.getElementById('publicTreeViewport');
        if (publicViewport) {
            publicViewport.addEventListener('mousedown', (e) => {
                if (e.target.closest('.org-card') || e.target.closest('button') || e.target.closest('a')) return;
                publicIsDragging = true;
                publicViewport.classList.add('is-dragging');
                publicStartX = e.clientX - publicPanX;
                publicStartY = e.clientY - publicPanY;
            });

            window.addEventListener('mousemove', (e) => {
                if (!publicIsDragging) return;
                publicPanX = e.clientX - publicStartX;
                publicPanY = e.clientY - publicStartY;
                updatePublicStageTransform();
            });

            window.addEventListener('mouseup', () => {
                publicIsDragging = false;
                publicViewport.classList.remove('is-dragging');
            });

            publicViewport.addEventListener('wheel', (e) => {
                e.preventDefault();
                const delta = e.deltaY < 0 ? 0.1 : -0.1;
                publicZoom = Math.min(Math.max(0.4, publicZoom + delta), 2.2);
                updatePublicStageTransform();
            }, { passive: false });
        }

        // Kontrol Tombol Navigasi
        window.treeCenterFit = function() {
            const viewport = document.getElementById('publicTreeViewport');
            const stage    = document.getElementById('publicTreeStage');
            if (!viewport || !stage) return;
            const vpW = viewport.clientWidth;
            const stageW = parseInt(stage.style.width) || 800;
            publicZoom = Math.min(1, Math.max(0.45, (vpW - 60) / stageW));
            publicPanX = Math.max(10, (vpW - stageW * publicZoom) / 2);
            publicPanY = 20;
            updatePublicStageTransform();
        };

        window.treeZoomIn = function() {
            publicZoom = Math.min(2.2, publicZoom + 0.15);
            updatePublicStageTransform();
        };

        window.treeZoomOut = function() {
            publicZoom = Math.max(0.4, publicZoom - 0.15);
            updatePublicStageTransform();
        };

        window.treeResetView = function() {
            publicZoom = 1;
            publicPanX = 0;
            publicPanY = 0;
            updatePublicStageTransform();
        };

        window.treeExpandAll = function() {
            publicNodeMap.forEach(n => { n.isCollapsed = false; });
            renderPublicTree();
        };

        window.togglePublicNodeCollapse = function(id) {
            const node = publicNodeMap.get(Number(id));
            if (node) {
                node.isCollapsed = !node.isCollapsed;
                renderPublicTree();
            }
        };

        // Render Pohon saat inisialisasi
        renderPublicTree();
        setTimeout(treeCenterFit, 50);

        // Atur indentasi Outline Tree jika level > 8
        document.querySelectorAll('.outline-tree-row[data-level]').forEach(el => {
            const lvl = parseInt(el.dataset.level, 10);
            if (!isNaN(lvl)) el.style.marginLeft = (lvl * 24) + 'px';
        });

        // Switch Mode: Bagan Visual vs Daftar Hirarki
        window.switchTreeDisplayMode = function(mode) {
            const vContainer = document.getElementById('containerModeVisual');
            const oContainer = document.getElementById('containerModeOutline');
            const btnVisual  = document.getElementById('btnModeVisual');
            const btnOutline = document.getElementById('btnModeOutline');

            if (mode === 'visual') {
                vContainer.classList.remove('d-none');
                oContainer.classList.add('d-none');
                btnVisual.classList.add('active', 'btn-primary');
                btnVisual.classList.remove('text-secondary');
                btnOutline.classList.remove('active', 'btn-primary');
                btnOutline.classList.add('text-secondary');
                setTimeout(treeCenterFit, 60);
            } else {
                vContainer.classList.add('d-none');
                oContainer.classList.remove('d-none');
                btnOutline.classList.add('active', 'btn-primary');
                btnOutline.classList.remove('text-secondary');
                btnVisual.classList.remove('active', 'btn-primary');
                btnVisual.classList.add('text-secondary');
            }
        };

        // Helper: Penjelasan Tugas yang Membumi & Realistis untuk Warga
        function getPenjelasanTugasDinas(jabatan, node) {
            const j = (jabatan || '').toLowerCase();
            if (j.includes('kepala dinas')) {
                return 'Memimpin, mengarahkan, dan menetapkan kebijakan strategis penyelenggaraan urusan komunikasi, informatika, statistik, dan persandian Kabupaten Bekasi.';
            }
            if (j.includes('sekretar')) {
                return 'Mengoordinasikan perencanaan program kerja, pengelolaan anggaran dinas, ketatausahaan, dan pelayanan administrasi umum ke seluruh bidang dinas.';
            }
            if (j.includes('umum') || j.includes('kepegawaian') || j.includes('kasubag') || j.includes('sub bagian')) {
                return 'Mengurus keperluan surat-menyurat, data pegawai, perlengkapan kantor, dan urusan rumah tangga dinas.';
            }
            if (j.includes('teknologi') || j.includes('tik') || j.includes('komunikasi & teknologi')) {
                return 'Mengelola jaringan internet kantor dinas/desa, pusat data (data center), pengembangan aplikasi daerah, dan integrasi sistem digital pemerintahan.';
            }
            if (j.includes('informasi') || j.includes('ikp') || j.includes('publik')) {
                return 'Mengelola publikasi berita resmi daerah, dokumentasi liputan, hubungan media pers, dan layanan pengaduan aspirasi warga.';
            }
            if (j.includes('statistik')) {
                return 'Mengumpulkan, mengolah, dan menyajikan data statistik daerah yang akurat sebagai bahan perencanaan pembangunan Kabupaten Bekasi.';
            }
            if (j.includes('persandian') || j.includes('keamanan informasi')) {
                return 'Menjaga keamanan data dan sistem informasi daerah, pengamanan persandian, serta penerbitan tanda tangan elektronik (TTE) resmi.';
            }
            if (node && node.children && node.children.length > 0) {
                return 'Mengoordinasikan pelaksanaan program kerja teknis dan pelayanan kedinasan pada unit kerja di bawahnya.';
            }
            return 'Melaksanakan tugas teknis operasional dan pelayanan administrasi kedinasan sesuai lingkup bidang tugas.';
        }

        // Modal Node Inspector (Fokus murni Deskripsi & Tugas)
        window.openNodeInspectorById = function(id) {
            const node = nodeMap.get(Number(id));
            if (!node) return;

            document.getElementById('inspectorJabatan').textContent = node.jabatan || 'Jabatan';
            
            // Nama Pejabat di Subtitle Header jika ada
            const pejabatSub = document.getElementById('inspectorPejabatSub');
            const pejabatName = document.getElementById('inspectorPejabatName');
            if (pejabatSub && pejabatName) {
                if (node.nama_pejabat && node.nama_pejabat.trim() !== '' && node.nama_pejabat.trim() !== '-') {
                    pejabatName.textContent = node.nama_pejabat.trim();
                    pejabatSub.classList.remove('d-none');
                } else {
                    pejabatSub.classList.add('d-none');
                }
            }

            // Role Badge & Penjelasan Tugas yang Membumi
            const badgeEl = document.getElementById('inspectorRoleBadge');
            const descEl  = document.getElementById('inspectorRoleDesc');
            const iconBox = document.getElementById('inspectorIconBox');

            const jLower = (node.jabatan || '').toLowerCase();
            if (descEl) {
                descEl.textContent = getPenjelasanTugasDinas(node.jabatan, node);
            }

            if (badgeEl && iconBox) {
                if (!node.parent_id || jLower.includes('kepala dinas')) {
                    badgeEl.className = 'badge rounded-pill text-uppercase px-2.5 py-1 mb-1 small fw-bold bg-warning-subtle text-warning-emphasis border border-warning';
                    badgeEl.textContent = '👑 PIMPINAN DINAS';
                    iconBox.style.background = 'rgba(255, 107, 0, 0.2)';
                    iconBox.style.color = '#FF9B42';
                } else if (jLower.includes('sekretar') || jLower.includes('bidang') || jLower.includes('sub bagian')) {
                    badgeEl.className = 'badge rounded-pill text-uppercase px-2.5 py-1 mb-1 small fw-bold bg-primary-subtle text-primary border border-primary';
                    badgeEl.textContent = '🏢 STRUKTURAL DINAS';
                    iconBox.style.background = 'rgba(37, 99, 235, 0.2)';
                    iconBox.style.color = '#3B82F6';
                } else {
                    badgeEl.className = 'badge rounded-pill text-uppercase px-2.5 py-1 mb-1 small fw-bold bg-success-subtle text-success border border-success';
                    badgeEl.textContent = '👤 PELAKSANA / FUNGSIONAL';
                    iconBox.style.background = 'rgba(16, 185, 129, 0.2)';
                    iconBox.style.color = '#10B981';
                }
            }

            // Tampilkan Modal
            if (window.bootstrap && bootstrap.Modal) {
                const modal = new bootstrap.Modal(document.getElementById('modalNodeInspector'));
                modal.show();
            } else {
                const mEl = document.getElementById('modalNodeInspector');
                mEl.classList.add('show');
                mEl.style.display = 'block';
            }
        };

        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }

        // Posisikan ke tengah saat pertama kali dimuat
        setTimeout(treeCenterFit, 100);
    })();
    </script>


    <!-- 3. SECTION LOKASI & GOOGLE MAPS -->
    <div class="card-modern p-4 p-md-5 border-0 shadow-sm overflow-hidden" style="border-radius: 20px;">
