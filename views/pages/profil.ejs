                        <!-- Surat Elektronik (Email) -->
                        <div class="contact-info-card d-flex align-items-center gap-3 p-3 rounded-3 border">
                            <div class="profil-icon-box icon-box-emerald flex-shrink-0">
                                <i class="bi bi-envelope-at-fill"></i>
                            </div>
                            <div class="flex-grow-1">
                                <span class="d-block text-muted text-uppercase fw-bold" style="font-size: 0.68rem; letter-spacing: 0.5px;">Surat Elektronik (Email)</span>
                                <% if (dataProfil && dataProfil.email && dataProfil.email.trim() !== '') { %>
                                    <a href="mailto:<%= dataProfil.email %>" class="text-dark fw-bold text-decoration-none small hover-orange d-inline-flex align-items-center gap-1 mt-1">
                                        <%= dataProfil.email %>
                                        <i class="bi bi-arrow-up-right small text-muted"></i>
                                    </a>
                                <% } else { %>
                                    <span class="text-muted small">Belum diisi oleh administrator.</span>
