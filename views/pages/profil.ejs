    </div>

    <!-- ============================================================== -->
    <!-- MODAL INSPECTOR DETAIL NODE TREE -->
    <!-- ============================================================== -->
    <div class="modal fade" id="modalNodeInspector" tabindex="-1" aria-labelledby="modalNodeInspectorLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header inspector-header text-white">
                    <div class="d-flex align-items-center gap-3">
                        <div id="inspectorIconBox" class="rounded-3 d-flex align-items-center justify-content-center p-2" style="background: rgba(255, 107, 0, 0.2); color: #FF9B42; width: 44px; height: 44px;">
                            <i class="bi bi-diagram-3-fill fs-5"></i>
                        </div>
                        <div>
                            <span id="inspectorRoleBadge" class="badge rounded-pill text-uppercase px-2.5 py-1 mb-1 small fw-bold">PIMPINAN DINAS</span>
                            <h5 class="modal-title fw-bold text-white mb-0" id="inspectorJabatan">Nama Jabatan</h5>
                            <div id="inspectorPejabatSub" class="small mt-1 text-warning d-none">
