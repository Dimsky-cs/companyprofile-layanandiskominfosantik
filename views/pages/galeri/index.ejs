<!-- BANNER HEADER -->
<section class="hero-mesh text-white py-5">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb small mb-2">
                        <li class="breadcrumb-item"><a href="/" class="text-white opacity-75 text-decoration-none">Beranda</a></li>
                        <li class="breadcrumb-item active text-warning" style="color: var(--orange-primary) !important;">Galeri Multimedia</li>
                    </ol>
                </nav>
                <h1 class="display-6 fw-bold mb-2">Galeri Foto & Info Terbaru Warga</h1>
                <p class="lead text-light opacity-75 fs-6 mb-0">
                    Dokumentasi visual kegiatan daerah, video edukasi, dan poster infografis resmi untuk masyarakat Kabupaten Bekasi.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <span class="badge py-2 px-3 fs-6 rounded-pill shadow-sm" style="background-color: var(--orange-primary); color: white;">
                    <i class="bi bi-camera-reels-fill me-1"></i> Dokumentasi Resmi
                </span>
            </div>
        </div>
    </div>
</section>

<!-- CSS KHUSUS INTERAKSI GALERI -->
<style>
    .gallery-img-wrapper {
        position: relative;
        overflow: hidden;
        cursor: pointer;
        background-color: #0f172a;
    }
    .gallery-img-wrapper img {
        transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .gallery-img-wrapper:hover img {
        transform: scale(1.08);
    }
    .gallery-img-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(10, 25, 47, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.25s ease;
        pointer-events: none;
    }
    .gallery-img-wrapper:hover .gallery-img-overlay {
        opacity: 1;
    }
    /* Tombol Panah Navigasi Melayang di Lightbox */
    .lightbox-nav-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: rgba(15, 23, 42, 0.75);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        z-index: 1060;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }
    .lightbox-nav-btn:hover {
        background: var(--orange-primary);
        border-color: var(--orange-primary);
        color: #ffffff;
        transform: translateY(-50%) scale(1.1);
    }
    .lightbox-nav-btn:active {
        transform: translateY(-50%) scale(0.95);
    }
</style>

<div class="container py-5">

    <!-- 1. TAB KATEGORI MULTIMEDIA & FILTER TAHUN -->
    <div class="card-modern p-4 mb-5 shadow-sm border-0">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <ul class="nav nav-pills gap-2" id="galeriTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="btn btn-navy active px-3 py-2 fw-semibold rounded-3" id="tab-semua" data-bs-toggle="pill" data-bs-target="#content-semua" type="button">
                        <i class="bi bi-grid-fill me-1"></i> Semua Media (<%= allItems ? allItems.length : 0 %>)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="btn btn-outline-dark px-3 py-2 fw-semibold rounded-3" id="tab-foto" data-bs-toggle="pill" data-bs-target="#content-foto" type="button">
                        <i class="bi bi-images me-1 text-warning" style="color: var(--orange-primary) !important;"></i> Foto Kegiatan (<%= fotoList ? fotoList.length : 0 %>)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="btn btn-outline-dark px-3 py-2 fw-semibold rounded-3" id="tab-video" data-bs-toggle="pill" data-bs-target="#content-video" type="button">
                        <i class="bi bi-play-circle-fill me-1 text-danger"></i> Video & Podcast (<%= videoList ? videoList.length : 0 %>)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="btn btn-outline-dark px-3 py-2 fw-semibold rounded-3" id="tab-infografis" data-bs-toggle="pill" data-bs-target="#content-infografis" type="button">
                        <i class="bi bi-file-earmark-image me-1 text-info"></i> Infografis Edukasi (<%= infografisList ? infografisList.length : 0 %>)
                    </button>
                </li>
            </ul>

            <!-- Filter Tahun -->
            <form action="/galeri" method="GET" class="d-flex align-items-center gap-2">
                <span class="small text-muted d-none d-sm-inline fw-semibold"><i class="bi bi-funnel"></i> Filter:</span>
                <select name="tahun" class="form-select form-select-sm rounded-3 shadow-none border-secondary-subtle" onchange="this.form.submit()" style="min-width: 140px;">
                    <option value="">Semua Tahun</option>
                    <option value="2026" <%= selectedTahun === '2026' ? 'selected' : '' %>>Tahun 2026</option>
                    <option value="2025" <%= selectedTahun === '2025' ? 'selected' : '' %>>Tahun 2025</option>
                    <option value="2024" <%= selectedTahun === '2024' ? 'selected' : '' %>>Tahun 2024</option>
                </select>
            </form>
        </div>
    </div>

    <!-- 2. KONTEN TABEL MULTIMEDIA -->
    <div class="tab-content" id="galeriTabContent">

        <!-- TAB ALL ITEMS -->
        <div class="tab-pane fade show active" id="content-semua" role="tabpanel">
            <div class="row g-4">
                <% if (allItems && allItems.length > 0) { %>
                    <% allItems.forEach((item) => { %>
                        <div class="col-lg-4 col-md-6">
                            <div class="card-modern h-100 overflow-hidden d-flex flex-column border-0 shadow-sm">
                                <div class="position-relative" style="height: 230px; overflow: hidden;">
                                    <% if (item.tipe === 'video') { %>
                                        <iframe src="<%= item.file_path %>" class="w-100 h-100 border-0" allowfullscreen></iframe>
                                    <% } else { %>
                                        <div class="w-100 h-100 gallery-img-wrapper gallery-item-clickable" 
                                             data-img="<%= item.file_path %>" 
                                             data-title="<%= item.judul %>" 
                                             data-desc="<%= item.keterangan || '' %>"
                                             data-tipe="<%= item.tipe %>">
                                            <img src="<%= item.file_path %>" class="w-100 h-100 object-fit-cover" alt="<%= item.judul %>">
                                            <div class="gallery-img-overlay">
                                                <span class="btn btn-sm btn-light rounded-pill px-3 py-1.5 shadow-sm fw-bold text-dark d-flex align-items-center gap-1.5">
                                                    <i class="bi bi-arrows-fullscreen text-warning" style="color: var(--orange-primary) !important;"></i> Klik untuk Perbesar
                                                </span>
                                            </div>
                                        </div>
                                    <% } %>
                                    
                                    <% 
                                        let badgeType = 'bg-primary';
                                        if (item.tipe === 'video') badgeType = 'bg-danger';
                                        if (item.tipe === 'infografis') badgeType = 'bg-warning text-dark';
                                    %>
                                    <span class="badge position-absolute top-0 start-0 m-3 <%= badgeType %> shadow-sm text-uppercase fw-bold" style="font-size: 0.7rem; pointer-events: none; z-index: 5;">
                                        <%= item.tipe %>
                                    </span>
                                </div>
                                <div class="p-4 d-flex flex-column flex-grow-1">
                                    <span class="small text-muted mb-2 d-flex align-items-center">
                                        <i class="bi bi-calendar3 me-1.5 text-warning" style="color: var(--orange-primary) !important;"></i> 
                                        <%= new Date(item.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                    </span>
                                    <h6 class="fw-bold mb-2 text-dark" style="line-height: 1.4;"><%= item.judul %></h6>
                                    <p class="small text-secondary flex-grow-1 mb-3" style="line-height: 1.5;"><%= item.keterangan || 'Dokumentasi resmi liputan kedinasan.' %></p>
                                    
                                    <% if (item.tipe === 'infografis' || item.tipe === 'foto') { %>
                                        <div class="mt-auto pt-2 border-top d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-gallery-zoom w-50 gallery-item-clickable d-flex align-items-center justify-content-center gap-1.5 rounded-3 fw-semibold"
                                                    data-img="<%= item.file_path %>" 
                                                    data-title="<%= item.judul %>" 
                                                    data-desc="<%= item.keterangan || '' %>"
                                                    data-tipe="<%= item.tipe %>">
                                                <i class="bi bi-arrows-angle-expand"></i> Perbesar
                                            </button>
                                            <a href="<%= item.file_path %>" download target="_blank" class="btn btn-sm btn-outline-dark w-50 d-flex align-items-center justify-content-center gap-1 rounded-3 fw-semibold">
                                                <i class="bi bi-download text-warning" style="color: var(--orange-primary) !important;"></i> Unduh Berkas
                                            </a>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 py-5 text-center text-muted">
                        <i class="bi bi-images fs-1 d-block mb-2 text-secondary opacity-50"></i>
                        <p class="mb-0">Belum ada media galeri yang ditemukan.</p>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- TAB FOTO ONLY -->
        <div class="tab-pane fade" id="content-foto" role="tabpanel">
            <div class="row g-4">
                <% if (fotoList && fotoList.length > 0) { %>
                    <% fotoList.forEach((item) => { %>
                        <div class="col-lg-4 col-md-6">
                            <div class="card-modern h-100 overflow-hidden d-flex flex-column border-0 shadow-sm">
                                <div class="position-relative" style="height: 230px; overflow: hidden;">
                                    <div class="w-100 h-100 gallery-img-wrapper gallery-item-clickable"
                                         data-img="<%= item.file_path %>" 
                                         data-title="<%= item.judul %>" 
                                         data-desc="<%= item.keterangan || '' %>"
                                         data-tipe="<%= item.tipe %>">
                                        <img src="<%= item.file_path %>" class="w-100 h-100 object-fit-cover" alt="<%= item.judul %>">
                                        <div class="gallery-img-overlay">
                                            <span class="btn btn-sm btn-light rounded-pill px-3 py-1.5 shadow-sm fw-bold text-dark">
                                                <i class="bi bi-arrows-fullscreen text-warning" style="color: var(--orange-primary) !important;"></i> Klik untuk Perbesar
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="p-4 d-flex flex-column flex-grow-1">
                                    <span class="small text-muted mb-2"><i class="bi bi-calendar3 me-1.5 text-warning" style="color: var(--orange-primary) !important;"></i> <%= new Date(item.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                    <h6 class="fw-bold mb-2 text-dark"><%= item.judul %></h6>
                                    <p class="small text-secondary flex-grow-1 mb-3"><%= item.keterangan || '-' %></p>
                                    <div class="mt-auto pt-2 border-top d-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-gallery-zoom w-50 gallery-item-clickable rounded-3 fw-semibold"
                                                data-img="<%= item.file_path %>" 
                                                data-title="<%= item.judul %>" 
                                                data-desc="<%= item.keterangan || '' %>"
                                                data-tipe="<%= item.tipe %>">
                                            <i class="bi bi-arrows-angle-expand"></i> Perbesar
                                        </button>
                                        <a href="<%= item.file_path %>" download target="_blank" class="btn btn-sm btn-outline-dark w-50 rounded-3 fw-semibold">
                                            <i class="bi bi-download text-warning" style="color: var(--orange-primary) !important;"></i> Unduh
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 py-5 text-center text-muted">Belum ada foto kegiatan.</div>
                <% } %>
            </div>
        </div>

        <!-- TAB VIDEO ONLY -->
        <div class="tab-pane fade" id="content-video" role="tabpanel">
            <div class="row g-4">
                <% if (videoList && videoList.length > 0) { %>
                    <% videoList.forEach(item => { %>
                        <div class="col-lg-6">
                            <div class="card-modern p-3 h-100 border-0 shadow-sm">
                                <div class="ratio ratio-16x9 rounded-3 overflow-hidden mb-3 bg-dark">
                                    <iframe src="<%= item.file_path %>" title="<%= item.judul %>" allowfullscreen></iframe>
                                </div>
                                <h5 class="fw-bold mb-1 text-dark"><%= item.judul %></h5>
                                <p class="small text-secondary mb-0"><%= item.keterangan || 'Liputan video resmi Diskominfo.' %></p>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 py-5 text-center text-muted">Belum ada video dokumentasi.</div>
                <% } %>
            </div>
        </div>

        <!-- TAB INFOGRAFIS ONLY -->
        <div class="tab-pane fade" id="content-infografis" role="tabpanel">
            <div class="row g-4">
                <% if (infografisList && infografisList.length > 0) { %>
                    <% infografisList.forEach(item => { %>
                        <div class="col-lg-4 col-md-6">
                            <div class="card-modern h-100 overflow-hidden d-flex flex-column border-0 shadow-sm">
                                <div class="position-relative" style="height: 250px; overflow: hidden;">
                                    <div class="w-100 h-100 gallery-img-wrapper gallery-item-clickable"
                                         data-img="<%= item.file_path %>" 
                                         data-title="<%= item.judul %>" 
                                         data-desc="<%= item.keterangan || '' %>"
                                         data-tipe="<%= item.tipe %>">
                                        <img src="<%= item.file_path %>" class="w-100 h-100 object-fit-cover" alt="<%= item.judul %>">
                                        <div class="gallery-img-overlay">
                                            <span class="btn btn-sm btn-light rounded-pill px-3 py-1.5 shadow-sm fw-bold text-dark">
                                                <i class="bi bi-arrows-fullscreen text-warning" style="color: var(--orange-primary) !important;"></i> Klik untuk Perbesar
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="p-4 d-flex flex-column flex-grow-1">
                                    <h6 class="fw-bold mb-2 text-dark"><%= item.judul %></h6>
                                    <p class="small text-muted mb-3 flex-grow-1"><%= item.keterangan || '-' %></p>
                                    <div class="mt-auto pt-2 border-top d-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-gallery-zoom w-50 gallery-item-clickable rounded-3 fw-semibold"
                                                data-img="<%= item.file_path %>" 
                                                data-title="<%= item.judul %>" 
                                                data-desc="<%= item.keterangan || '' %>"
                                                data-tipe="<%= item.tipe %>">
                                            <i class="bi bi-arrows-angle-expand"></i> Perbesar
                                        </button>
                                        <a href="<%= item.file_path %>" download target="_blank" class="btn btn-sm btn-navy w-50 rounded-3 fw-semibold">
                                            <i class="bi bi-download me-1 text-warning" style="color: var(--orange-primary) !important;"></i> Unduh
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 py-5 text-center text-muted">Belum ada infografis edukasi.</div>
                <% } %>
            </div>
        </div>

    </div>

</div>

<!-- LIGHTBOX MODAL VIEWER -->
<div class="modal fade" id="modalLightbox" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 rounded-4 overflow-hidden shadow-2xl bg-dark text-white">
            
            <!-- HEADER MODAL -->
            <div class="modal-header border-0 px-4 py-3 d-flex align-items-center justify-content-between" style="background: #0A192F;">
                <div class="d-flex align-items-center gap-3 overflow-hidden me-3">
                    <span class="badge px-2.5 py-1.5 rounded-pill text-uppercase fw-bold shrink-0" id="lightboxTipeBadge" style="background-color: var(--orange-primary); font-size: 0.72rem;">Foto</span>
                    <h6 class="modal-title fw-bold text-white mb-0 text-truncate" id="lightboxTitle" style="font-size: 1rem;">Detail Dokumentasi</h6>
                </div>
                <div class="d-flex align-items-center gap-2 shrink-0">
                    <span class="badge bg-secondary bg-opacity-50 text-light fw-medium px-3 py-1.5 rounded-pill small" id="lightboxCounter">1 dari 1</span>
                    <button type="button" class="btn-close btn-close-white ms-2 shadow-none" data-bs-dismiss="modal" aria-label="Tutup"></button>
                </div>
            </div>

            <!-- BODY MODAL: GAMBAR & TOMBOL PANAH FLOATING -->
            <div class="modal-body p-0 d-flex align-items-center justify-content-center position-relative bg-black" style="min-height: 50vh; max-height: 75vh; overflow: hidden; user-select: none;">
                
                <!-- TOMBOL PREV (PANAH KIRI) -->
                <button type="button" id="btnPrevLightbox" class="lightbox-nav-btn start-0 ms-3" title="Sebelumnya">
                    <i class="bi bi-chevron-left"></i>
                </button>

                <!-- GAMBAR DOKUMENTASI -->
                <img id="lightboxImg" src="" class="img-fluid" style="max-height: 75vh; width: auto; object-fit: contain; transition: opacity 0.2s ease-in-out;" alt="Preview Dokumentasi">

                <!-- TOMBOL NEXT (PANAH KANAN) -->
                <button type="button" id="btnNextLightbox" class="lightbox-nav-btn end-0 me-3" title="Berikutnya">
                    <i class="bi bi-chevron-right"></i>
                </button>

            </div>

            <!-- FOOTER MODAL: HANYA KETERANGAN & TOMBOL UNDUH (BERSIH) -->
            <div class="modal-footer border-0 px-4 py-3 d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3" style="background: #0A192F;">
                <div class="text-start">
                    <p class="small text-light opacity-80 mb-0" id="lightboxDesc" style="line-height: 1.4; max-width: 700px;">Keterangan dokumentasi.</p>
                </div>
                <a id="lightboxDownloadBtn" href="" download target="_blank" class="btn btn-sm btn-orange fw-bold px-4 py-2 rounded-3 text-white shrink-0 d-inline-flex align-items-center gap-2 shadow-sm">
                    <i class="bi bi-download"></i> Unduh Resolusi Penuh
                </a>
            </div>

        </div>
    </div>
</div>

<!-- SCRIPT PENGATUR LIGHTBOX & KEYBOARD ARROW -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        let currentPlaylist = [];
        let currentIndex = 0;

        const modalEl = document.getElementById('modalLightbox');
        const imgEl = document.getElementById('lightboxImg');
        const titleEl = document.getElementById('lightboxTitle');
        const descEl = document.getElementById('lightboxDesc');
        const badgeEl = document.getElementById('lightboxTipeBadge');
        const counterEl = document.getElementById('lightboxCounter');
        const downloadBtn = document.getElementById('lightboxDownloadBtn');
        const btnNext = document.getElementById('btnNextLightbox');
        const btnPrev = document.getElementById('btnPrevLightbox');

        // Fungsi Render Item Aktif
        function renderCurrentItem(index) {
            if (!currentPlaylist.length) return;

            // Looping memutar jika mencapai batas awal / akhir
            if (index < 0) index = currentPlaylist.length - 1;
            if (index >= currentPlaylist.length) index = 0;
            currentIndex = index;

            const item = currentPlaylist[currentIndex];

            // Efek transisi halus
            imgEl.style.opacity = '0.2';
            setTimeout(() => {
                imgEl.src = item.img;
                imgEl.style.opacity = '1';
            }, 100);

            titleEl.textContent = item.title || 'Dokumentasi Diskominfo';
            descEl.textContent = item.desc || 'Dokumentasi resmi kegiatan kedinasan.';
            badgeEl.textContent = (item.tipe || 'Foto').toUpperCase();
            counterEl.textContent = `${currentIndex + 1} dari ${currentPlaylist.length}`;

            // Perbarui URL Unduh Resolusi Penuh
            downloadBtn.href = item.img;
            downloadBtn.setAttribute('download', (item.title || 'dokumentasi').toLowerCase().replace(/[^a-z0-9]/g, '-') + '.jpg');
        }

        function showNext() {
            renderCurrentItem(currentIndex + 1);
        }

        function showPrev() {
            renderCurrentItem(currentIndex - 1);
        }

        // 1. KLIK PADA GAMBAR ATAU TOMBOL PERBESAR
        document.addEventListener('click', function(e) {
            const trigger = e.target.closest('.gallery-item-clickable');
            if (trigger) {
                e.preventDefault();

                // Ambil semua gambar di dalam tab yang sedang aktif
                const activePane = trigger.closest('.tab-pane') || document;
                const triggers = Array.from(activePane.querySelectorAll('.gallery-item-clickable.gallery-img-wrapper'));

                currentPlaylist = triggers.map(el => ({
                    img: el.getAttribute('data-img'),
                    title: el.getAttribute('data-title'),
                    desc: el.getAttribute('data-desc'),
                    tipe: el.getAttribute('data-tipe')
                }));

                const clickedImgSrc = trigger.getAttribute('data-img');
                currentIndex = currentPlaylist.findIndex(item => item.img === clickedImgSrc);
                if (currentIndex === -1) currentIndex = 0;

                renderCurrentItem(currentIndex);

                // Buka modal Bootstrap secara aman
                if (window.bootstrap && window.bootstrap.Modal) {
                    const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                    bsModal.show();
                }
            }
        });

        // 2. KLIK TOMBOL PANAH DI MODAL
        if (btnNext) {
            btnNext.addEventListener('click', function(e) {
                e.stopPropagation();
                showNext();
            });
        }
        if (btnPrev) {
            btnPrev.addEventListener('click', function(e) {
                e.stopPropagation();
                showPrev();
            });
        }

        // 3. DUKUNGAN TOMBOL PANAH KEYBOARD (ARROW LEFT & ARROW RIGHT)
        function handleKeyNavigation(e) {
            if (!modalEl.classList.contains('show')) return;

            if (e.key === 'ArrowRight' || e.key === 'Right') {
                e.preventDefault();
                showNext();
            } else if (e.key === 'ArrowLeft' || e.key === 'Left') {
                e.preventDefault();
                showPrev();
            }
        }

        // Aktifkan navigasi keyboard hanya ketika modal sedang terbuka
        modalEl.addEventListener('shown.bs.modal', function() {
            window.addEventListener('keydown', handleKeyNavigation);
        });

        // Hapus listener keyboard ketika modal ditutup
        modalEl.addEventListener('hidden.bs.modal', function() {
            window.removeEventListener('keydown', handleKeyNavigation);
            imgEl.src = '';
        });
    });
</script>