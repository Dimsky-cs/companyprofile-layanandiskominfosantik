            <div class="modal-footer border-0 px-4 py-3 d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3" style="background: #0A192F;">
                <div class="text-start">
                    <p class="small text-light opacity-80 mb-0" id="lightboxDesc" style="line-height: 1.4; max-width: 700px;">Keterangan dokumentasi.</p>
                </div>
                <a id="lightboxDownloadBtn" href="" download target="_blank" class="btn btn-sm btn-orange fw-bold px-4 py-2 rounded-3 text-white shrink-0 d-inline-flex align-items-center gap-2 shadow-sm">
                    <i class="bi bi-download"></i> Unduh Resolusi Penuh
                </a>
            </div>
        </div>
    </div>
</div>

<!-- 7. FLOATING DIGITAL ASSISTANT (CHATBOT) -->
<div class="floating-assistant-btn animate-float shadow-lg" id="assistantToggleBtn" title="Tanya Asisten Virtual">
    <i class="bi bi-chat-dots-fill"></i>
</div>

<div class="assistant-modal" id="assistantBox">
    <div class="p-3 text-white d-flex align-items-center justify-content-between assistant-header">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-robot text-warning fs-5" style="color: var(--orange-primary) !important;"></i>
            <div>
                <h6 class="mb-0 fw-bold">Asisten Virtual Diskominfo</h6>
                <span class="small text-light opacity-75" style="font-size: 0.72rem;">Online 24/7 Bantuan Cepat</span>
            </div>
        </div>
        <button type="button" class="btn-close btn-close-white small" id="assistantCloseBtn"></button>
    </div>
    
    <div class="p-3 assistant-chat-messages" id="chatMessages">
        <div class="p-2.5 rounded-3 assistant-chat-bubble small mb-2 shadow-sm">
            👋 Halo Warga Bekasi! Ada yang bisa saya bantu? Ketik misalnya: <strong>"surat"</strong>, <strong>"aduan"</strong>, <strong>"data penduduk"</strong>, atau <strong>"jam buka"</strong>.
        </div>
    </div>

    <div class="p-2 border-top assistant-input-box d-flex gap-2">
        <input type="text" id="assistantInput" class="form-control form-control-sm border" placeholder="Ketik pertanyaan...">
        <button id="assistantSendBtn" class="btn btn-sm btn-orange"><i class="bi bi-send-fill"></i></button>
    </div>
</div>

<!-- SCRIPT TYPEWRITER & MINI CHART -->
<script>
    // 1. Tagline Typewriter Effect
    const words = [
        "Pusat Layanan & Informasi Warga Kabupaten Bekasi.",
        "Pelayanan Surat Digital, Pengaduan, & Data Terpadu.",
        "Kanal Aspirasi Warga Cepat, Tanggap, & Terpercaya."
    ];
    let i = 0, timer;

    function typingEffect() {
        let word = words[i].split("");
        var loopTyping = function() {
            if (word.length > 0) {
                document.getElementById('typewriter-text').innerHTML += word.shift();
            } else {
                setTimeout(deletingEffect, 2500);
                return false;
            }
            timer = setTimeout(loopTyping, 50);
        };
        loopTyping();
    }

    function deletingEffect() {
        let word = words[i].split("");
        var loopDeleting = function() {
            if (word.length > 0) {
                word.pop();
                document.getElementById('typewriter-text').innerHTML = word.join("");
            } else {
                if (words.length > (i + 1)) {
                    i++;
                } else {
                    i = 0;
                }
                setTimeout(typingEffect, 500);
                return false;
            }
            timer = setTimeout(loopDeleting, 30);
        };
        loopDeleting();
    }
    typingEffect();

    // 2. Mini Chart Usia Penduduk (Dukungan Mode Terang & Dark Navy - Huruf Diperbesar Jelas Dibaca)
    document.addEventListener("DOMContentLoaded", function() {
        const ctx = document.getElementById('miniChartUsia');
        if (ctx) {
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            const miniChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Usia Produktif 15-64 Th (66.8%)', 'Anak & Remaja 0-14 Th (24.8%)', 'Lansia 65+ Th (8.4%)'],
                    datasets: [{
                        data: [66.8, 24.8, 8.4],
                        backgroundColor: ['#ff781f', isDark ? '#38bdf8' : '#0a2540', '#94a3b8'],
                        borderWidth: 2,
                        borderColor: isDark ? '#0f2238' : '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { 
                            position: 'bottom', 
                            labels: { 
                                boxWidth: 14, 
                                boxHeight: 14,
                                padding: 12,
                                font: { 
                                    size: 13, 
                                    weight: '600'
                                },
                                color: isDark ? '#cbd5e1' : '#334155'
                            } 
                        }
                    }
                }
            });

            window.addEventListener('themeChanged', function(e) {
                const dark = e.detail.isDark;
                miniChart.data.datasets[0].backgroundColor = ['#ff781f', dark ? '#38bdf8' : '#0a2540', '#94a3b8'];
                miniChart.data.datasets[0].borderColor = dark ? '#0f2238' : '#ffffff';
                if (miniChart.options.plugins && miniChart.options.plugins.legend && miniChart.options.plugins.legend.labels) {
                    miniChart.options.plugins.legend.labels.color = dark ? '#cbd5e1' : '#334155';
                }
                miniChart.update();
            });
        }
    });

    // 3. Floating Assistant Bot
    const toggleBtn = document.getElementById('assistantToggleBtn');
    const closeBtn = document.getElementById('assistantCloseBtn');
    const assistantBox = document.getElementById('assistantBox');
    const sendBtn = document.getElementById('assistantSendBtn');
    const input = document.getElementById('assistantInput');
    const chatMessages = document.getElementById('chatMessages');

    toggleBtn.addEventListener('click', () => {
        assistantBox.style.display = assistantBox.style.display === 'block' ? 'none' : 'block';
    });

    closeBtn.addEventListener('click', () => {
        assistantBox.style.display = 'none';
    });

    function botReply(userText) {
        const text = userText.toLowerCase();
        let reply = "Maaf, saya belum memahami pertanyaan Anda. Silakan hubungi Call Center Bebas Pulsa 112 atau buka menu terkait.";

        if (text.includes('surat') || text.includes('permohonan') || text.includes('magang')) {
            reply = "Untuk pengajuan surat mandiri (magang/izin liputan/domain), klik menu <strong>Pelayanan Surat</strong> pada navigasi atas.";
        } else if (text.includes('aduan') || text.includes('lapor') || text.includes('hoaks')) {
            reply = "Anda dapat membuat laporan keluhan atau verifikasi hoaks melalui menu <strong>Pengaduan</strong>.";
        } else if (text.includes('statistik') || text.includes('penduduk') || text.includes('data') || text.includes('kecamatan')) {
            reply = "Data demografi 23 kecamatan dan peta kepadatan dapat Anda akses di menu <strong>Statistik</strong>.";
        } else if (text.includes('jam') || text.includes('buka') || text.includes('jadwal')) {
            reply = "Pelayanan kantor DISKOMINFOSANTIK beroperasi pada hari <strong>Senin - Jumat, pukul 08.00 - 16.00 WIB</strong>.";
        }

        const botBubble = document.createElement('div');
        botBubble.className = 'p-2.5 rounded-3 assistant-chat-bubble border small mb-2 shadow-sm';
        botBubble.innerHTML = `🤖 ${reply}`;
        chatMessages.appendChild(botBubble);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function handleSend() {
        const val = input.value.trim();
        if (!val) return;

        const userBubble = document.createElement('div');
        userBubble.className = 'p-2.5 rounded-3 assistant-user-bubble small mb-2 text-end ms-auto shadow-sm';
        userBubble.style.maxWidth = '85%';
        userBubble.textContent = val;
        chatMessages.appendChild(userBubble);

        input.value = '';
        chatMessages.scrollTop = chatMessages.scrollHeight;

        setTimeout(() => botReply(val), 600);
    }

    sendBtn.addEventListener('click', handleSend);
    input.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') handleSend();
    });

    // 4. Lightbox Interaktif Galeri Beranda
    (function initBerandaLightbox() {
        let currentPlaylist = [];
        let currentIndex = 0;

        const modalEl = document.getElementById('modalLightbox');
        if (!modalEl) return;

        const imgEl = document.getElementById('lightboxImg');
        const titleEl = document.getElementById('lightboxTitle');
        const descEl = document.getElementById('lightboxDesc');
        const badgeEl = document.getElementById('lightboxTipeBadge');
        const counterEl = document.getElementById('lightboxCounter');
        const downloadBtn = document.getElementById('lightboxDownloadBtn');
        const btnNext = document.getElementById('btnNextLightbox');
        const btnPrev = document.getElementById('btnPrevLightbox');

        function renderCurrentItem(index) {
            if (!currentPlaylist.length) return;
            if (index < 0) index = currentPlaylist.length - 1;
            if (index >= currentPlaylist.length) index = 0;
            currentIndex = index;

            const item = currentPlaylist[currentIndex];
            imgEl.style.opacity = '0.2';
            setTimeout(() => {
                imgEl.src = item.img;
                imgEl.style.opacity = '1';
            }, 100);

            titleEl.textContent = item.title || 'Dokumentasi Diskominfo';
            descEl.textContent = item.desc || 'Dokumentasi resmi liputan kedinasan.';
            badgeEl.textContent = (item.tipe || 'Foto').toUpperCase();
            counterEl.textContent = `${currentIndex + 1} dari ${currentPlaylist.length}`;

            downloadBtn.href = item.img;
            downloadBtn.setAttribute('download', (item.title || 'dokumentasi').toLowerCase().replace(/[^a-z0-9]/g, '-') + '.jpg');
        }

        function showNext() { renderCurrentItem(currentIndex + 1); }
        function showPrev() { renderCurrentItem(currentIndex - 1); }

        document.addEventListener('click', function(e) {
            const trigger = e.target.closest('.gallery-item-clickable');
            if (trigger) {
                e.preventDefault();
                const container = document.getElementById('berandaGaleriContainer') || document;
                const triggers = Array.from(container.querySelectorAll('.gallery-item-clickable.gallery-img-wrapper'));

                currentPlaylist = triggers.map(el => ({
                    img: el.getAttribute('data-img'),
                    title: el.getAttribute('data-title'),
                    desc: el.getAttribute('data-desc'),
                    tipe: el.getAttribute('data-tipe')
                }));

                const clickedImgSrc = trigger.getAttribute('data-img');
                currentIndex = currentPlaylist.findIndex(item => item.img === clickedImgSrc);
                if (currentIndex === -1) currentIndex = 0;

                renderCurrentItem(currentIndex);

                if (window.bootstrap && window.bootstrap.Modal) {
                    const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                    bsModal.show();
                }
            }
        });

        if (btnNext) btnNext.addEventListener('click', (e) => { e.stopPropagation(); showNext(); });
        if (btnPrev) btnPrev.addEventListener('click', (e) => { e.stopPropagation(); showPrev(); });

        modalEl.addEventListener('shown.bs.modal', function() {
            window.addEventListener('keydown', handleKeyNav);
        });
        modalEl.addEventListener('hidden.bs.modal', function() {
            window.removeEventListener('keydown', handleKeyNav);
            imgEl.src = '';
        });

        function handleKeyNav(e) {
            if (!modalEl.classList.contains('show')) return;
            if (e.key === 'ArrowRight' || e.key === 'Right') {
                e.preventDefault();
                showNext();
            } else if (e.key === 'ArrowLeft' || e.key === 'Left') {
                e.preventDefault();
                showPrev();
            }
        }
    })();
</script>