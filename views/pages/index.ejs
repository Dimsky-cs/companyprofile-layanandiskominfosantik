                    <span class="badge px-2.5 py-1.5 rounded-pill text-uppercase fw-bold shrink-0" id="lightboxTipeBadge" style="background-color: var(--orange-primary); font-size: 0.72rem;">Foto</span>
                    <h6 class="modal-title fw-bold text-white mb-0 text-truncate" id="lightboxTitle" style="font-size: 1rem;">Detail Dokumentasi</h6>
                </div>
                <div class="d-flex align-items-center gap-2 shrink-0">
                    <span class="badge bg-secondary bg-opacity-50 text-light fw-medium px-3 py-1.5 rounded-pill small" id="lightboxCounter">1 dari 1</span>
                    <button type="button" class="btn-close btn-close-white ms-2 shadow-none" data-bs-dismiss="modal" aria-label="Tutup"></button>
                </div>
            </div>

            <div class="modal-body p-0 d-flex align-items-center justify-content-center position-relative bg-black" style="min-height: 50vh; max-height: 75vh; overflow: hidden; user-select: none;">
                <button type="button" id="btnPrevLightbox" class="lightbox-nav-btn start-0 ms-3" title="Sebelumnya">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <img id="lightboxImg" src="" class="img-fluid" style="max-height: 75vh; width: auto; object-fit: contain; transition: opacity 0.2s ease-in-out;" alt="Preview Dokumentasi">
                <button type="button" id="btnNextLightbox" class="lightbox-nav-btn end-0 me-3" title="Berikutnya">
                    <i class="bi bi-chevron-right"></i>
