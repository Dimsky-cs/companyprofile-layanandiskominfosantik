<% 
    const listStruktur = (typeof strukturList !== 'undefined' && Array.isArray(strukturList)) ? strukturList : [];
    const dataProfil = (typeof profil !== 'undefined' && profil) ? profil : {};
    const listHierarchy = (typeof flatHierarchy !== 'undefined' && Array.isArray(flatHierarchy) && flatHierarchy.length > 0) ? flatHierarchy : listStruktur;
    const treeStatistics = (typeof treeStats !== 'undefined' && treeStats) ? treeStats : { totalNodes: listStruktur.length, totalRoots: 0, totalParents: 0, totalLeaves: 0, maxDepth: 0 };
    const treeData = (typeof orgTree !== 'undefined' && Array.isArray(orgTree)) ? orgTree : [];
%>

<!-- HEADER ATAS -->
<header class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div>
        <div class="flex items-center gap-2 mb-1">
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-orange-100 text-orange-700 border border-orange-200">
                SOTK Hierarki Ultra Dinamis
            </span>
            <span class="text-xs text-slate-400">• Adjacency List Tree Database</span>
        </div>
        <h2 class="text-2xl font-bold text-navy-900 mb-1">Profil Dinas & Struktur Organisasi</h2>
        <p class="text-slate-500 text-sm">Kelola visi, misi, kontak, peta kantor, dan bagan hierarki pohon (Tree) kedinasan.</p>
    </div>
    <div class="flex items-center gap-2.5">
        <button type="button" onclick="openModalResetProfil()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition-all font-semibold px-4 py-2.5 rounded-xl flex items-center gap-2 text-sm" title="Kosongkan data profil atau bagan">
            <i data-lucide="rotate-ccw" class="w-4 h-4 text-slate-500"></i> Atur Ulang / Kosongkan
        </button>
        <button onclick="openModalTambahBaru()" class="bg-orange-500 hover:bg-orange-600 transition-all text-white font-bold px-5 py-2.5 rounded-xl flex items-center gap-2 shadow-lg shadow-orange-500/25 text-sm">
            <i data-lucide="plus-circle" class="w-5 h-5"></i> Tambah Jabatan
        </button>
    </div>
</header>

<!-- TAB KONTROL ADMIN -->
<div class="flex items-center gap-2 border-b border-slate-200 mb-6 pb-2 overflow-x-auto">
    <button onclick="switchProfilSubTab('profil', this)" data-subtab="profil" class="btn-profil-tab px-4 py-2 text-sm font-bold text-orange-600 border-b-2 border-orange-500 transition-all flex items-center gap-2 whitespace-nowrap">
        <i data-lucide="building" class="w-4 h-4"></i> Visi, Misi & Lokasi Peta
    </button>
    <button onclick="switchProfilSubTab('struktur', this)" data-subtab="struktur" class="btn-profil-tab px-4 py-2 text-sm font-bold text-slate-500 hover:text-navy-900 border-b-2 border-transparent transition-all flex items-center gap-2 whitespace-nowrap">
        <i data-lucide="network" class="w-4 h-4"></i> Bagan Struktur (<%= listStruktur.length %>)
    </button>
    <button onclick="switchProfilSubTab('preview', this)" data-subtab="preview" class="btn-profil-tab px-4 py-2 text-sm font-bold text-slate-500 hover:text-navy-900 border-b-2 border-transparent transition-all flex items-center gap-2 whitespace-nowrap">
        <i data-lucide="eye" class="w-4 h-4"></i> 👁️ Pratinjau Bagan
    </button>
</div>

<!-- ============================================================== -->
<!-- SUB-TAB 1: FORM VISI, MISI, KONTAK & GOOGLE MAPS -->
<!-- ============================================================== -->
<div id="subtab-profil" class="profil-subtab-pane">
    <div class="bg-white rounded-3xl border border-slate-100 p-8 shadow-sm">
        <form action="/admin-diskominfo/profil/update" method="POST" class="space-y-6 max-w-3xl">
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Nama Instansi Resmi</label>
                <input type="text" name="nama_instansi" value="<%= dataProfil.nama_instansi || '' %>" placeholder="Contoh: DISKOMINFOSANTIK KABUPATEN BEKASI" class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-orange-500 outline-none font-bold text-navy-900">
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Visi Daerah / Instansi</label>
                <textarea id="editor-visi" name="visi" rows="3" placeholder="Ketikkan visi resmi di sini..." class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-orange-500 outline-none"><%= dataProfil.visi || '' %></textarea>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Misi Pembangunan</label>
                <textarea id="editor-misi" name="misi" rows="6" placeholder="Ketikkan butir-butir misi pembangunan di sini..." class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-orange-500 outline-none"><%= dataProfil.misi || '' %></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Nomor Telepon Kantor / Hotline</label>
                    <input type="text" name="telepon" value="<%= dataProfil.telepon || '' %>" placeholder="Contoh: (021) 89970000" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Alamat Surel Resmi Kedinasan</label>
                    <input type="email" name="email" value="<%= dataProfil.email || '' %>" placeholder="Contoh: diskominfo@bekasikab.go.id" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none">
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Alamat Fisik Kantor</label>
                <textarea name="alamat" rows="2" placeholder="Contoh: Komplek Perkantoran Pemkab Bekasi, Cikarang Pusat..." class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none"><%= dataProfil.alamat || '' %></textarea>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Tautan Embed Google Maps (URL pada src iframe)</label>
                <input type="text" name="gmaps_iframe" value="<%= dataProfil.gmaps_iframe || '' %>" placeholder="https://www.google.com/maps/embed?pb=..." class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none">
                <p class="text-[11px] text-slate-400 mt-1">Salin hanya URL di dalam <code>src="..."</code> dari menu Bagikan ➔ Sematkan Peta di Google Maps.</p>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <button type="button" onclick="openModalResetProfil()" class="px-4 py-2.5 text-xs font-semibold text-slate-500 hover:text-rose-600 hover:bg-rose-50/50 dark:hover:bg-rose-950/20 rounded-xl transition-all flex items-center gap-1.5 border border-slate-200 dark:border-slate-700">
                    <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> Kosongkan Data Profil
                </button>
                <button type="submit" class="px-6 py-3 bg-orange-500 hover:bg-orange-600 text-white font-bold text-xs rounded-xl shadow-lg shadow-orange-500/30 transition-all flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4"></i> Simpan Profil Dinas & Lokasi
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ============================================================== -->
<!-- SUB-TAB 2: DAFTAR JABATAN STRUKTUR ORGANISASI (SESUAI DATABASE) -->
<!-- ============================================================== -->
<div id="subtab-struktur" class="profil-subtab-pane hidden space-y-4">
    
    <!-- STATISTIK RINGKAS 5 KOMPONEN TREE -->
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
        <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-slate-100 text-navy-900 flex items-center justify-center font-bold text-sm shrink-0">
                <i data-lucide="layers" class="w-5 h-5"></i>
            </div>
            <div>
                <span class="text-[11px] text-slate-400 font-bold uppercase tracking-wider block">Jumlah Posisi</span>
                <span class="text-lg font-extrabold text-navy-900"><%= listStruktur.length %></span>
            </div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-amber-100 shadow-sm flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 border border-amber-200 flex items-center justify-center font-bold text-base shrink-0">
                👑
            </div>
            <div>
                <span class="text-[11px] text-amber-700 font-bold uppercase tracking-wider block">Puncak (Akar)</span>
                <span class="text-lg font-extrabold text-amber-800"><%= treeStatistics.totalRoots %></span>
            </div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-blue-100 shadow-sm flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 border border-blue-200 flex items-center justify-center font-bold text-base shrink-0">
                👔
            </div>
            <div>
                <span class="text-[11px] text-blue-700 font-bold uppercase tracking-wider block">Induk (Atasan)</span>
                <span class="text-lg font-extrabold text-blue-800"><%= treeStatistics.totalParents %></span>
            </div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-emerald-100 shadow-sm flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-200 flex items-center justify-center font-bold text-base shrink-0">
                🌿
            </div>
            <div>
                <span class="text-[11px] text-emerald-700 font-bold uppercase tracking-wider block">Pelaksana (Daun)</span>
                <span class="text-lg font-extrabold text-emerald-800"><%= treeStatistics.totalLeaves %></span>
            </div>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-3 col-span-2 sm:col-span-1">
            <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 border border-purple-200 flex items-center justify-center font-bold text-base shrink-0">
                ⚡
            </div>
            <div>
                <span class="text-[11px] text-purple-700 font-bold uppercase tracking-wider block">Tingkat Hirarki</span>
                <span class="text-lg font-extrabold text-purple-800"><%= treeStatistics.maxDepth %></span>
            </div>
        </div>
    </div>

    <!-- PANDUAN 5 KOMPONEN UTAMA STRUKTUR HIERARKI -->
    <div class="bg-gradient-to-r from-slate-900 to-navy-900 text-white rounded-2xl p-4 shadow-sm flex flex-wrap items-center justify-between gap-3 text-xs">
        <div class="flex flex-wrap items-center gap-2">
            <span class="font-bold text-amber-400 flex items-center gap-1">
                <i data-lucide="info" class="w-4 h-4"></i> 5 Komponen Struktur Hierarki:
            </span>
            <span class="px-2.5 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 font-medium" title="Posisi teratas / pimpinan tertinggi">
                👑 Puncak (Akar)
            </span>
            <span class="px-2.5 py-1 rounded-full bg-blue-500/20 text-blue-300 border border-blue-500/30 font-medium" title="Pimpinan unit kerja">
                👔 Induk (Pimpinan / Koordinator)
            </span>
            <span class="px-2.5 py-1 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 font-medium" title="Sub-jabatan yang terhubung di bawah pimpinan">
                👶 Cabang (Sub-Jabatan)
            </span>
            <span class="px-2.5 py-1 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 font-medium" title="Posisi yang memiliki atasan yang sama">
                👥 Sejawat (Tingkat Sejajar)
            </span>
            <span class="px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-medium" title="Posisi pelaksana teknis">
                🌿 Pelaksana (Ujung Cabang)
            </span>
        </div>
        <div class="text-[11px] text-slate-300">
            Perubahan hierarki langsung memperbarui bagan secara menyeluruh tanpa batas tingkat kedalaman.
        </div>
    </div>

    <!-- TABEL UTAMA SOTK -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <h4 class="font-bold text-navy-900 text-sm">Tabel Hierarki SOTK (Urutan Penelusuran Hierarki)</h4>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold <%= listStruktur.length > 0 ? 'bg-orange-100 text-orange-700' : 'bg-slate-100 text-slate-500' %>">
                    <%= listStruktur.length %> Posisi Terdaftar
                </span>
            </div>
            <% if (listStruktur.length > 0) { %>
                <form action="/admin-diskominfo/struktur/reset-all" method="POST" onsubmit="return confirm('PERINGATAN: Kosongkan semua jabatan pada bagan struktur organisasi?');">
                    <button type="submit" class="text-xs font-bold text-rose-600 hover:text-rose-700 hover:bg-rose-50 px-3 py-1.5 rounded-lg border border-rose-200 transition-all flex items-center gap-1.5">
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Kosongkan Bagan
                    </button>
                </form>
            <% } %>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-100 text-xs text-slate-500 uppercase tracking-wider">
                        <th class="px-6 py-4 font-bold">Garis Hierarki & Nama Jabatan</th>
                        <th class="px-6 py-4 font-bold">Pejabat Pemegang</th>
                        <th class="px-6 py-4 font-bold text-center">Peran Hierarki</th>
                        <th class="px-6 py-4 font-bold">Atasan Langsung</th>
                        <th class="px-6 py-4 font-bold text-right">Tindakan</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    <% if (listHierarchy.length > 0) { %>
                        <% listHierarchy.forEach(s => { %>
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <!-- KOLOM 1: HIERARKI & JABATAN -->
                                <td class="px-6 py-4 font-bold text-navy-900">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-slate-400 select-none text-xs"><%= s.treePrefix || '•' %></span>
                                        <div>
                                            <span class="text-navy-900 font-bold <%= s.isRoot ? 'text-base text-amber-700' : '' %>">
                                                <%= s.jabatan %>
                                            </span>
                                            <div class="flex items-center gap-1.5 mt-0.5">
                                                <span class="text-[10px] px-1.5 py-0.2 rounded bg-slate-100 text-slate-600 font-medium">
                                                    Tingkat <%= (s.level !== undefined ? s.level + 1 : 1) %>
                                                </span>
                                                <span class="text-[10px] text-slate-400">
                                                    Urutan: #<%= s.urutan || 1 %>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- KOLOM 2: NAMA PEJABAT -->
                                <td class="px-6 py-4 text-slate-600">
                                    <% if (s.nama_pejabat && s.nama_pejabat.trim() !== '') { %>
                                        <div class="font-medium text-slate-800"><%= s.nama_pejabat %></div>
                                    <% } else { %>
                                        <span class="text-slate-400 italic text-xs font-normal">(Posisi Kosong / Belum Ada Pejabat)</span>
                                    <% } %>
                                </td>

                                <!-- KOLOM 3: 5 KOMPONEN TREE BADGE -->
                                <td class="px-6 py-4 text-center">
                                    <div class="inline-flex flex-col items-center gap-1">
                                        <% if (s.isRoot) { %>
                                            <span class="px-3 py-1 bg-amber-50 text-amber-700 font-extrabold text-xs rounded-full border border-amber-300 shadow-sm">
                                                👑 PUNCAK (Akar)
                                            </span>
                                        <% } else if (s.isParent) { %>
                                            <span class="px-3 py-1 bg-blue-50 text-blue-700 font-extrabold text-xs rounded-full border border-blue-300 shadow-sm">
                                                👔 INDUK (<%= s.childrenCount || 0 %> Sub-Jabatan)
                                            </span>
                                        <% } else { %>
                                            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 font-extrabold text-xs rounded-full border border-emerald-300 shadow-sm">
                                                🌿 PELAKSANA (Daun)
                                            </span>
                                        <% } %>

                                        <% if (s.siblingsCount && s.siblingsCount > 0) { %>
                                            <span class="text-[10px] text-slate-500 flex items-center gap-1">
                                                <i data-lucide="users" class="w-3 h-3 text-slate-400"></i> <%= s.siblingsCount %> Rekan (Sibling)
                                            </span>
                                        <% } %>
                                    </div>
                                </td>

                                <!-- KOLOM 4: ATASAN LANGSUNG -->
                                <td class="px-6 py-4 text-slate-600 text-xs">
                                    <% if (s.nama_atasan) { %>
                                        <span class="font-semibold text-slate-800"><%= s.nama_atasan %></span>
                                    <% } else { %>
                                        <span class="text-amber-700 font-semibold italic">— Puncak Hierarki (Root)</span>
                                    <% } %>
                                </td>

                                <!-- KOLOM 5: AKSI -->
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-2">
                                        <button type="button" 
                                                data-parent-id="<%= s.id %>"
                                                data-parent-title="<%= s.jabatan || '' %>"
                                                onclick="openModalAddSub(this.dataset.parentId, this.dataset.parentTitle)"
                                                class="px-2.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition-all flex items-center gap-1 shadow-sm"
                                                title="Tambah Sub-Jabatan di bawah <%= s.jabatan %>">
                                            <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i> + Sub
                                        </button>
                                        <button type="button" 
                                                class="btn-edit-struktur px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold transition-all flex items-center gap-1 shadow-sm"
                                                data-id="<%= s.id %>"
                                                data-parent="<%= s.parent_id || '' %>"
                                                data-tipe="<%= s.tipe_posisi || '' %>"
                                                data-urutan="<%= s.urutan || 1 %>">
                                            <i data-lucide="edit-3" class="w-3.5 h-3.5"></i> Ubah
                                            <span class="hidden-jabatan hidden"><%= s.jabatan %></span>
                                            <span class="hidden-pejabat hidden"><%= s.nama_pejabat || '' %></span>
                                        </button>
                                        <button type="button" 
                                                class="btn-hapus-struktur px-3 py-1.5 bg-rose-50 hover:bg-rose-600 text-rose-600 hover:text-white dark:bg-rose-950/30 dark:hover:bg-rose-600 dark:text-rose-400 dark:hover:text-white border border-rose-200 dark:border-rose-900/40 rounded-xl text-xs font-bold transition-all flex items-center gap-1 shadow-2xs"
                                                data-id="<%= s.id %>"
                                                title="Hapus Jabatan <%= s.jabatan %>">
                                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Hapus
                                            <span class="hidden-hapus-jabatan hidden"><%= s.jabatan %></span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="py-16 text-center">
                                <div class="max-w-md mx-auto flex flex-col items-center">
                                    <div class="w-16 h-16 rounded-2xl bg-orange-50 border border-orange-100 flex items-center justify-center text-orange-500 mb-3 shadow-sm">
                                        <i data-lucide="network" class="w-8 h-8"></i>
                                    </div>
                                    <h4 class="text-base font-bold text-navy-900 mb-1">Bagan Struktur Masih Kosong</h4>
                                    <p class="text-xs text-slate-500 mb-5 leading-relaxed">
                                        Belum ada hierarki jabatan yang ditambahkan ke database. Mulai dengan membuat posisi Puncak Pimpinan (Root / Kepala Dinas), lalu hubungkan posisi Parent dan Leaf di bawahnya.
                                    </p>
                                    <button type="button" onclick="openModalTambahBaru()" class="px-5 py-2.5 bg-orange-500 hover:bg-orange-600 text-white text-xs font-bold rounded-xl shadow-lg shadow-orange-500/25 flex items-center gap-2 transition-all">
                                        <i data-lucide="plus-circle" class="w-4 h-4"></i> Tambah Posisi Puncak
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- SUB-TAB 3: LIVE PREVIEW BAGAN (ULTRA DINAMIS TREE ENGINE) -->
<!-- ============================================================== -->
<style>
    /* CSS ULTRA DINAMIS KANVAS INTERAKTIF PREVIEW */
    .admin-viewport {
        position: relative;
        width: 100%;
        min-height: 540px;
        height: 65vh;
        max-height: 720px;
        background: #F8FAFC;
        background-image: 
            radial-gradient(circle at 1px 1px, rgba(148, 163, 184, 0.25) 1px, transparent 0);
        background-size: 24px 24px;
        overflow: hidden;
        border-radius: 20px;
        border: 1px solid #E2E8F0;
        cursor: grab;
        user-select: none;
    }
    .admin-viewport.is-dragging {
        cursor: grabbing;
    }
    .admin-stage {
        position: absolute;
        top: 0;
        left: 0;
        transform-origin: 0 0;
        transition: transform 0.05s ease-out;
    }
    .admin-svg-connectors {
        position: absolute;
        top: 0;
        left: 0;
        pointer-events: none;
        z-index: 1;
    }
    .admin-cards-container {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 2;
    }
    .admin-node-card {
        position: absolute;
        width: 220px;
        min-height: 88px;
        border-radius: 16px;
        padding: 12px 14px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
        background: #FFFFFF;
        border: 2px solid #CBD5E1;
        cursor: grab;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: box-shadow 0.2s ease, border-color 0.2s ease;
        user-select: none;
    }
    .admin-node-card:hover {
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.14);
        z-index: 10;
    }
    .admin-node-card.is-dragging-card {
        cursor: grabbing !important;
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.28) !important;
        border-color: #F97316 !important;
        transform: scale(1.04) !important;
        z-index: 99 !important;
        transition: none !important;
    }
    .admin-node-card.node-root {
        background: #0F172A;
        color: #FFFFFF;
        border-color: #F97316;
        box-shadow: 0 10px 24px rgba(249, 115, 22, 0.2);
    }
    .admin-node-card.node-parent {
        background: #FFFFFF;
        border-color: #3B82F6;
        box-shadow: 0 8px 20px rgba(59, 130, 246, 0.12);
    }
    .admin-node-card.node-leaf {
        background: #FFFFFF;
        border-color: #10B981;
        box-shadow: 0 6px 16px rgba(16, 185, 129, 0.1);
    }
    .admin-node-role-badge {
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        display: inline-block;
        padding: 2px 7px;
        border-radius: 9999px;
        margin-bottom: 4px;
        align-self: flex-start;
    }
    .node-root .admin-node-role-badge {
        background: #F97316;
        color: #FFFFFF;
    }
    .node-parent .admin-node-role-badge {
        background: #EFF6FF;
        color: #2563EB;
        border: 1px solid #BFDBFE;
    }
    .node-leaf .admin-node-role-badge {
        background: #ECFDF5;
        color: #059669;
        border: 1px solid #A7F3D0;
    }
    .admin-node-title {
        font-size: 0.82rem;
        font-weight: 700;
        line-height: 1.3;
        margin-bottom: 2px;
    }
    .node-root .admin-node-title { color: #FFFFFF; }
    .node-parent .admin-node-title, .node-leaf .admin-node-title { color: #0F172A; }
    .admin-node-person {
        font-size: 0.72rem;
        line-height: 1.25;
    }
    .node-root .admin-node-person { color: #FDBA74; }
    .node-parent .admin-node-person, .node-leaf .admin-node-person { color: #64748B; }

    .btn-admin-collapse {
        margin-top: 6px;
        background: #F1F5F9;
        border: 1px solid #E2E8F0;
        border-radius: 9999px;
        font-size: 0.65rem;
        font-weight: 700;
        color: #334155;
        padding: 2px 8px;
        display: inline-flex;
        align-items: center;
        gap: 3px;
        transition: all 0.2s ease;
        align-self: flex-start;
    }
    .btn-admin-collapse:hover {
        background: #E2E8F0;
        color: #0F172A;
    }
    .btn-admin-collapse.collapsed {
        background: #FEF3C7;
        color: #B45309;
        border-color: #FDE68A;
    }

    /* BADGE TOGGLE HUBUNGAN MENYATU / LINI PADA KARTU */
    .admin-node-wing-toggle {
        margin-top: 6px;
        border-radius: 9999px;
        font-size: 0.65rem;
        font-weight: 700;
        padding: 2px 7px;
        display: inline-flex;
        align-items: center;
        gap: 3px;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        cursor: pointer;
        user-select: none;
    }
    .admin-node-wing-toggle:hover {
        transform: translateY(-1px) scale(1.04);
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }
    .admin-node-wing-toggle.is-wing {
        background: #EFF6FF;
        color: #1D4ED8;
        border: 1px solid #93C5FD;
    }
    .admin-node-wing-toggle.is-wing:hover {
        background: #DBEAFE;
        color: #1E40AF;
        border-color: #60A5FA;
    }
    .admin-node-wing-toggle.is-line {
        background: #F8FAFC;
        color: #64748B;
        border: 1px solid #E2E8F0;
    }
    .admin-node-wing-toggle.is-line:hover {
        background: #F1F5F9;
        color: #0F172A;
        border-color: #CBD5E1;
    }

    /* OUTLINE TREE ROW */
    .admin-outline-row {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        transition: all 0.15s ease;
        cursor: pointer;
    }
    .admin-outline-row:hover {
        background: #FFFFFF;
        border-color: #F97316;
        transform: translateX(4px);
    }
    .admin-outline-row[data-level="1"] { margin-left: 24px; }
    .admin-outline-row[data-level="2"] { margin-left: 48px; }
    .admin-outline-row[data-level="3"] { margin-left: 72px; }
    .admin-outline-row[data-level="4"] { margin-left: 96px; }
    .admin-outline-row[data-level="5"] { margin-left: 120px; }
    .admin-outline-row[data-level="6"] { margin-left: 144px; }
    .admin-outline-row[data-level="7"] { margin-left: 168px; }
    .admin-outline-row[data-level="8"] { margin-left: 192px; }
</style>

<div id="subtab-preview" class="profil-subtab-pane hidden space-y-4">
    <div class="bg-white rounded-3xl border border-slate-100 p-6 sm:p-8 shadow-sm">
        
        <!-- HEADER PREVIEW & TOOLBAR -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4 pb-4 border-b border-slate-100">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-emerald-100 text-emerald-800 border border-emerald-200">
                        Tampilan Nyata
                    </span>
                    <h4 class="font-bold text-navy-900 text-base">Pratinjau Nyata Bagan SOTK Ultra Dinamis</h4>
                </div>
                <p class="text-xs text-slate-400">
                    Bagan dirender secara otomatis sesuai susunan hierarki di database. Geser kanvas untuk berpindah, gulir mouse untuk perbesar/perkecil.
                </p>
            </div>
            <div class="flex items-center gap-2">
                <!-- Mode View Toggle -->
                <div class="bg-slate-100 p-1 rounded-xl flex items-center gap-1 border border-slate-200">
                    <button type="button" id="btnAdminModeVisual" onclick="switchAdminPreviewMode('visual')" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-navy-900 text-white shadow-sm flex items-center gap-1.5 transition-all">
                        <i data-lucide="network" class="w-3.5 h-3.5"></i> Bagan Visual
                    </button>
                    <button type="button" id="btnAdminModeOutline" onclick="switchAdminPreviewMode('outline')" class="px-3 py-1.5 rounded-lg text-xs font-bold text-slate-600 hover:text-navy-900 flex items-center gap-1.5 transition-all">
                        <i data-lucide="list-tree" class="w-3.5 h-3.5"></i> Garis Hierarki
                    </button>
                </div>
                <a href="/profil" target="_blank" class="px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white text-xs font-bold rounded-xl flex items-center gap-1.5 shadow-md shadow-orange-500/20 transition-all">
                    <i data-lucide="external-link" class="w-3.5 h-3.5"></i> Portal Publik
                </a>
            </div>
        </div>

        <% if (listStruktur.length > 0) { %>
            <!-- EMBED DATA JSON -->
            <script id="adminTreeData" type="application/json">
                <%- JSON.stringify(treeData) %>
            </script>
            <script id="adminAllNodesData" type="application/json">
                <%- JSON.stringify(listStruktur) %>
            </script>
            <script id="adminBaganConfig" type="application/json">
                <%- JSON.stringify(dataProfil.bagan_config ? (typeof dataProfil.bagan_config === 'string' ? JSON.parse(dataProfil.bagan_config) : dataProfil.bagan_config) : null) %>
            </script>

            <!-- TAMPILAN 1: BAGAN VISUAL CANVAS -->
            <div id="containerAdminVisual">
                <!-- PANEL PENGATUR GARIS & POSISI ULTRA DINAMIS -->
                <div class="bg-slate-50 border border-slate-200/90 rounded-2xl p-3.5 mb-3 text-xs shadow-xs">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-2">
                            <span class="w-8 h-8 rounded-xl bg-orange-500/10 text-orange-600 flex items-center justify-center font-bold">
                                <i data-lucide="sliders" class="w-4 h-4"></i>
                            </span>
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="font-bold text-navy-900 block text-xs">Pengaturan Garis & Posisi Bagan Ultra Dinamis</span>
                                    <span id="baganStatusBadge" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-200 text-slate-700 hidden"></span>
                                </div>
                                <span class="text-[11px] text-slate-400">Geser penggeser atau seret langsung kartu posisi di kanvas, lalu klik <strong>Simpan Tata Letak</strong></span>
                            </div>
                        </div>

                        <!-- SLIDER & STYLE CONTROLS -->
                        <div class="flex flex-wrap items-center gap-2.5">
                            <!-- Slider: Geser Garis Siku (Elbow Height) -->
                            <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-xl border border-slate-200 shadow-2xs">
                                <span class="text-slate-600 font-semibold text-[11px] whitespace-nowrap flex items-center gap-1">
                                    <i data-lucide="git-commit" class="w-3.5 h-3.5 text-orange-500"></i> Geser Garis Cabang:
                                </span>
                                <input type="range" id="sliderAdminElbow" min="15" max="85" value="50" class="w-24 accent-orange-500 cursor-pointer" title="Geser posisi garis horizontal ke atas/bawah">
                                <span id="valAdminElbow" class="font-mono font-bold text-navy-900 text-[11px] w-8 text-right">50%</span>
                            </div>

                            <!-- Slider: Jarak Vertikal (V-Gap) -->
                            <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-xl border border-slate-200 shadow-2xs">
                                <span class="text-slate-600 font-semibold text-[11px] whitespace-nowrap flex items-center gap-1">
                                    <i data-lucide="arrow-up-down" class="w-3.5 h-3.5 text-blue-500"></i> Jarak Vertikal:
                                </span>
                                <input type="range" id="sliderAdminVGap" min="40" max="150" value="72" class="w-20 accent-blue-500 cursor-pointer" title="Atur jarak antar level hierarki">
                                <span id="valAdminVGap" class="font-mono font-bold text-navy-900 text-[11px] w-9 text-right">72px</span>
                            </div>

                            <!-- Slider: Jarak Horizontal (H-Gap) -->
                            <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-xl border border-slate-200 shadow-2xs">
                                <span class="text-slate-600 font-semibold text-[11px] whitespace-nowrap flex items-center gap-1">
                                    <i data-lucide="arrow-left-right" class="w-3.5 h-3.5 text-emerald-500"></i> Jarak Kotak:
                                </span>
                                <input type="range" id="sliderAdminHGap" min="16" max="90" value="36" class="w-20 accent-emerald-500 cursor-pointer" title="Atur jarak horizontal antar kotak">
                                <span id="valAdminHGap" class="font-mono font-bold text-navy-900 text-[11px] w-9 text-right">36px</span>
                            </div>

                            <!-- Pilihan Gaya Garis -->
                            <div class="flex items-center bg-white p-1 rounded-xl border border-slate-200 shadow-2xs">
                                <button type="button" id="btnAdminLineOrtho" onclick="setAdminLineStyle('orthogonal')" class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-navy-900 text-white transition-all shadow-xs" title="Garis Siku Standar Kedinasan">
                                    📐 Siku
                                </button>
                                <button type="button" id="btnAdminLineCurve" onclick="setAdminLineStyle('curve')" class="px-2.5 py-1 rounded-lg text-[11px] font-bold text-slate-600 hover:text-navy-900 transition-all" title="Garis Kurva Halus">
                                    〰️ Kurva
                                </button>
                                <button type="button" id="btnAdminLineDirect" onclick="setAdminLineStyle('direct')" class="px-2.5 py-1 rounded-lg text-[11px] font-bold text-slate-600 hover:text-navy-900 transition-all" title="Garis Lurus Langsung">
                                    ⚡ Lurus
                                </button>
                            </div>

                            <!-- Keterangan Ultra Dinamis -->
                            <div class="hidden xl:flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 rounded-xl border border-blue-200/80 text-[11px] font-semibold text-blue-900 shadow-2xs">
                                <i data-lucide="sparkles" class="w-3.5 h-3.5 text-blue-600"></i>
                                <span>Klik badge <strong>🔗 Menyatu</strong> / <strong>⬇️ Lini Bawah</strong> di tiap kartu untuk atur sambungan</span>
                            </div>

                            <!-- Tombol Reset Layout -->
                            <button type="button" onclick="adminResetTreeLayout()" class="px-3 py-1.5 bg-white hover:bg-slate-100 text-slate-700 font-bold rounded-xl border border-slate-200 text-[11px] flex items-center gap-1 shadow-2xs transition-all" title="Kembalikan semua posisi garis dan kartu ke tata letak standar pohon">
                                <i data-lucide="rotate-ccw" class="w-3.5 h-3.5 text-slate-400"></i> Tata Letak Awal
                            </button>

                            <!-- Tombol Simpan Tata Letak -->
                            <button type="button" id="btnAdminSaveBagan" onclick="adminSaveTreeLayout()" class="px-4 py-1.5 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-bold rounded-xl text-[11px] flex items-center gap-1.5 shadow-md shadow-emerald-600/25 transition-all" title="Simpan hasil modifikasi garis & letak kartu ke database agar tampil identik di halaman publik">
                                <i data-lucide="save" class="w-3.5 h-3.5"></i>
                                <span id="btnAdminSaveBaganText">Simpan Tata Letak</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- TOOLBAR KONTROL ZOOM & FIT -->
                <div class="flex items-center justify-between mb-3 px-1 text-xs text-slate-500">
                    <div class="flex items-center gap-2">
                        <span class="text-slate-400"><i data-lucide="move" class="w-3.5 h-3.5 inline text-orange-500"></i> Seret kartu posisi untuk mengatur garis bebas, seret kanvas untuk menggeser sudut pandang, klik kartu untuk ubah rincian.</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <button type="button" onclick="adminTreeZoomIn()" class="p-1.5 bg-slate-100 hover:bg-slate-200 text-navy-900 rounded-lg border border-slate-200 transition-all" title="Perbesar">
                            <i data-lucide="zoom-in" class="w-4 h-4"></i>
                        </button>
                        <button type="button" onclick="adminTreeZoomOut()" class="p-1.5 bg-slate-100 hover:bg-slate-200 text-navy-900 rounded-lg border border-slate-200 transition-all" title="Perkecil">
                            <i data-lucide="zoom-out" class="w-4 h-4"></i>
                        </button>
                        <button type="button" onclick="adminTreeResetView()" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-navy-900 font-bold rounded-lg border border-slate-200 text-[11px] transition-all" title="Ukuran Semula">
                            100%
                        </button>
                        <button type="button" onclick="adminTreeCenterFit()" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-navy-900 font-bold rounded-lg border border-slate-200 text-[11px] transition-all" title="Posisikan ke Tengah">
                            Penuh Layar
                        </button>
                        <button type="button" onclick="adminTreeExpandAll()" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-navy-900 font-bold rounded-lg border border-slate-200 text-[11px] transition-all" title="Buka Semua Cabang">
                            Buka Cabang
                        </button>
                    </div>
                </div>

                <!-- VIEWPORT INTERAKTIF -->
                <div id="adminTreeViewport" class="admin-viewport">
                    <div id="adminTreeStage" class="admin-stage">
                        <svg id="adminTreeSvg" class="admin-svg-connectors"></svg>
                        <div id="adminTreeCardsBox" class="admin-cards-container"></div>
                    </div>
                </div>
            </div>

            <!-- TAMPILAN 2: GARIS HIERARKI (OUTLINE TREE VIEW) -->
            <div id="containerAdminOutline" class="hidden">
                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 text-left">
                    <h5 class="font-bold text-navy-900 text-sm mb-4 pb-2 border-b border-slate-200 flex items-center justify-between">
                        <span class="flex items-center gap-2"><i data-lucide="list-tree" class="w-4 h-4 text-orange-500"></i> Garis Komando SOTK Sesuai Hierarki</span>
                        <span class="text-xs text-slate-400 font-normal"><%= listHierarchy.length %> Posisi Terdaftar</span>
                    </h5>

                    <div class="space-y-2">
                        <% listHierarchy.forEach(item => { %>
                            <div class="admin-outline-row" data-level="<%= item.level || 0 %>" data-id="<%= item.id %>" onclick="quickEditNode(this.dataset.id)">
                                <div class="flex items-center gap-2">
                                    <span class="font-mono text-slate-400 text-xs"><%= item.treePrefix %></span>
                                    <div>
                                        <span class="font-bold text-navy-900 text-sm"><%= item.jabatan %></span>
                                        <% if (item.nama_pejabat) { %>
                                            <span class="text-xs text-slate-500 ml-1">(• <%= item.nama_pejabat %>)</span>
                                        <% } else { %>
                                            <span class="text-xs text-slate-400 italic ml-1">(Posisi Kosong)</span>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <% if (item.isRoot) { %>
                                        <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[11px] font-bold border border-amber-200">👑 PUNCAK</span>
                                    <% } else if (item.isParent) { %>
                                        <span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 text-[11px] font-bold border border-blue-200">👔 INDUK (<%= item.childrenCount || 0 %>)</span>
                                    <% } else { %>
                                        <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[11px] font-bold border border-emerald-200">🌿 PELAKSANA</span>
                                    <% } %>
                                    <span class="text-xs text-slate-400"><i data-lucide="edit-3" class="w-3.5 h-3.5 inline"></i></span>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>

        <% } else { %>
            <div class="py-16 text-center flex flex-col items-center justify-center">
                <div class="w-16 h-16 rounded-2xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-400 mb-3 shadow-sm">
                    <i data-lucide="git-fork" class="w-8 h-8"></i>
                </div>
                <h5 class="text-sm font-bold text-navy-900 mb-1">Pratinjau Bagan Masih Kosong</h5>
                <p class="text-xs text-slate-400 max-w-sm mb-4 leading-relaxed">
                    Bagan struktur organisasi visual akan digambar secara otomatis setelah posisi jabatan ditambahkan ke database.
                </p>
                <button type="button" onclick="activateProfilSubTab('struktur')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-navy-900 text-xs font-bold rounded-xl flex items-center gap-2 transition-all border border-slate-200 shadow-sm">
                    <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> Buka Tab Bagan Struktur
                </button>
            </div>
        <% } %>

    </div>
</div>

<!-- ============================================================== -->
<!-- MODAL TAMBAH JABATAN -->
<!-- ============================================================== -->
<div id="modalTambahStruktur" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-slate-950/75 backdrop-blur-md p-3 sm:p-4 md:p-6 transition-all duration-300" style="scrollbar-gutter: stable;">
    <div class="bg-white dark:bg-slate-900 rounded-3xl w-full max-w-lg shadow-2xl border border-slate-100 dark:border-slate-800 overflow-hidden flex flex-col max-h-[90vh] sm:max-h-[88vh] my-auto">
        <!-- Pinned Header -->
        <div class="px-6 py-4.5 bg-navy-900 text-white flex items-center justify-between shrink-0 border-b border-slate-800">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-orange-500 inline-block"></span>
                <h3 class="text-base font-bold text-white leading-none">Tambah Posisi Hierarki SOTK</h3>
            </div>
            <button type="button" onclick="closeModalTambahStruktur()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-slate-300 hover:text-white flex items-center justify-center transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <form action="/admin-diskominfo/struktur/tambah" method="POST" class="flex-1 flex flex-col min-h-0">
            <!-- Scrollable Body -->
            <div class="p-5 sm:p-6 space-y-4 overflow-y-auto flex-1 min-h-0 overscroll-contain">
                <!-- Banner Indikator jika tambah Sub-Jabatan -->
                <div id="subJabatanBanner" class="hidden p-3 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 rounded-2xl text-xs text-emerald-800 dark:text-emerald-300 flex items-center gap-2">
                    <i data-lucide="corner-down-right" class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0"></i>
                    <span>Menambahkan Sub-Jabatan di bawah: <strong id="subJabatanParentName" class="text-emerald-900 dark:text-emerald-200"></strong></span>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1.5">Nama Jabatan</label>
                    <input type="text" name="jabatan" required placeholder="Contoh: Kepala Dinas / Sekretaris / Kepala Bidang TIK" class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none">
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider">Nama Pejabat</label>
                        <span class="text-[11px] text-slate-400 dark:text-slate-500 font-semibold">(Opsional / Boleh Kosong)</span>
                    </div>
                    <input type="text" name="nama_pejabat" placeholder="Kosongkan jika posisi belum terisi pejabat..." class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1.5">Atasan Langsung (Posisi Induk)</label>
                    <select id="tambahStrukturParent" name="parent_id" onchange="onTambahParentChange(this.value)" class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none font-medium">
                        <option value="">— Tidak Ada (Sebagai Puncak Pimpinan) —</option>
