<!-- ============================================================== -->
<!-- SCRIPT INTERAKTIF SUB-TAB, MODAL & ULTRA DINAMIS PREVIEW ENGINE -->
<!-- ============================================================== -->
<script>
    function activateProfilSubTab(tabName) {
        if (!tabName) tabName = 'profil';

        // 1. Update status tombol tab
        document.querySelectorAll('.btn-profil-tab').forEach(b => {
            b.classList.remove('text-orange-600', 'border-orange-500');
            b.classList.add('text-slate-500', 'border-transparent');
            if (b.getAttribute('data-subtab') === tabName) {
                b.classList.add('text-orange-600', 'border-orange-500');
                b.classList.remove('text-slate-500', 'border-transparent');
            }
        });

        // 2. Tampilkan panel tab yang aktif
        document.querySelectorAll('.profil-subtab-pane').forEach(el => el.classList.add('hidden'));
        const target = document.getElementById('subtab-' + tabName);
        if (target) {
            target.classList.remove('hidden');
        } else {
            const fallback = document.getElementById('subtab-profil');
            if (fallback) fallback.classList.remove('hidden');
        }

        // 3. Simpan state di localStorage
        localStorage.setItem('active_profil_subtab', tabName);

        // 4. Jika tab preview dibuka, re-render kanvas pohon
        if (tabName === 'preview' && typeof initAdminTreeCanvas === 'function') {
            setTimeout(initAdminTreeCanvas, 50);
        }

        // 5. Pastikan ikon Lucide ter-render sempurna di setiap subtab (termasuk BPS)
        if (window.lucide) {
            lucide.createIcons();
        }
    }

    function switchProfilSubTab(tabName, btn) {
        activateProfilSubTab(tabName);
    }



    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const subtabParam = urlParams.get('subtab');
        const savedSubtab = subtabParam || localStorage.getItem('active_profil_subtab') || 'profil';
        activateProfilSubTab(savedSubtab);
    });

    function openModalTambahBaru() {
        document.getElementById('subJabatanBanner').classList.add('hidden');
        const parentSelect = document.getElementById('tambahStrukturParent');
        if (parentSelect) parentSelect.value = '';
        const tipeSelect = document.getElementById('tambahStrukturTipe');
        if (tipeSelect) {
            const hasPositions = '<%= listStruktur.length > 0 %>' === 'true';
            tipeSelect.value = hasPositions ? 'LINE_BIDANG' : 'ROOT';
        }
        openModalTambahStruktur();
    }

    function openModalAddSub(parentId, parentTitle) {
        document.getElementById('subJabatanBanner').classList.remove('hidden');
        document.getElementById('subJabatanParentName').textContent = parentTitle;
        const parentSelect = document.getElementById('tambahStrukturParent');
        if (parentSelect) {
            parentSelect.value = parentId;
        }
        const tipeSelect = document.getElementById('tambahStrukturTipe');
        if (tipeSelect) {
            tipeSelect.value = 'LINE_BIDANG';
        }
        openModalTambahStruktur();
    }

    function onTambahParentChange(val) {
        const tipeSelect = document.getElementById('tambahStrukturTipe');
        if (!tipeSelect) return;
        if (!val || val === '') {
            tipeSelect.value = 'ROOT';
        } else if (tipeSelect.value === 'ROOT') {
            tipeSelect.value = 'LINE_BIDANG';
        }
    }

    function teleportModalProfil(modalId) {
        const m = document.getElementById(modalId);
        if (m && m.parentElement !== document.body) {
            document.body.appendChild(m);
        }
    }

    function openModalTambahStruktur() {
        teleportModalProfil('modalTambahStruktur');
        const m = document.getElementById('modalTambahStruktur');
        m.classList.remove('hidden');
        m.classList.add('flex');
        document.body.classList.add('overflow-hidden');
    }
    function closeModalTambahStruktur() {
        const m = document.getElementById('modalTambahStruktur');
        m.classList.add('hidden');
        m.classList.remove('flex');
        document.getElementById('subJabatanBanner').classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }

    function openModalEditStruktur() {
        teleportModalProfil('modalEditStruktur');
        const m = document.getElementById('modalEditStruktur');
        m.classList.remove('hidden');
        m.classList.add('flex');
        document.body.classList.add('overflow-hidden');
    }
    function closeModalEditStruktur() {
        const m = document.getElementById('modalEditStruktur');
        m.classList.add('hidden');
        m.classList.remove('flex');
        document.body.classList.remove('overflow-hidden');
    }

    function openModalHapusStruktur() {
        teleportModalProfil('modalHapusStruktur');
        const m = document.getElementById('modalHapusStruktur');
        m.classList.remove('hidden');
        m.classList.add('flex');
        document.body.classList.add('overflow-hidden');
    }
    function closeModalHapusStruktur() {
        const m = document.getElementById('modalHapusStruktur');
        m.classList.add('hidden');
        m.classList.remove('flex');
        document.body.classList.remove('overflow-hidden');
    }

    function openModalResetProfil() {
        teleportModalProfil('modalResetProfil');
        const m = document.getElementById('modalResetProfil');
        m.classList.remove('hidden');
        m.classList.add('flex');
        document.body.classList.add('overflow-hidden');
    }
    function closeModalResetProfil() {
        const m = document.getElementById('modalResetProfil');
        m.classList.add('hidden');
        m.classList.remove('flex');
        document.body.classList.remove('overflow-hidden');
    }

    function quickEditNode(nodeId) {
        const btn = document.querySelector(`.btn-edit-struktur[data-id="${nodeId}"]`);
        if (btn) btn.click();
    }

    // Atur indentasi Admin Outline Tree jika level > 8
    document.querySelectorAll('.admin-outline-row[data-level]').forEach(el => {
        const lvl = parseInt(el.dataset.level, 10);
        if (!isNaN(lvl)) el.style.marginLeft = (lvl * 24) + 'px';
    });

    document.addEventListener("click", function(e) {
        const btnEdit = e.target.closest(".btn-edit-struktur");
        if (btnEdit) {
            const id = btnEdit.dataset.id;
            const parent = btnEdit.dataset.parent;
            const tipe = btnEdit.dataset.tipe;
            const urutan = btnEdit.dataset.urutan;
            const jabatan = btnEdit.querySelector(".hidden-jabatan").innerText;
            const pejabat = btnEdit.querySelector(".hidden-pejabat").innerText;

            let tipeVal = tipe;
            if (!tipeVal || tipeVal === '') {
                tipeVal = (!parent ? 'ROOT' : 'LINE_BIDANG');
            }

            document.getElementById("editStrukturId").value = id;
            document.getElementById("editStrukturJabatan").value = jabatan;
            document.getElementById("editStrukturPejabat").value = pejabat;
            document.getElementById("editStrukturTipe").value = tipeVal;
            
            // Atur pilihan parent dan disable opsi node itu sendiri (anti-siklus langsung)
            const parentSelect = document.getElementById("editStrukturParent");
            if (parentSelect) {
                Array.from(parentSelect.options).forEach(opt => {
                    opt.disabled = (opt.value === String(id));
                });
                parentSelect.value = parent || '';
            }

            document.getElementById("editStrukturUrutan").value = urutan || 1;

            openModalEditStruktur();
            return;
        }

        const btnHapus = e.target.closest(".btn-hapus-struktur");
        if (btnHapus) {
            const id = btnHapus.dataset.id;
            const jabatan = btnHapus.querySelector(".hidden-hapus-jabatan").innerText;
            document.getElementById("deleteStrukturTitle").textContent = `"${jabatan}"`;
            document.getElementById("btnConfirmDeleteStruktur").href = `/admin-diskominfo/struktur/hapus/${id}`;
            openModalHapusStruktur();
        }
    });

    // ==============================================================
    // ENGINE ULTRA DINAMIS PREVIEW UNTUK SUB-TAB 3 ADMIN
    // ==============================================================
    let ADM_CARD_W = 220;
    let ADM_CARD_H = 88;
    let ADM_H_GAP  = 36;
    let ADM_V_GAP  = 72;
    let ADM_PAD    = 40;
    let adminElbowRatio = 0.50; // 0.15 - 0.85 (posisi garis siku)
    let adminLineStyle = 'orthogonal'; // 'orthogonal' | 'curve' | 'direct'
    let customNodePositions = new Map(); // id -> { x, y }
    let adminWingNodeIds = new Set(); // ID jabatan yang dipilih sebagai MENYATU
    let adminNonWingNodeIds = new Set(); // ID jabatan yang dipilih sebagai LINI BAWAH
    let adminTreeInitialized = false;
    let adminZoom = 1;
    let adminPanX = 0;
    let adminPanY = 0;
    let adminIsDragging = false;
    let adminStartX = 0;
    let adminStartY = 0;
    let adminNodeMap = new Map();
    let adminRoots = [];
    let adminRootTree = null;

    // FUNGSI STATUS PERUBAHAN & TOAST
    function markBaganUnsaved() {
        const badge = document.getElementById('baganStatusBadge');
        if (badge) {
            badge.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200 inline-block';
            badge.innerHTML = '● Perubahan Belum Disimpan';
        }
    }

    function markBaganSaved() {
        const badge = document.getElementById('baganStatusBadge');
        if (badge) {
            badge.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200 inline-block';
            badge.innerHTML = '✓ Tersimpan & Sinkron Publik';
        }
    }

    function showAdminToast(msg, type = 'success') {
        if (typeof showAdminAlert === 'function') {
            showAdminAlert(msg, type);
            return;
        }
        let toast = document.getElementById('adminToastNotification');
        if (!toast) {
            toast = document.createElement('div');
            toast.id = 'adminToastNotification';
            document.body.appendChild(toast);
        }
        toast.className = `fixed bottom-6 right-6 z-50 flex items-center gap-2.5 px-4 py-3 rounded-2xl shadow-xl transition-all duration-300 transform text-xs font-bold ${
            type === 'success' ? 'bg-navy-900 text-white border border-emerald-500 shadow-emerald-500/20' : 'bg-rose-600 text-white shadow-rose-600/30'
        }`;
        toast.innerHTML = `<span class="w-2 h-2 rounded-full ${type === 'success' ? 'bg-emerald-400 animate-ping' : 'bg-white'}"></span> <span>${msg}</span>`;
        requestAnimationFrame(() => {
            toast.style.transform = 'translateY(0)';
            toast.style.opacity = '1';
        });
        setTimeout(() => {
            toast.style.transform = 'translateY(20px)';
            toast.style.opacity = '0';
        }, 3500);
    }

    // SIMPAN KONFIGURASI TATA LETAK KE DATABASE
    window.adminSaveTreeLayout = async function() {
        const btn = document.getElementById('btnAdminSaveBagan');
        const btnText = document.getElementById('btnAdminSaveBaganText');
        const originalText = 'Simpan Tata Letak';

        if (btn) btn.disabled = true;
        if (btnText) btnText.textContent = 'Menyimpan...';

        const positionsObj = {};
        customNodePositions.forEach((pos, id) => {
            positionsObj[id] = pos;
        });

        const config = {
            elbowRatio: adminElbowRatio,
            vGap: ADM_V_GAP,
            hGap: ADM_H_GAP,
            lineStyle: (adminLineStyle === 'kedinasan' ? 'orthogonal' : adminLineStyle),
            customPositions: positionsObj,
            wingNodes: Array.from(adminWingNodeIds),
            nonWingNodes: Array.from(adminNonWingNodeIds)
        };

        try {
            const resp = await fetch('/admin-diskominfo/profil/save-bagan-config', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ config })
            });
            const res = await resp.json();
            if (res.success) {
                markBaganSaved();
                if (btnText) btnText.textContent = '✓ Berhasil Disimpan!';
                showAdminToast(res.message || 'Tata letak bagan berhasil disimpan!', 'success');
                setTimeout(() => {
                    if (btnText) btnText.textContent = originalText;
                    if (btn) btn.disabled = false;
                }, 2000);
            } else {
                showAdminToast('Gagal menyimpan: ' + (res.message || 'Terjadi kesalahan sistem'), 'error');
                if (btnText) btnText.textContent = originalText;
                if (btn) btn.disabled = false;
            }
        } catch(err) {
            showAdminToast('Gagal menghubungi server: ' + err.message, 'error');
            if (btnText) btnText.textContent = originalText;
            if (btn) btn.disabled = false;
        }
    };

    function applyDefaultKedinasanCoordinates(nodes, posMap) {
        if (!nodes || nodes.length === 0) return;
        const kadin = nodes.find(n => n.parent_id === null || (n.jabatan || '').toLowerCase().includes('kepala dinas')) || nodes[0];
        const sek = nodes.find(n => (n.jabatan || '').toLowerCase().includes('sekretar') || n.tipe_posisi === 'STAFF_SAYAP');
        const subbag = (sek ? nodes.find(n => n.parent_id === sek.id) : null) || nodes.find(n => (n.jabatan || '').toLowerCase().includes('sub') || (n.jabatan || '').toLowerCase().includes('kasubag'));
        const fung = nodes.find(n => (n.jabatan || '').toLowerCase().includes('fungsional') || (n.jabatan || '').toLowerCase().includes('koordinator'));
        
        let bidangList = nodes.filter(n => {
            if (kadin && n.id === kadin.id) return false;
            if (sek && n.id === sek.id) return false;
            if (subbag && n.id === subbag.id) return false;
            if (fung && n.id === fung.id) return false;
            return n.parent_id === (kadin ? kadin.id : null) || (n.jabatan || '').toLowerCase().includes('bidang');
        });

        bidangList.sort((a, b) => {
            const getRank = (item) => {
                const j = (item.jabatan || '').toLowerCase();
                if (j.includes('informasi dan komunikasi') || j.includes('ikp')) return 1;
                if (j.includes('teknologi')) return 2;
                if (j.includes('statistik')) return 3;
                if (j.includes('persandian')) return 4;
                return 5 + (Number(item.urutan) || 1);
            };
            return getRank(a) - getRank(b);
        });

        const startX = 60;
        const bGap = 36;
        const bY = 420;

        bidangList.forEach((b, idx) => {
            const bx = startX + idx * (ADM_CARD_W + bGap);
            posMap.set(Number(b.id), { x: bx, y: bY });
        });

        const totalSpan = bidangList.length > 0 ? (bidangList.length * ADM_CARD_W + (bidangList.length - 1) * bGap) : 988;
        const centerSpineX = startX + totalSpan / 2;
        const kadinX = Math.round(centerSpineX - ADM_CARD_W / 2);

        if (kadin) {
            posMap.set(Number(kadin.id), { x: kadinX, y: 40 });
        }
        if (sek) {
            const sekX = Math.round(centerSpineX + 180);
            posMap.set(Number(sek.id), { x: Math.max(sekX, 740), y: 160 });
        }
        if (subbag) {
            const subX = Math.round(centerSpineX + 268);
            posMap.set(Number(subbag.id), { x: Math.max(subX, 828), y: 290 });
        }
        if (fung) {
            posMap.set(Number(fung.id), { x: kadinX, y: 230 });
        }
    }

    function loadSavedBaganConfig(allNodes) {
        const savedConfigEl = document.getElementById('adminBaganConfig');
        let hasCustomPositions = false;
        if (savedConfigEl && savedConfigEl.textContent) {
            try {
                const savedCfg = JSON.parse(savedConfigEl.textContent);
                if (savedCfg && typeof savedCfg === 'object') {
                    if (Array.isArray(savedCfg.wingNodes)) {
                        adminWingNodeIds = new Set(savedCfg.wingNodes.map(Number));
                    }
                    if (Array.isArray(savedCfg.nonWingNodes)) {
                        adminNonWingNodeIds = new Set(savedCfg.nonWingNodes.map(Number));
                    }
                    if (typeof savedCfg.elbowRatio === 'number') {
                        adminElbowRatio = savedCfg.elbowRatio;
                        const sElbow = document.getElementById('sliderAdminElbow');
                        const vElbow = document.getElementById('valAdminElbow');
                        if (sElbow) sElbow.value = Math.round(adminElbowRatio * 100);
                        if (vElbow) vElbow.textContent = Math.round(adminElbowRatio * 100) + '%';
                    }
                    if (typeof savedCfg.vGap === 'number') {
                        ADM_V_GAP = savedCfg.vGap;
                        const sVGap = document.getElementById('sliderAdminVGap');
                        const vVGap = document.getElementById('valAdminVGap');
                        if (sVGap) sVGap.value = ADM_V_GAP;
                        if (vVGap) vVGap.textContent = ADM_V_GAP + 'px';
                    }
                    if (typeof savedCfg.hGap === 'number') {
                        ADM_H_GAP = savedCfg.hGap;
                        const sHGap = document.getElementById('sliderAdminHGap');
                        const vHGap = document.getElementById('valAdminHGap');
                        if (sHGap) sHGap.value = ADM_H_GAP;
                        if (vHGap) vHGap.textContent = ADM_H_GAP + 'px';
                    }
                    if (savedCfg.lineStyle) {
                        adminLineStyle = (savedCfg.lineStyle === 'kedinasan' ? 'orthogonal' : savedCfg.lineStyle);
                        setAdminLineStyle(adminLineStyle);
                    } else {
                        setAdminLineStyle('orthogonal');
                    }
                    if (savedCfg.customPositions && typeof savedCfg.customPositions === 'object' && Object.keys(savedCfg.customPositions).length > 0) {
                        customNodePositions.clear();
                        for (const [key, val] of Object.entries(savedCfg.customPositions)) {
                            if (val && typeof val.x === 'number' && typeof val.y === 'number') {
                                customNodePositions.set(Number(key), { x: val.x, y: val.y });
                            }
                        }
                        hasCustomPositions = true;
                    }
                    markBaganSaved();
                }
            } catch(e) {
                console.warn('Gagal membaca saved bagan config:', e);
            }
        }
        if (!hasCustomPositions && allNodes && allNodes.length > 0) {
            applyDefaultKedinasanCoordinates(allNodes, customNodePositions);
        }
    }

    function initAdminTreeCanvas() {
        const rawEl = document.getElementById('adminAllNodesData');
        if (!rawEl) return;

        let allNodes = [];
        try {
            allNodes = JSON.parse(rawEl.textContent || '[]');
        } catch(e) {
            allNodes = [];
        }
        if (!allNodes || allNodes.length === 0) return;

        const viewport = document.getElementById('adminTreeViewport');
        const stage    = document.getElementById('adminTreeStage');
        const svg      = document.getElementById('adminTreeSvg');
        const cardsBox = document.getElementById('adminTreeCardsBox');
        if (!viewport || !stage || !svg || !cardsBox) return;

        // Muat konfigurasi tersimpan jika ada (atau terapkan preset SOTK kedinasan bawaan)
        loadSavedBaganConfig(allNodes);

        // Reset map & nodes
        adminNodeMap.clear();
        allNodes.forEach(n => {
            adminNodeMap.set(Number(n.id), Object.assign({}, n, {
                id: Number(n.id),
                parent_id: (n.parent_id !== null && n.parent_id !== undefined && n.parent_id !== '') ? Number(n.parent_id) : null,
                children: [],
                isCollapsed: false,
                isRoot: false,
                isParent: false,
                isLeaf: false,
                level: 0
            }));
        });

        // Hubungkan hubungan anak ke parent
        adminRoots = [];
        adminNodeMap.forEach(n => {
            if (n.parent_id !== null && adminNodeMap.has(n.parent_id)) {
                adminNodeMap.get(n.parent_id).children.push(n);
            } else {
                adminRoots.push(n);
            }
        });

        // Urutkan anak
        adminNodeMap.forEach(n => {
            n.children.sort((a, b) => (Number(a.urutan) || 1) - (Number(b.urutan) || 1) || a.id - b.id);
        });
        adminRoots.sort((a, b) => (Number(a.urutan) || 1) - (Number(b.urutan) || 1) || a.id - b.id);

        function markMeta(n, lvl) {
            n.level = lvl;
            n.isRoot = n.parent_id === null;
            n.isParent = n.children.length > 0;
            n.isLeaf = n.children.length === 0;
            n.children.forEach(c => markMeta(c, lvl + 1));
        }
        adminRoots.forEach(r => markMeta(r, 0));

        // Virtual root jika terdapat lebih dari 1 akar
        if (adminRoots.length === 1) {
            adminRootTree = adminRoots[0];
        } else {
            adminRootTree = {
                id: '__adm_virtual__',
                jabatan: 'Pimpinan Kedinasan',
                nama_pejabat: '',
                isRoot: true,
                isParent: true,
                isLeaf: false,
                level: 0,
                children: adminRoots,
                isCollapsed: false,
                isVirtual: true
            };
        }

        renderAdminTree();
        setTimeout(adminTreeCenterFit, 50);

        if (!adminTreeInitialized) {
            adminTreeInitialized = true;

            viewport.addEventListener('mousedown', (e) => {
                if (e.target.closest('.admin-node-card') || e.target.closest('button')) return;
                adminIsDragging = true;
                viewport.classList.add('is-dragging');
                adminStartX = e.clientX - adminPanX;
                adminStartY = e.clientY - adminPanY;
            });

            window.addEventListener('mousemove', (e) => {
                if (!adminIsDragging) return;
                adminPanX = e.clientX - adminStartX;
                adminPanY = e.clientY - adminStartY;
                updateAdminStageTransform();
            });

            window.addEventListener('mouseup', () => {
                adminIsDragging = false;
                viewport.classList.remove('is-dragging');
            });

            viewport.addEventListener('wheel', (e) => {
                e.preventDefault();
                const delta = e.deltaY < 0 ? 0.1 : -0.1;
                adminZoom = Math.min(Math.max(0.4, adminZoom + delta), 2.2);
                updateAdminStageTransform();
            }, { passive: false });
        }
    }

    function measureAdminWidth(node) {
        if (node.isCollapsed || node.children.length === 0) {
            node._w = ADM_CARD_W;
        } else {
            let total = 0;
            node.children.forEach((c, idx) => {
                measureAdminWidth(c);
                total += c._w + (idx > 0 ? ADM_H_GAP : 0);
            });
            node._w = Math.max(ADM_CARD_W, total);
        }
        return node._w;
    }

    function assignAdminCoords(node, leftX, topY) {
        if (customNodePositions.has(node.id)) {
            const saved = customNodePositions.get(node.id);
            node._x = saved.x;
            node._y = saved.y;
        } else {
            node._y = topY;
            node._x = leftX + (node._w - ADM_CARD_W) / 2;
        }

        if (!node.isCollapsed && node.children.length > 0) {
            let curX = leftX;
            node.children.forEach(c => {
                assignAdminCoords(c, curX, topY + ADM_CARD_H + ADM_V_GAP);
                curX += c._w + ADM_H_GAP;
            });
        }
    }

    let admMaxRight = 0;
    let admMaxBottom = 0;
    function computeAdminBounds(node) {
        admMaxRight = Math.max(admMaxRight, node._x + ADM_CARD_W);
        admMaxBottom = Math.max(admMaxBottom, node._y + ADM_CARD_H);
        if (!node.isCollapsed && node.children.length > 0) {
            node.children.forEach(computeAdminBounds);
        }
    }

    function renderAdminTree() {
        if (!adminRootTree) return;
        const stage    = document.getElementById('adminTreeStage');
        const svg      = document.getElementById('adminTreeSvg');
        const cardsBox = document.getElementById('adminTreeCardsBox');
        if (!stage || !svg || !cardsBox) return;

        measureAdminWidth(adminRootTree);
        assignAdminCoords(adminRootTree, ADM_PAD, ADM_PAD);

        admMaxRight = 0;
        admMaxBottom = 0;
        computeAdminBounds(adminRootTree);

        const canvasW = Math.max(1400, admMaxRight + ADM_PAD * 3);
        const canvasH = Math.max(800, admMaxBottom + ADM_PAD * 3);

        stage.style.width = canvasW + 'px';
        stage.style.height = canvasH + 'px';
        svg.setAttribute('width', canvasW);
        svg.setAttribute('height', canvasH);

        cardsBox.innerHTML = '';
        renderAdminCards(adminRootTree, cardsBox);
        redrawAdminSvgOnly();
        updateAdminStageTransform();
        if (window.lucide) lucide.createIcons();
    }

    function renderAdminCards(node, cardsBox) {
        if (!node.isVirtual) {
            const card = document.createElement('div');
            card.className = `admin-node-card ${getAdminNodeClass(node)}`;
            card.style.left = node._x + 'px';
            card.style.top  = node._y + 'px';
            card.setAttribute('data-id', node.id);

            let collapseBtn = '';
            if (node.isParent) {
                const count = node.children.length;
                collapseBtn = node.isCollapsed
                    ? `<button type="button" class="btn-admin-collapse collapsed" onclick="event.stopPropagation(); toggleAdminNodeCollapse(${node.id})"><i data-lucide="plus" class="w-3 h-3 inline"></i> ${count} Sub-Jabatan</button>`
                    : `<button type="button" class="btn-admin-collapse" onclick="event.stopPropagation(); toggleAdminNodeCollapse(${node.id})"><i data-lucide="minus" class="w-3 h-3 inline"></i> ${count} Sub-Jabatan</button>`;
            }

            let wingToggleBtn = '';
            if (!node.isRoot && node.parent_id !== null) {
                const parent = adminNodeMap.get(node.parent_id);
                const isWing = isWingChild(node, parent ? parent.children : []);
                if (isWing) {
                    wingToggleBtn = `<button type="button" class="admin-node-wing-toggle is-wing" onclick="event.stopPropagation(); toggleNodeMenyatu(${node.id})" title="Garis menyatu ke tulang cabang samping. Klik untuk ganti jadi Lini Bawah"><i data-lucide="link" class="w-2.5 h-2.5 inline"></i> Menyatu</button>`;
                } else {
                    wingToggleBtn = `<button type="button" class="admin-node-wing-toggle is-line" onclick="event.stopPropagation(); toggleNodeMenyatu(${node.id})" title="Garis lini ke busbar bawah. Klik untuk ganti jadi Menyatu"><i data-lucide="arrow-down" class="w-2.5 h-2.5 inline"></i> Lini Bawah</button>`;
                }
            }

            const personHtml = node.nama_pejabat 
                ? `<div class="admin-node-person">${escapeHtmlText(node.nama_pejabat)}</div>` 
                : ``;

            card.innerHTML = `
                <div>
                    <div class="admin-node-title">${escapeHtmlText(node.jabatan)}</div>
                    ${personHtml}
                </div>
                <div class="flex items-center gap-1.5 flex-wrap mt-2">
                    ${wingToggleBtn}
                    ${collapseBtn}
                </div>
            `;

            // DRAG KARTU DENGAN REAL-TIME RE-CALCULATING CONNECTORS
            let isDragging = false;
            let startX = 0, startY = 0;
            let initNodeX = 0, initNodeY = 0;
            let moved = false;

            card.addEventListener('mousedown', (e) => {
                if (e.target.closest('button')) return;
                e.stopPropagation();

                isDragging = true;
                moved = false;
                startX = e.clientX;
                startY = e.clientY;
                initNodeX = node._x;
                initNodeY = node._y;

                function onMove(ev) {
                    if (!isDragging) return;
                    const dx = (ev.clientX - startX) / adminZoom;
                    const dy = (ev.clientY - startY) / adminZoom;
                    if (Math.hypot(dx, dy) > 4) {
                        moved = true;
                        card.classList.add('is-dragging-card');
                    }
                    if (moved) {
                        node._x = Math.round(initNodeX + dx);
                        node._y = Math.round(initNodeY + dy);
                        card.style.left = node._x + 'px';
                        card.style.top = node._y + 'px';
                        customNodePositions.set(node.id, { x: node._x, y: node._y });
                        redrawAdminSvgOnly();
                    }
                }

                function onUp() {
                    window.removeEventListener('mousemove', onMove);
                    window.removeEventListener('mouseup', onUp);
                    if (isDragging) {
                        isDragging = false;
                        if (moved) {
                            markBaganUnsaved();
                            setTimeout(() => card.classList.remove('is-dragging-card'), 50);
                        } else {
                            quickEditNode(node.id);
                        }
                    }
                }

                window.addEventListener('mousemove', onMove);
                window.addEventListener('mouseup', onUp);
            });

            cardsBox.appendChild(card);
        }

        if (!node.isCollapsed && node.children.length > 0) {
            node.children.forEach(c => renderAdminCards(c, cardsBox));
        }
    }

    function redrawAdminSvgOnly() {
        const svg = document.getElementById('adminTreeSvg');
        if (!svg || !adminRootTree) return;
        svg.innerHTML = '';
        renderLinesRecursive(adminRootTree, svg);
    }

    function isWingChild(c, allChildren) {
        if (!c) return false;
        const cId = Number(c.id);
        if (adminWingNodeIds.has(cId)) return true;
        if (adminNonWingNodeIds.has(cId)) return false;

        const tip = (c.tipe_posisi || '').toUpperCase();
        if (tip === 'STAFF_SAYAP') return true;
        if (tip === 'LINE_BIDANG' || tip === 'ROOT') return false;

        const jab = (c.jabatan || '').toLowerCase();
        if (jab.includes('sekretar') || jab.includes('staf ahli') || jab.includes('fungsional') || jab.includes('koordinator')) {
            return true;
        }
        if (allChildren && allChildren.length > 1) {
            const maxY = Math.max(...allChildren.map(ch => ch._y));
            if (maxY - c._y > ADM_CARD_H * 0.7) {
                return true;
            }
        }
        return false;
    }

    window.toggleNodeMenyatu = function(nodeId) {
        const id = Number(nodeId);
        const node = adminNodeMap.get(id);
        if (!node) return;
        const parent = node.parent_id ? adminNodeMap.get(node.parent_id) : null;
        const siblings = parent ? parent.children : [];
        const currentIsWing = isWingChild(node, siblings);

        if (currentIsWing) {
            adminWingNodeIds.delete(id);
            adminNonWingNodeIds.add(id);
            showAdminToast(`"${node.jabatan}" diatur ke Garis Lini Bawah`, 'info');
        } else {
            adminNonWingNodeIds.delete(id);
            adminWingNodeIds.add(id);
            showAdminToast(`"${node.jabatan}" diatur ke Garis Menyatu (Sayap Samping)`, 'success');
        }
        markBaganUnsaved();
        renderAdminTree();
    };

    function renderLinesRecursive(node, svg) {
        if (!node.isCollapsed && node.children.length > 0) {
            const parentBottomX = node._x + ADM_CARD_W / 2;
            const parentBottomY = node.isVirtual ? node._y : node._y + ADM_CARD_H;
            const elbowY = parentBottomY + ADM_V_GAP * adminElbowRatio;

            if (adminLineStyle === 'curve') {
                node.children.forEach(c => {
                    const childX = c._x + ADM_CARD_W / 2;
                    drawAdminSvgBezier(svg, parentBottomX, parentBottomY, childX, c._y);
                });
            } else if (adminLineStyle === 'direct') {
                node.children.forEach(c => {
                    const childX = c._x + ADM_CARD_W / 2;
                    drawAdminSvgLine(svg, parentBottomX, parentBottomY, childX, c._y);
                });
            } else {
                // Orthogonal / Siku Standar & Ultra Dinamis Cabang Menyatu
                if (node.children.length === 1) {
                    const child = node.children[0];
                    const childX = child._x + ADM_CARD_W / 2;
                    if (Math.abs(parentBottomX - childX) < 8) {
                        drawAdminSvgLine(svg, parentBottomX, parentBottomY, parentBottomX, child._y);
                    } else {
                        const stepY = parentBottomY + (child._y - parentBottomY) * adminElbowRatio;
                        drawAdminSvgLine(svg, parentBottomX, parentBottomY, parentBottomX, stepY);
                        drawAdminSvgLine(svg, parentBottomX, stepY, childX, stepY);
                        drawAdminSvgLine(svg, childX, stepY, childX, child._y);
                    }
                } else {
                    const wingChildren = node.children.filter(c => isWingChild(c, node.children));
                    const lineChildren = node.children.filter(c => !isWingChild(c, node.children));

                    if (wingChildren.length > 0 && lineChildren.length > 0) {
                        // HIERARKI KEDINASAN DUA TIER: SAYAP MENYATU + LINI BAWAH
                        const minLineY = Math.min(...lineChildren.map(c => c._y));
                        const lineBarY = minLineY - Math.max(22, Math.round(ADM_V_GAP * (1 - adminElbowRatio)));

                        // 1. Tulang Punggung Vertikal Menyatu (Central Spine)
                        drawAdminSvgLine(svg, parentBottomX, parentBottomY, parentBottomX, lineBarY);

                        // 2. Cabang ke Sayap (Menyatu dari Tulang Vertikal)
                        wingChildren.forEach(w => {
                            const wCenterX = w._x + ADM_CARD_W / 2;
                            const wingBranchY = parentBottomY + (w._y - parentBottomY) * adminElbowRatio;
                            drawAdminSvgLine(svg, parentBottomX, wingBranchY, wCenterX, wingBranchY);
                            drawAdminSvgLine(svg, wCenterX, wingBranchY, wCenterX, w._y);

                            // Koordinasi putus-putus jika ada fungsional & sekretariat
                            const isFung = (w.jabatan || '').toLowerCase().includes('fungsional') || (w.jabatan || '').toLowerCase().includes('koordinator');
                            if (isFung) {
                                const sek = wingChildren.find(item => (item.jabatan || '').toLowerCase().includes('sekretar'));
                                if (sek) {
                                    const sekBottomX = sek._x + ADM_CARD_W / 2;
                                    const sekBottomY = sek._y + ADM_CARD_H;
                                    const fMidY = sekBottomY + 16;
                                    drawAdminSvgDashedLine(svg, sekBottomX, sekBottomY, sekBottomX, fMidY);
                                    drawAdminSvgDashedLine(svg, sekBottomX, fMidY, wCenterX, fMidY);
                                    drawAdminSvgDashedLine(svg, wCenterX, fMidY, wCenterX, w._y);
                                }
                            }
                        });

                        // 3. Garis Busbar Horizontal Distribusi Bidang
                        const lineXs = lineChildren.map(c => c._x + ADM_CARD_W / 2);
                        const minLineX = Math.min(parentBottomX, ...lineXs);
                        const maxLineX = Math.max(parentBottomX, ...lineXs);
                        drawAdminSvgLine(svg, minLineX, lineBarY, maxLineX, lineBarY);

                        // 4. Drop Garis Vertikal Menuju Atap Masing-Masing Bidang
                        lineChildren.forEach(c => {
                            const cX = c._x + ADM_CARD_W / 2;
                            drawAdminSvgLine(svg, cX, lineBarY, cX, c._y);
                        });
                    } else if (wingChildren.length > 0 && lineChildren.length === 0) {
                        // Semua anak sayap menyatu
                        const maxWingY = Math.max(...wingChildren.map(w => w._y));
                        const lastBranchY = parentBottomY + (maxWingY - parentBottomY) * adminElbowRatio;
                        drawAdminSvgLine(svg, parentBottomX, parentBottomY, parentBottomX, lastBranchY);

                        wingChildren.forEach(w => {
                            const wCenterX = w._x + ADM_CARD_W / 2;
                            const wingBranchY = parentBottomY + (w._y - parentBottomY) * adminElbowRatio;
                            drawAdminSvgLine(svg, parentBottomX, wingBranchY, wCenterX, wingBranchY);
                            drawAdminSvgLine(svg, wCenterX, wingBranchY, wCenterX, w._y);
                        });
                    } else {
                        // Semua anak lini bawah standar busbar
                        drawAdminSvgLine(svg, parentBottomX, parentBottomY, parentBottomX, elbowY);

                        const childXs = node.children.map(c => c._x + ADM_CARD_W / 2);
                        const minX = Math.min(parentBottomX, ...childXs);
                        const maxX = Math.max(parentBottomX, ...childXs);
                        drawAdminSvgLine(svg, minX, elbowY, maxX, elbowY);

                        node.children.forEach(c => {
                            const childX = c._x + ADM_CARD_W / 2;
                            drawAdminSvgLine(svg, childX, elbowY, childX, c._y);
                        });
                    }
                }
            }

            node.children.forEach(c => renderLinesRecursive(c, svg));
        }
    }

    function getAdminNodeClass(n) {
        if (n.isRoot) return 'node-root';
        if (n.isParent) return 'node-parent';
        return 'node-leaf';
    }

    function drawAdminSvgLine(svg, x1, y1, x2, y2) {
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', Math.round(x1));
        line.setAttribute('y1', Math.round(y1));
        line.setAttribute('x2', Math.round(x2));
        line.setAttribute('y2', Math.round(y2));
        line.setAttribute('stroke', '#0F172A');
        line.setAttribute('stroke-width', '2');
        line.setAttribute('stroke-linecap', 'round');
        svg.appendChild(line);
    }

    function drawAdminSvgDashedLine(svg, x1, y1, x2, y2) {
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', Math.round(x1));
        line.setAttribute('y1', Math.round(y1));
        line.setAttribute('x2', Math.round(x2));
        line.setAttribute('y2', Math.round(y2));
        line.setAttribute('stroke', '#0F172A');
        line.setAttribute('stroke-width', '2');
        line.setAttribute('stroke-dasharray', '5,4');
        line.setAttribute('stroke-linecap', 'round');
        svg.appendChild(line);
    }

    function drawAdminSvgBezier(svg, x1, y1, x2, y2) {
        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        const midY = (y1 + y2) / 2;
        const d = `M ${Math.round(x1)} ${Math.round(y1)} C ${Math.round(x1)} ${Math.round(midY)}, ${Math.round(x2)} ${Math.round(midY)}, ${Math.round(x2)} ${Math.round(y2)}`;
        path.setAttribute('d', d);
        path.setAttribute('fill', 'none');
        path.setAttribute('stroke', '#0F172A');
        path.setAttribute('stroke-width', '2');
        path.setAttribute('stroke-linecap', 'round');
        svg.appendChild(path);
    }

    window.setAdminLineStyle = function(style) {
        adminLineStyle = (style === 'kedinasan' ? 'orthogonal' : style);
        const btnOrtho = document.getElementById('btnAdminLineOrtho');
        const btnCurve = document.getElementById('btnAdminLineCurve');
        const btnDirect = document.getElementById('btnAdminLineDirect');
        const buttons = [
            { el: btnOrtho, key: 'orthogonal' },
            { el: btnCurve, key: 'curve' },
            { el: btnDirect, key: 'direct' }
        ];
        buttons.forEach(b => {
            if (!b.el) return;
            if (b.key === adminLineStyle) {
                b.el.className = 'px-2.5 py-1 rounded-lg text-[11px] font-bold bg-navy-900 text-white transition-all shadow-xs';
            } else {
                b.el.className = 'px-2.5 py-1 rounded-lg text-[11px] font-bold text-slate-600 hover:text-navy-900 transition-all';
            }
        });
        redrawAdminSvgOnly();
        markBaganUnsaved();
    };

    window.adminResetTreeLayout = function() {
        customNodePositions.clear();
        adminWingNodeIds.clear();
        adminNonWingNodeIds.clear();
        adminElbowRatio = 0.50;
        ADM_V_GAP = 72;
        ADM_H_GAP = 36;
        adminLineStyle = 'orthogonal';

        const sliderElbow = document.getElementById('sliderAdminElbow');
        if (sliderElbow) sliderElbow.value = 50;
        const valElbow = document.getElementById('valAdminElbow');
        if (valElbow) valElbow.textContent = '50%';

        const sliderVGap = document.getElementById('sliderAdminVGap');
        if (sliderVGap) sliderVGap.value = 72;
        const valVGap = document.getElementById('valAdminVGap');
        if (valVGap) valVGap.textContent = '72px';

        const sliderHGap = document.getElementById('sliderAdminHGap');
        if (sliderHGap) sliderHGap.value = 36;
        const valHGap = document.getElementById('valAdminHGap');
        if (valHGap) valHGap.textContent = '36px';

        setAdminLineStyle('orthogonal');
        renderAdminTree();
        adminTreeCenterFit();
        markBaganUnsaved();
    };

    document.addEventListener('DOMContentLoaded', () => {
        const sliderElbow = document.getElementById('sliderAdminElbow');
        if (sliderElbow) {
            sliderElbow.addEventListener('input', function() {
                adminElbowRatio = Number(this.value) / 100;
                const valEl = document.getElementById('valAdminElbow');
                if (valEl) valEl.textContent = this.value + '%';
                redrawAdminSvgOnly();
                markBaganUnsaved();
            });
        }
        const sliderVGap = document.getElementById('sliderAdminVGap');
        if (sliderVGap) {
            sliderVGap.addEventListener('input', function() {
                ADM_V_GAP = Number(this.value);
                const valEl = document.getElementById('valAdminVGap');
                if (valEl) valEl.textContent = this.value + 'px';
                renderAdminTree();
                markBaganUnsaved();
            });
        }
        const sliderHGap = document.getElementById('sliderAdminHGap');
        if (sliderHGap) {
            sliderHGap.addEventListener('input', function() {
                ADM_H_GAP = Number(this.value);
                const valEl = document.getElementById('valAdminHGap');
                if (valEl) valEl.textContent = this.value + 'px';
                renderAdminTree();
                markBaganUnsaved();
            });
        }
    });

    function escapeHtmlText(str) {
        if (!str) return '';
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    function updateAdminStageTransform() {
        const stage = document.getElementById('adminTreeStage');
        if (stage) {
            stage.style.transform = `translate(${adminPanX}px, ${adminPanY}px) scale(${adminZoom})`;
        }
    }

    window.adminTreeZoomIn = function() {
        adminZoom = Math.min(2.2, adminZoom + 0.15);
        updateAdminStageTransform();
    };
    window.adminTreeZoomOut = function() {
        adminZoom = Math.max(0.4, adminZoom - 0.15);
        updateAdminStageTransform();
    };
    window.adminTreeResetView = function() {
        adminZoom = 1;
        adminPanX = 0;
        adminPanY = 0;
        updateAdminStageTransform();
    };
    window.adminTreeCenterFit = function() {
        const viewport = document.getElementById('adminTreeViewport');
        const stage    = document.getElementById('adminTreeStage');
        if (!viewport || !stage) return;
        const vpW = viewport.clientWidth;
        const stageW = parseInt(stage.style.width) || 800;
        adminZoom = Math.min(1, Math.max(0.45, (vpW - 60) / stageW));
        adminPanX = Math.max(10, (vpW - stageW * adminZoom) / 2);
        adminPanY = 20;
        updateAdminStageTransform();
    };
    window.toggleAdminNodeCollapse = function(id) {
        const node = adminNodeMap.get(Number(id));
        if (node) {
            node.isCollapsed = !node.isCollapsed;
            renderAdminTree();
        }
    };
    window.adminTreeExpandAll = function() {
        adminNodeMap.forEach(n => { n.isCollapsed = false; });
        renderAdminTree();
    };

    window.switchAdminPreviewMode = function(mode) {
        const vBox = document.getElementById('containerAdminVisual');
        const oBox = document.getElementById('containerAdminOutline');
        const bVisual = document.getElementById('btnAdminModeVisual');
        const bOutline = document.getElementById('btnAdminModeOutline');

        if (mode === 'visual') {
            vBox.classList.remove('hidden');
            oBox.classList.add('hidden');
            bVisual.classList.add('bg-navy-900', 'text-white', 'shadow-sm');
            bVisual.classList.remove('text-slate-600');
            bOutline.classList.remove('bg-navy-900', 'text-white', 'shadow-sm');
            bOutline.classList.add('text-slate-600');
            setTimeout(adminTreeCenterFit, 50);
        } else {
            vBox.classList.add('hidden');
            oBox.classList.remove('hidden');
            bOutline.classList.add('bg-navy-900', 'text-white', 'shadow-sm');
            bOutline.classList.remove('text-slate-600');
            bVisual.classList.remove('bg-navy-900', 'text-white', 'shadow-sm');
            bVisual.classList.add('text-slate-600');
        }
    };

    // ==============================================================
    // INISIALISASI CKEDITOR 5 UNTUK VISI & MISI PROFIL
    // ==============================================================
    let editorVisiInstance = null;
    let editorMisiInstance = null;

    function initProfilCKEditors() {
        if (typeof ClassicEditor === 'undefined') return;

        const elVisi = document.querySelector('#editor-visi');
        if (elVisi && !editorVisiInstance) {
            ClassicEditor.create(elVisi, {
                toolbar: {
                    items: [
                        'heading', '|',
                        'bold', 'italic', 'underline', '|',
                        'bulletedList', 'numberedList', 'blockQuote', '|',
                        'undo', 'redo'
                    ]
                },
                placeholder: 'Ketikkan visi instansi di sini...'
            }).then(editor => {
                editorVisiInstance = editor;
                editor.model.document.on('change:data', () => {
                    elVisi.value = editor.getData();
                });
            }).catch(err => console.error('CKEditor Visi init error:', err));
        }

        const elMisi = document.querySelector('#editor-misi');
        if (elMisi && !editorMisiInstance) {
            ClassicEditor.create(elMisi, {
                toolbar: {
                    items: [
                        'heading', '|',
                        'bold', 'italic', 'underline', '|',
                        'bulletedList', 'numberedList', 'blockQuote', '|',
                        'undo', 'redo'
                    ]
                },
                placeholder: 'Ketikkan butir-butir misi pembangunan di sini...'
            }).then(editor => {
                editorMisiInstance = editor;
                editor.model.document.on('change:data', () => {
                    elMisi.value = editor.getData();
                });
            }).catch(err => console.error('CKEditor Misi init error:', err));
        }

        const formProfil = document.querySelector('form[action="/admin-diskominfo/profil/update"]');
        if (formProfil && !formProfil.dataset.ckeditorBound) {
            formProfil.dataset.ckeditorBound = 'true';
            formProfil.addEventListener('submit', () => {
                if (editorVisiInstance) {
                    elVisi.value = editorVisiInstance.getData();
                }
                if (editorMisiInstance) {
                    elMisi.value = editorMisiInstance.getData();
                }
            });
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initProfilCKEditors);
    } else {
        initProfilCKEditors();
    }

    if (window.lucide) {
        lucide.createIcons();
    }
</script>