<!-- HEADER ATAS -->
<header class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div>
        <h2 class="text-2xl font-bold text-navy-900 mb-1 flex items-center gap-2.5">
            <i data-lucide="newspaper" class="w-7 h-7 text-sky-500"></i>
            Pengelolaan Berita & Publikasi
        </h2>
        <p class="text-slate-500 text-sm">Kelola publikasi artikel, siaran pers, dan informasi publik secara lengkap.</p>
    </div>
    <!-- Tombol Buka Modal Tulis Berita -->
    <button onclick="openModalTambahBerita()" class="bg-orange-500 hover:bg-orange-600 transition-all text-white font-bold px-5 py-2.5 rounded-xl flex items-center gap-2 shadow-lg shadow-orange-500/25 text-sm">
        <i data-lucide="plus-circle" class="w-5 h-5"></i> Tulis Berita Baru
    </button>
</header>


<!-- TABEL DAFTAR BERITA -->
<div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full min-w-[650px] text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-100 text-xs text-slate-500 uppercase tracking-wider">
                    <th class="px-6 py-4 font-bold">Artikel</th>
                    <th class="px-6 py-4 font-bold">Kategori</th>
                    <th class="px-6 py-4 font-bold">Penulis</th>
                    <th class="px-6 py-4 font-bold">Tanggal Terbit</th>
                    <th class="px-6 py-4 font-bold text-center">Tindakan Kelola</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <% if (typeof beritaList !== 'undefined' && beritaList.length > 0) { %>
                    <% beritaList.forEach(b => { %>
                        <tr class="hover:bg-slate-50/50 transition-colors group">
                            <!-- Foto & Judul -->
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-14 h-14 rounded-2xl bg-slate-100 overflow-hidden shrink-0 border border-slate-200 shadow-sm">
                                        <img src="<%= b.gambar || 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=120' %>" class="w-full h-full object-cover" alt="Foto Sampul">
                                    </div>
                                    <div class="max-w-md">
                                        <div class="font-bold text-navy-900 text-sm leading-snug line-clamp-2"><%= b.judul %></div>
                                    </div>
                                </div>
                            </td>
                            <!-- Kategori -->
                            <td class="px-6 py-4">
                                <span class="px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700">
                                    <%= b.nama_kategori || 'Umum' %>
                                </span>
                            </td>
                            <!-- Penulis -->
                            <td class="px-6 py-4 text-xs font-semibold text-slate-600">
                                <%= b.penulis || 'Redaksi Diskominfo' %>
                            </td>
                            <!-- Tanggal -->
                            <td class="px-6 py-4 text-xs text-slate-500 font-medium whitespace-nowrap">
                                <%= new Date(b.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                            </td>
                            <!-- TOMBOL TINDAKAN: LIHAT, UBAH & HAPUS -->
                            <td class="px-6 py-4">
                                <div class="flex items-center justify-center gap-2">
                                    <!-- 1. Tombol Lihat di Portal Publik -->
                                    <a href="/berita/<%= b.slug %>" target="_blank" class="p-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl transition-all shadow-2xs" title="Buka di Portal Publik">
                                        <i data-lucide="external-link" class="w-4 h-4 text-sky-500"></i>
                                    </a>

                                    <!-- 2. TOMBOL UBAH -->
                                    <button type="button" 
                                            class="btn-edit-berita bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white dark:bg-blue-950/40 dark:text-blue-400 dark:hover:bg-blue-600 dark:hover:text-white px-3.5 py-2 rounded-xl font-bold text-xs flex items-center gap-1.5 transition-all shadow-2xs"
                                            data-id="<%= b.id %>"
                                            data-kategori="<%= b.kategori_id %>"
                                            data-gambar="<%= b.gambar || '' %>"
                                            title="Ubah Berita Ini">
                                        <span class="hidden-judul hidden"><%= b.judul %></span>
                                        <span class="hidden-penulis hidden"><%= b.penulis || 'Redaksi Diskominfo' %></span>
                                        <textarea class="hidden-konten hidden"><%= b.konten %></textarea>
                                        <i data-lucide="edit-3" class="w-3.5 h-3.5"></i> Ubah
                                    </button>

                                    <!-- 3. TOMBOL HAPUS -->
                                    <button type="button" 
                                            class="btn-buka-hapus bg-red-50 text-red-600 hover:bg-red-600 hover:text-white dark:bg-rose-950/40 dark:text-rose-400 dark:hover:bg-rose-600 dark:hover:text-white px-3.5 py-2 rounded-xl font-bold text-xs flex items-center gap-1.5 transition-all shadow-2xs"
                                            data-id="<%= b.id %>"
                                            title="Hapus Berita">
                                        <span class="hidden-judul-hapus hidden"><%= b.judul %></span>
                                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Hapus
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="px-6 py-16 text-center">
                            <div class="w-14 h-14 bg-slate-50 text-slate-300 rounded-2xl flex items-center justify-center mx-auto mb-3">
                                <i data-lucide="newspaper" class="w-8 h-8"></i>
                            </div>
                            <h4 class="text-base font-bold text-navy-900">Belum Ada Berita Diterbitkan</h4>
                            <p class="text-slate-500 text-xs mt-1">Mulai terbitkan rilis pers pertama Anda dengan menekan tombol di atas.</p>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- ========================================================= -->
<!-- 1. MODAL TAMBAH BERITA BARU                              -->
<!-- ========================================================= -->
<!-- 1. MODAL TAMBAH BERITA                                   -->
<!-- ========================================================= -->
<div id="modalTambahBerita" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-slate-950/75 backdrop-blur-md transition-all duration-300 opacity-0 p-3 sm:p-4 md:p-6">
    <div class="fixed inset-0" onclick="closeModalTambahBerita()"></div>
    <div id="boxTambahBerita" class="relative z-10 bg-white dark:bg-slate-900 rounded-3xl w-full max-w-2xl max-h-[90vh] sm:max-h-[88vh] flex flex-col overflow-hidden shadow-2xl border border-slate-100 dark:border-slate-800 transform transition-all duration-300 scale-95 opacity-0 my-auto">
        
        <!-- HEADER (shrink-0) -->
        <div class="shrink-0 px-6 py-4 sm:py-5 bg-navy-900 text-white flex justify-between items-center border-b border-slate-800">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-orange-500/20 border border-orange-500/30 text-orange-400 flex items-center justify-center shadow-xs">
                    <i data-lucide="pen-tool" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-white font-bold text-base leading-tight">Tulis Berita Baru</h3>
                    <p class="text-xs text-slate-300 mt-0.5">Pastikan informasi akurat dan sesuai fakta kedinasan.</p>
                </div>
            </div>
            <button type="button" onclick="closeModalTambahBerita()" class="w-8 h-8 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition-all">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <form action="/admin-diskominfo/berita/tambah" method="POST" enctype="multipart/form-data" class="flex-1 flex flex-col min-h-0 overflow-hidden">
            
            <div class="p-5 sm:p-6 space-y-4 flex-1 min-h-0 overflow-y-auto overscroll-contain">
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1.5">Judul Berita <span class="text-rose-500">*</span></label>
                    <input type="text" name="judul" required placeholder="Contoh: Diskominfo Gelar Pelatihan Digitalisasi UMKM" class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white rounded-xl px-4 py-3 text-sm focus:ring-4 focus:ring-orange-500/15 focus:border-orange-500 outline-none font-semibold transition-all placeholder:text-slate-400 dark:placeholder:text-slate-500">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1.5">Kategori Berita <span class="text-rose-500">*</span></label>
                        <select name="kategori_id" required class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white rounded-xl px-4 py-3 text-sm focus:ring-4 focus:ring-orange-500/15 focus:border-orange-500 outline-none font-medium transition-all">
                            <option value="">-- Pilih Kategori --</option>
                            <% if (typeof kategoriList !== 'undefined') { %>
                                <% kategoriList.forEach(k => { %>
                                    <option value="<%= k.id %>"><%= k.nama_kategori %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1.5">Penulis / Redaksi</label>
                        <input type="text" name="penulis" value="Redaksi Diskominfo" class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white rounded-xl px-4 py-3 text-sm focus:ring-4 focus:ring-orange-500/15 focus:border-orange-500 outline-none font-medium transition-all">
                    </div>
                </div>

                <!-- Pengunggah Foto Sampul Elegan -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1.5">Foto Sampul Artikel</label>
                    <div class="border-2 border-dashed border-slate-200 dark:border-slate-700 hover:border-orange-500 dark:hover:border-orange-500 rounded-2xl p-4 transition-all duration-200 bg-slate-50/70 dark:bg-slate-800/40 hover:bg-orange-50/20 dark:hover:bg-orange-500/10 group cursor-pointer" onclick="document.getElementById('tambahBeritaInputFile').click()">
                        <input type="file" id="tambahBeritaInputFile" name="gambar" accept="image/*" class="hidden" onchange="previewUploadImage(event, 'tambahPreviewImg', 'tambahPreviewPlaceholder', 'tambahBadgeFileBerita')">
                        <div class="flex flex-col sm:flex-row items-center gap-4">
                            <div class="relative w-32 h-24 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 overflow-hidden shadow-xs flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                                <i data-lucide="image" class="w-8 h-8 text-slate-300 dark:text-slate-500" id="tambahPreviewPlaceholder"></i>
                                <img id="tambahPreviewImg" class="w-full h-full object-cover hidden" alt="Foto Sampul">
                            </div>
                            <div class="flex-1 text-center sm:text-left">
                                <div class="flex flex-wrap items-center gap-2 justify-center sm:justify-start mb-1.5">
                                    <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 group-hover:border-orange-500 text-slate-700 dark:text-slate-200 group-hover:text-orange-600 dark:group-hover:text-orange-400 rounded-xl text-xs font-bold shadow-2xs transition-all pointer-events-none">
                                        <i data-lucide="upload-cloud" class="w-4 h-4 text-orange-500"></i> Pilih Berkas Foto
                                    </span>
                                    <span id="tambahBadgeFileBerita" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hidden truncate max-w-[200px]"></span>
                                </div>
                                <p class="text-[11px] text-slate-400 dark:text-slate-400">Klik area ini untuk memilih foto sampul. Format didukung: JPG, PNG, JPEG, WebP (Maks. 2MB).</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1.5">Isi Lengkap Berita <span class="text-rose-500">*</span></label>
                    <textarea name="konten" required rows="7" placeholder="Tuliskan paragraf berita di sini..." class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 rounded-xl px-4 py-3 text-sm focus:ring-4 focus:ring-orange-500/15 focus:border-orange-500 outline-none leading-relaxed transition-all placeholder:text-slate-400 dark:placeholder:text-slate-500"></textarea>
                </div>
            </div>

            <!-- FOOTER AKSI -->
            <div class="shrink-0 px-6 py-4 bg-slate-50 dark:bg-slate-900/95 border-t border-slate-100 dark:border-slate-800 flex justify-end gap-3">
                <button type="button" onclick="closeModalTambahBerita()" class="px-5 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-white transition-colors">Batal</button>
                <button type="submit" class="px-6 py-2.5 text-xs font-bold text-white bg-orange-500 rounded-xl hover:bg-orange-600 shadow-lg shadow-orange-500/25 flex items-center gap-2 transition-all">
                    <i data-lucide="send" class="w-4 h-4"></i> Terbitkan Berita
                </button>
            </div>

        </form>
    </div>
</div>

<!-- ========================================================= -->
<!-- 2. MODAL EDIT BERITA                                     -->
<!-- ========================================================= -->
<div id="modalEditBerita" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-slate-950/75 backdrop-blur-md transition-all duration-300 opacity-0 p-3 sm:p-4 md:p-6">
    <div class="fixed inset-0" onclick="closeModalEditBerita()"></div>
    <div id="boxEditBerita" class="relative z-10 bg-white dark:bg-slate-900 rounded-3xl w-full max-w-2xl max-h-[90vh] sm:max-h-[88vh] flex flex-col overflow-hidden shadow-2xl border border-slate-100 dark:border-slate-800 transform transition-all duration-300 scale-95 opacity-0 my-auto">
        
        <!-- HEADER (shrink-0) -->
        <div class="shrink-0 px-6 py-4 sm:py-5 bg-navy-900 text-white flex justify-between items-center border-b border-slate-800">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-blue-500/20 border border-blue-500/30 text-blue-400 flex items-center justify-center shadow-xs">
                    <i data-lucide="edit-3" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-white font-bold text-base leading-tight">Ubah Artikel Berita</h3>
                    <p class="text-xs text-slate-300 mt-0.5">Perbarui rincian artikel dan dokumentasi foto sampul.</p>
                </div>
            </div>
            <button type="button" onclick="closeModalEditBerita()" class="w-8 h-8 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition-all">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <form action="/admin-diskominfo/berita/update" method="POST" enctype="multipart/form-data" class="flex-1 flex flex-col min-h-0 overflow-hidden">
            <input type="hidden" name="id" id="editBeritaId">
            <input type="hidden" name="gambar_lama" id="editBeritaGambarLama">

            <div class="p-5 sm:p-6 space-y-4 flex-1 min-h-0 overflow-y-auto overscroll-contain">
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1.5">Judul Berita <span class="text-rose-500">*</span></label>
                    <input type="text" name="judul" id="editBeritaJudul" required class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white rounded-xl px-4 py-3 text-sm focus:ring-4 focus:ring-blue-500/15 focus:border-blue-500 outline-none font-semibold transition-all">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1.5">Kategori Berita <span class="text-rose-500">*</span></label>
                        <select name="kategori_id" id="editBeritaKategori" required class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white rounded-xl px-4 py-3 text-sm focus:ring-4 focus:ring-blue-500/15 focus:border-blue-500 outline-none font-medium transition-all">
                            <% if (typeof kategoriList !== 'undefined') { %>
                                <% kategoriList.forEach(k => { %>
                                    <option value="<%= k.id %>"><%= k.nama_kategori %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1.5">Penulis / Redaksi</label>
                        <input type="text" name="penulis" id="editBeritaPenulis" class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white rounded-xl px-4 py-3 text-sm focus:ring-4 focus:ring-blue-500/15 focus:border-blue-500 outline-none font-medium transition-all">
                    </div>
                </div>

                <!-- Pengunggah Foto Sampul Edit Elegan -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1.5">Foto Sampul Artikel</label>
                    <div class="border-2 border-dashed border-slate-200 dark:border-slate-700 hover:border-blue-500 dark:hover:border-blue-500 rounded-2xl p-4 transition-all duration-200 bg-slate-50/70 dark:bg-slate-800/40 hover:bg-blue-50/20 dark:hover:bg-blue-500/10 group cursor-pointer" onclick="document.getElementById('editBeritaInputFile').click()">
                        <input type="file" id="editBeritaInputFile" name="gambar" accept="image/*" class="hidden" onchange="previewUploadImage(event, 'editPreviewImg', 'editPreviewPlaceholder', 'editBadgeFileBerita')">
                        <div class="flex flex-col sm:flex-row items-center gap-4">
                            <div class="relative w-32 h-24 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 overflow-hidden shadow-xs flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                                <i data-lucide="image" class="w-8 h-8 text-slate-300 dark:text-slate-500" id="editPreviewPlaceholder"></i>
                                <img id="editPreviewImg" class="w-full h-full object-cover hidden" alt="Foto Sampul">
                                <span id="editBadgeFotoStatus" class="absolute bottom-1 right-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-navy-900/80 text-white backdrop-blur-xs hidden">Foto Saat Ini</span>
                            </div>
                            <div class="flex-1 text-center sm:text-left">
                                <div class="flex flex-wrap items-center gap-2 justify-center sm:justify-start mb-1.5">
                                    <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 group-hover:border-blue-500 text-slate-700 dark:text-slate-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 rounded-xl text-xs font-bold shadow-2xs transition-all pointer-events-none">
                                        <i data-lucide="upload-cloud" class="w-4 h-4 text-blue-500"></i> Ganti Foto Sampul
                                    </span>
                                    <span id="editBadgeFileBerita" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hidden truncate max-w-[200px]"></span>
                                </div>
                                <p class="text-[11px] text-slate-400 dark:text-slate-400">Klik area ini untuk memilih foto baru. Format didukung: JPG, PNG, JPEG, WebP (Maks. 2MB).</p>
                                <p class="text-[10px] text-slate-400 dark:text-slate-400 italic mt-0.5">Biarkan kosong jika tidak ingin mengubah foto yang sudah ada.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1.5">Isi Lengkap Berita <span class="text-rose-500">*</span></label>
                    <textarea name="konten" id="editBeritaKonten" required rows="7" class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 rounded-xl px-4 py-3 text-sm focus:ring-4 focus:ring-blue-500/15 focus:border-blue-500 outline-none leading-relaxed transition-all"></textarea>
                </div>
            </div>

            <!-- FOOTER AKSI -->
            <div class="shrink-0 px-6 py-4 bg-slate-50 dark:bg-slate-900/95 border-t border-slate-100 dark:border-slate-800 flex justify-end gap-3">
                <button type="button" onclick="closeModalEditBerita()" class="px-5 py-2.5 text-xs font-bold text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-white transition-colors">Batal</button>
                <button type="submit" class="px-6 py-2.5 text-xs font-bold text-white bg-blue-600 rounded-xl hover:bg-blue-700 shadow-lg shadow-blue-600/25 flex items-center gap-2 transition-all">
                    <i data-lucide="check" class="w-4 h-4"></i> Simpan Perubahan
                </button>
            </div>

        </form>
    </div>
</div>

<!-- ========================================================= -->
<!-- 3. MODAL KONFIRMASI HAPUS (CUSTOM ANIMASI SWEETALERT)    -->
<!-- ========================================================= -->
<div id="modalKonfirmasiHapus" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-slate-950/75 backdrop-blur-md p-4 transition-all duration-300 opacity-0" style="scrollbar-gutter: stable;">
    <div class="fixed inset-0" onclick="tutupModalHapus()"></div>
    <div id="boxKonfirmasiHapus" class="relative z-10 bg-white dark:bg-slate-900 rounded-3xl w-full max-w-md p-6 sm:p-8 text-center shadow-2xl border border-slate-100 dark:border-slate-800 transform transition-all scale-95 opacity-0 duration-300 my-auto">
        <!-- Ikon Peringatan Berdenyut -->
        <div class="w-16 h-16 rounded-2xl bg-rose-100 dark:bg-rose-500/20 text-rose-600 dark:text-rose-400 flex items-center justify-center mx-auto mb-4 animate-bounce">
            <i data-lucide="alert-triangle" class="w-8 h-8"></i>
        </div>
        <h3 class="text-xl font-bold text-navy-900 dark:text-white mb-2">Hapus Artikel Ini?</h3>
        <p class="text-slate-500 dark:text-slate-400 text-sm mb-6 leading-relaxed">
            Artikel <strong id="namaArtikelHapus" class="text-navy-900 dark:text-white font-bold"></strong> akan dihapus secara permanen dan tidak dapat dikembalikan.
        </p>
        <div class="flex items-center justify-center gap-3">
            <button type="button" onclick="tutupModalHapus()" class="px-5 py-2.5 rounded-xl text-xs font-bold text-slate-500 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
                Batal
            </button>
            <a id="btnEksekusiHapus" href="#" class="px-5 py-2.5 rounded-xl text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 shadow-lg shadow-rose-600/25 transition-all flex items-center gap-2">
                <i data-lucide="trash-2" class="w-4 h-4"></i> Ya, Hapus Sekarang
            </a>
        </div>
    </div>
</div>

<!-- JAVASCRIPT LOGIKA MODAL, PREVIEW, & EVENT DELEGATION -->
<script>
    // Pindahkan modal ke document.body agar tidak terperangkap di dalam tab container, sticky topbar, atau sidebar
    function teleportModalBerita(el) {
        if (el && el.parentElement !== document.body) {
            document.body.appendChild(el);
        }
    }

    // Jalankan teleportasi segera saat script diproses
    ['modalTambahBerita', 'modalEditBerita', 'modalKonfirmasiHapus'].forEach(id => {
        const el = document.getElementById(id);
        if (el) teleportModalBerita(el);
    });

    // 1. Modal Tambah dengan Animasi Halus
    function openModalTambahBerita() {
        const m = document.getElementById('modalTambahBerita');
        const box = document.getElementById('boxTambahBerita');
        if (!m || !box) return;
        teleportModalBerita(m);
        m.classList.remove('hidden');
        m.scrollTop = 0;
        document.body.classList.add('overflow-hidden');
        requestAnimationFrame(() => {
            m.classList.remove('opacity-0');
            m.classList.add('opacity-100');
            box.classList.remove('scale-95', 'opacity-0');
            box.classList.add('scale-100', 'opacity-100');
        });
        if (window.lucide) lucide.createIcons();
    }
    function closeModalTambahBerita() {
        const m = document.getElementById('modalTambahBerita');
        const box = document.getElementById('boxTambahBerita');
        if (!m || !box) return;
        box.classList.remove('scale-100', 'opacity-100');
        box.classList.add('scale-95', 'opacity-0');
        m.classList.remove('opacity-100');
        m.classList.add('opacity-0');
        document.body.classList.remove('overflow-hidden');
        setTimeout(() => {
            m.classList.add('hidden');
        }, 220);
    }

    // 2. Modal Edit dengan Animasi Halus
    function openModalEditBerita() {
        const m = document.getElementById('modalEditBerita');
        const box = document.getElementById('boxEditBerita');
        if (!m || !box) return;
        teleportModalBerita(m);
        m.classList.remove('hidden');
        m.scrollTop = 0;
        document.body.classList.add('overflow-hidden');
        requestAnimationFrame(() => {
            m.classList.remove('opacity-0');
            m.classList.add('opacity-100');
            box.classList.remove('scale-95', 'opacity-0');
            box.classList.add('scale-100', 'opacity-100');
        });
        if (window.lucide) lucide.createIcons();
    }
    function closeModalEditBerita() {
        const m = document.getElementById('modalEditBerita');
        const box = document.getElementById('boxEditBerita');
        if (!m || !box) return;
        box.classList.remove('scale-100', 'opacity-100');
        box.classList.add('scale-95', 'opacity-0');
        m.classList.remove('opacity-100');
        m.classList.add('opacity-0');
        document.body.classList.remove('overflow-hidden');
        setTimeout(() => {
            m.classList.add('hidden');
        }, 220);
    }

    // 3. Modal Konfirmasi Hapus Beranimasi Halus
    function konfirmasiHapusArtikel(id, judul) {
        document.getElementById('namaArtikelHapus').innerText = '"' + judul + '"';
        document.getElementById('btnEksekusiHapus').href = '/admin-diskominfo/berita/hapus/' + id;
        
        const m = document.getElementById('modalKonfirmasiHapus');
        const box = document.getElementById('boxKonfirmasiHapus');
        if (!m || !box) return;
        teleportModalBerita(m);
        m.classList.remove('hidden');
        m.scrollTop = 0;
        document.body.classList.add('overflow-hidden');
        requestAnimationFrame(() => {
            m.classList.remove('opacity-0');
            m.classList.add('opacity-100');
            box.classList.remove('scale-95', 'opacity-0');
            box.classList.add('scale-100', 'opacity-100');
        });
        if (window.lucide) lucide.createIcons();
    }

    function tutupModalHapus() {
        const m = document.getElementById('modalKonfirmasiHapus');
        const box = document.getElementById('boxKonfirmasiHapus');
        if (!m || !box) return;
        box.classList.remove('scale-100', 'opacity-100');
        box.classList.add('scale-95', 'opacity-0');
        m.classList.remove('opacity-100');
        m.classList.add('opacity-0');
        document.body.classList.remove('overflow-hidden');
        setTimeout(() => {
            m.classList.add('hidden');
        }, 220);
    }

    // 4. Pratinjau Gambar & Lencana Nama File
    function previewUploadImage(event, imgId, placeholderId, badgeId) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = document.getElementById(imgId);
                const placeholder = document.getElementById(placeholderId);
                if (img) {
                    img.src = e.target.result;
                    img.classList.remove('hidden');
                }
                if (placeholder) {
                    placeholder.classList.add('hidden');
                }
                if (badgeId) {
                    const badge = document.getElementById(badgeId);
                    if (badge) {
                        badge.textContent = `✓ ${file.name}`;
                        badge.classList.remove('hidden');
                    }
                }
                const badgeStatus = document.getElementById("editBadgeFotoStatus");
                if (badgeStatus) {
                    badgeStatus.textContent = "Foto Baru Dipilih";
                    badgeStatus.classList.remove('hidden');
                }
            }
            reader.readAsDataURL(file);
        }
    }

    // 5. Event Klik Edit & Hapus (Menggunakan DOM Helper, Bebas Masalah Kutip)
    document.addEventListener("click", function(e) {
        // Tombol Edit
        const btnEdit = e.target.closest(".btn-edit-berita");
        if (btnEdit) {
            const id = btnEdit.dataset.id;
            const kategori = btnEdit.dataset.kategori;
            const gambar = btnEdit.dataset.gambar;
            const judul = btnEdit.querySelector(".hidden-judul").innerText;
            const penulis = btnEdit.querySelector(".hidden-penulis").innerText;
            const konten = btnEdit.querySelector(".hidden-konten").value;

            document.getElementById("editBeritaId").value = id;
            document.getElementById("editBeritaJudul").value = judul;
            document.getElementById("editBeritaKategori").value = kategori;
            document.getElementById("editBeritaPenulis").value = penulis;
            document.getElementById("editBeritaGambarLama").value = gambar;
            document.getElementById("editBeritaKonten").value = konten;

            const badgeFile = document.getElementById("editBadgeFileBerita");
            if (badgeFile) badgeFile.classList.add("hidden");

            const img = document.getElementById("editPreviewImg");
            const placeholder = document.getElementById("editPreviewPlaceholder");
            const badgeStatus = document.getElementById("editBadgeFotoStatus");

            if (gambar && gambar.trim() !== '') {
                img.src = gambar;
                img.classList.remove("hidden");
                placeholder.classList.add("hidden");
                if (badgeStatus) {
                    badgeStatus.textContent = "Foto Saat Ini";
                    badgeStatus.classList.remove("hidden");
                }
            } else {
                img.classList.add("hidden");
                placeholder.classList.remove("hidden");
                if (badgeStatus) badgeStatus.classList.add("hidden");
            }

            openModalEditBerita();
            return;
        }

        // Tombol Hapus
        const btnHapus = e.target.closest(".btn-buka-hapus");
        if (btnHapus) {
            const id = btnHapus.dataset.id;
            const judul = btnHapus.querySelector(".hidden-judul-hapus").innerText;
            konfirmasiHapusArtikel(id, judul);
        }
    });

    if (window.lucide) {
        lucide.createIcons();
    }
</script>