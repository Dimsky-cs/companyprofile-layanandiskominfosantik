<header class="mb-8">
    <h2 class="text-2xl font-bold text-navy-900 mb-2 flex items-center gap-2.5">
        <i data-lucide="message-square-warning" class="w-7 h-7 text-red-500"></i>
        Pengelolaan Pengaduan Masyarakat
    </h2>
    <p class="text-slate-500 text-sm">Tinjau, tanggapi, dan selesaikan laporan keluhan publik dari masyarakat secara langsung.</p>
</header>

<div class="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden mb-8">
    <div class="overflow-x-auto">
        <table class="w-full min-w-[650px] text-left border-collapse text-xs">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-100 text-slate-500 uppercase tracking-wider font-bold">
                    <th class="px-6 py-4 font-bold">Data Pelapor</th>
                    <th class="px-6 py-4 font-bold">Judul Laporan & Kategori</th>
                    <th class="px-6 py-4 font-bold">Waktu Lapor</th>
                    <th class="px-6 py-4 font-bold text-center">Status</th>
                    <th class="px-6 py-4 font-bold text-right">Tindakan</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-medium">
                <% if (typeof aduanList !== 'undefined' && aduanList.length > 0) { %>
                    <% aduanList.forEach(a => { %>
                        <tr class="hover:bg-slate-50/60 transition-colors group">
                            <td class="px-6 py-4">
                                <div class="font-bold text-navy-900 text-sm mb-1"><%= a.nama_pelapor %></div>
                                <div class="text-xs font-semibold text-slate-500 flex items-center gap-1">
                                    <i data-lucide="phone" class="w-3.5 h-3.5 text-emerald-600"></i> <%= a.no_telp || '-' %>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="font-bold text-navy-900 text-sm mb-1 line-clamp-1"><%= a.judul_aduan %></div>
                                <div class="text-xs font-bold text-orange-600 dark:text-orange-400 px-2 py-0.5 bg-orange-50 dark:bg-orange-950/40 border border-orange-200/80 dark:border-orange-900/40 inline-block rounded-md"><%= a.kategori || 'Umum' %></div>
                            </td>
                            <td class="px-6 py-4 text-xs font-semibold text-slate-600 whitespace-nowrap">
                                <%= new Date(a.created_at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %> WIB
                            </td>
                            <td class="px-6 py-4 text-center whitespace-nowrap">
                                <% 
                                    let statusText = a.status || 'Menunggu';
                                    if (statusText === 'Pending' || statusText === 'Terkirim') statusText = 'Menunggu';
                                    let badgeColor = "bg-amber-100 text-amber-800 border-amber-200";
                                    let iconName = "clock";
                                    if (a.status === 'Diproses') {
                                        badgeColor = "bg-blue-100 text-blue-800 border-blue-200";
                                        iconName = "refresh-cw";
                                    } else if (a.status === 'Selesai') {
                                        badgeColor = "bg-emerald-100 text-emerald-800 border-emerald-200";
                                        iconName = "check-circle-2";
                                    } else if (a.status === 'Ditolak') {
                                        badgeColor = "bg-rose-100 text-rose-800 border-rose-200";
                                        iconName = "x-circle";
                                    }
                                %>
                                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full border text-[11px] font-bold <%= badgeColor %>">
                                    <i data-lucide="<%= iconName %>" class="w-3 h-3"></i> <%= statusText %>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right whitespace-nowrap">
                                <button onclick="openModalAduan('<%= a.id %>')" class="bg-navy-900 hover:bg-slate-800 text-white px-4 py-2 rounded-xl text-xs font-bold transition-all shadow-sm inline-flex items-center gap-1.5">
                                    <i data-lucide="edit-3" class="w-3.5 h-3.5 text-red-400"></i> Tindak Lanjuti
                                </button>
                            </td>
                        </tr>

                        <!-- MODAL TANGGAPAN PENGADUAN (RESPONSIF SEMUA PERANGKAT) -->
                        <div id="modalAduan-<%= a.id %>" class="fixed inset-0 z-[999] hidden items-center justify-center bg-slate-900/60 backdrop-blur-sm p-3 sm:p-4">
                            <div class="bg-white dark:bg-slate-900 rounded-2xl sm:rounded-3xl w-full max-w-lg max-h-[90vh] flex flex-col overflow-hidden shadow-2xl border border-slate-100 dark:border-slate-800">
                                <form action="/admin-diskominfo/pengaduan/update" method="POST" class="flex flex-col max-h-[90vh] min-h-0">
                                    <input type="hidden" name="id" value="<%= a.id %>">
                                    <div class="px-5 sm:px-6 py-4 sm:py-5 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-navy-900 text-white shrink-0">
                                        <h3 class="text-white font-bold text-sm sm:text-base flex items-center gap-2">
                                            <i data-lucide="message-square-reply" class="w-5 h-5 text-red-400"></i> Tanggapi Keluhan Masyarakat
                                        </h3>
                                        <button type="button" onclick="closeModalAduan('<%= a.id %>')" class="text-slate-400 hover:text-white p-1 rounded-lg transition-colors" title="Tutup">
                                            <i data-lucide="x" class="w-5 h-5"></i>
                                        </button>
                                    </div>
                                    <div class="p-4 sm:p-6 space-y-4 overflow-y-auto flex-1">
                                        <div class="bg-slate-50 dark:bg-slate-800/60 p-3.5 sm:p-4 rounded-2xl border border-slate-200/80 dark:border-slate-700/60">
                                            <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Laporan Keluhan Warga:</div>
                                            <p class="text-xs sm:text-sm font-semibold text-navy-900 dark:text-slate-100 leading-relaxed"><%= a.isi_aduan %></p>
                                        </div>
                                        <div>
                                            <label class="block text-xs font-bold text-navy-900 dark:text-slate-200 uppercase tracking-wider mb-1.5">Perbarui Status Penanganan <span class="text-red-500">*</span></label>
                                            <select name="status" class="w-full border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-sm font-bold focus:ring-2 focus:ring-red-500 outline-none bg-slate-50 dark:bg-slate-800 text-navy-900 dark:text-white">
                                                <option value="Menunggu" <%= (a.status === 'Pending' || a.status === 'Menunggu' || a.status === 'Terkirim') ? 'selected' : '' %>>⏳ Menunggu Penanganan</option>
                                                <option value="Diproses" <%= a.status === 'Diproses' ? 'selected' : '' %>>⚙️ Sedang Diproses Tim Teknis</option>
                                                <option value="Selesai" <%= a.status === 'Selesai' ? 'selected' : '' %>>✅ Selesai Ditindaklanjuti</option>
                                                <option value="Ditolak" <%= a.status === 'Ditolak' ? 'selected' : '' %>>❌ Ditolak / Tidak Sesuai Ketentuan</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-xs font-bold text-navy-900 dark:text-slate-200 uppercase tracking-wider mb-1.5">Tanggapan Resmi Kedinasan</label>
                                            <textarea name="tanggapan" rows="4" class="w-full border border-slate-200 dark:border-slate-700 rounded-xl p-3 text-sm focus:ring-2 focus:ring-red-500 outline-none bg-slate-50 dark:bg-slate-800 text-navy-900 dark:text-white" placeholder="Tuliskan jawaban resmi dinas atau rincian penyelesaian masalah di sini..."><%= a.tanggapan || '' %></textarea>
                                            <span class="text-[11px] text-slate-400 mt-1 block">Tanggapan ini akan dapat dibaca langsung oleh pelapor di portal pengaduan publik.</span>
                                        </div>
                                    </div>
                                    <div class="px-5 sm:px-6 py-3.5 sm:py-4 bg-slate-50 dark:bg-slate-800/50 border-t border-slate-100 dark:border-slate-800 flex justify-end gap-2.5 shrink-0">
                                        <button type="button" onclick="closeModalAduan('<%= a.id %>')" class="px-4 sm:px-5 py-2 text-xs font-bold text-slate-500 hover:text-slate-700 dark:text-slate-400 transition-colors">Batal</button>
                                        <button type="submit" class="px-4 sm:px-5 py-2 text-xs font-bold text-white bg-red-600 rounded-xl hover:bg-red-700 shadow-md shadow-red-600/25 flex items-center gap-1.5 transition-all">
                                            <i data-lucide="check" class="w-4 h-4"></i> Simpan Tanggapan
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="px-6 py-16 text-center text-slate-400">
                            <div class="inline-flex items-center justify-center w-14 h-14 bg-slate-100 rounded-2xl mb-3 text-slate-400">
                                <i data-lucide="inbox" class="w-8 h-8"></i>
                            </div>
                            <h4 class="text-base font-bold text-navy-900">Belum Ada Laporan Pengaduan</h4>
                            <p class="text-slate-500 text-xs mt-1">Saat ini belum ada pengaduan warga yang tercatat dalam sistem.</p>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>