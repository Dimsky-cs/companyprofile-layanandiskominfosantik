                    <span>Simpan Pengaturan Web</span>
                </button>
            </div>
        </div>
    </form>
</div>

<!-- JAVASCRIPT HELPER UNTUK LIVE PREVIEW -->
<script>
    function toggleMaintenanceForm(isChecked) {
        const box = document.getElementById('maintenanceDetailsBox');
        const lbl = document.getElementById('labelMaintenanceStatus');
        if (box) {
            box.classList.toggle('opacity-60', !isChecked);
        }
        if (lbl) {
            lbl.textContent = isChecked ? 'Aktif (Ditutup Sementara)' : 'Nonaktif (Website Dibuka)';
            lbl.className = 'text-xs font-bold ' + (isChecked ? 'text-amber-600 dark:text-amber-400' : 'text-slate-600 dark:text-slate-400');
        }
    }

    function previewImage(input, previewId) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = document.getElementById(previewId);
                if (img) img.src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function selectThemeColor(hex) {
        const inputHex = document.getElementById('inputWarnaPrimer');
        const picker = document.getElementById('pickerWarnaPrimer');
        const badge = document.getElementById('previewAccentBadge');

        if (inputHex) inputHex.value = hex;
        if (picker) picker.value = hex;
        if (badge) badge.style.backgroundColor = hex;
    }

    function syncColorInput(val, targetId) {
        const target = document.getElementById(targetId);
        if (target) target.value = val;
        const badge = document.getElementById('previewAccentBadge');
        if (badge && targetId === 'inputWarnaPrimer') badge.style.backgroundColor = val;
    }

    function syncColorPicker(val, targetId) {
        if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
            const target = document.getElementById(targetId);
            if (target) target.value = val;
            const badge = document.getElementById('previewAccentBadge');
            if (badge && targetId === 'pickerWarnaPrimer') badge.style.backgroundColor = val;
        }
    }

    // Inisialisasi warna awal badge pratinjau aksen sesuai pengaturan yang tersimpan
    (function initPreviewAccent() {
        const colorInput = document.getElementById('inputWarnaPrimer');
        const badge = document.getElementById('previewAccentBadge');
        if (badge && colorInput && colorInput.value) {
            badge.style.backgroundColor = colorInput.value;
        }
    })();
</script>
