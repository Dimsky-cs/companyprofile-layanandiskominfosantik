        <!-- ========================================================== -->
        <!-- ACTION BAR: TOMBOL SIMPAN PENGATURAN                       -->
        <!-- ========================================================== -->
        <div class="sticky bottom-6 z-40 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xl flex items-center justify-between gap-4">
            <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
