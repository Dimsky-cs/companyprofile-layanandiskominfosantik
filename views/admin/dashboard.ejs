                    </div>
                    <a href="?tab=aduan" data-tab="aduan" class="mt-6 flex items-center text-sm font-semibold text-rose-600 dark:text-rose-400 group-hover:translate-x-1 transition-all">
                        Tindak Lanjuti Aduan <i data-lucide="arrow-right" class="w-4 h-4 ml-1"></i>
                    </a>
                </div>

                <!-- Kotak 3: Berita (Palet Biru Langit Komunikasi Publik) -->
