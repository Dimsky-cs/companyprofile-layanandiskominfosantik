                            <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1">Alamat Surel Resmi Kedinasan</label>
                            <div class="relative">
                                <i data-lucide="mail" class="w-4 h-4 text-slate-400 dark:text-slate-500 absolute left-3 top-3"></i>
                                <input type="email" name="email" value="<%= typeof admin !== 'undefined' && admin ? admin.email : '' %>" required class="w-full pl-9 pr-4 py-2 text-sm border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl focus:ring-2 focus:ring-red-500 outline-none">
                            </div>
                        </div>
                    </div>

                    <!-- Bagian Ubah Password -->
                    <div class="pt-3 border-t border-slate-100 dark:border-slate-800">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider flex items-center gap-1.5">
                                <i data-lucide="key-round" class="w-3.5 h-3.5 text-red-600 dark:text-red-400"></i> Ubah Kata Sandi
