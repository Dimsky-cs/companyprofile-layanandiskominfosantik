                        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-orange-500 to-red-600 flex items-center justify-center text-white font-bold uppercase shadow-sm text-xs">
                            <%= typeof admin !== 'undefined' && admin ? admin.nama.charAt(0) : 'A' %>
                        </div>
                        <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-green-500 border-2 border-navy-900 rounded-full"></span>
                    </div>
                    <div class="truncate">
                        <p class="text-xs font-semibold text-white leading-none group-hover:text-orange-400 transition-colors truncate"><%= typeof admin !== 'undefined' && admin ? admin.nama : 'Administrator' %></p>
