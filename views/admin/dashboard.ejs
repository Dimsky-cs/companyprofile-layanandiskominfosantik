                <!-- Kotak 6: Satu Data Bekasi (Palet Zamrud Analitik Statistik) -->
                <div class="group admin-control-card bg-white dark:bg-slate-900 rounded-2xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-slate-100 dark:border-slate-800 flex flex-col justify-between">
