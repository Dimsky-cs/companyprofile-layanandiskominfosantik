                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 bg-amber-100 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform">
                                <i data-lucide="sliders-horizontal" class="w-6 h-6"></i>
                            </div>
                            <% if (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.is_maintenance) { %>
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 animate-pulse">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Maintenance
                                </span>
