                <div class="p-4 sm:p-6 space-y-4 overflow-y-auto flex-1 min-h-0 overscroll-contain">
                    <!-- Informasi Dasar -->
                    <div class="space-y-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1">Nama Administrator</label>
                            <div class="relative">
                                <i data-lucide="user" class="w-4 h-4 text-slate-400 dark:text-slate-500 absolute left-3 top-3"></i>
                                <input type="text" name="nama" value="<%= typeof admin !== 'undefined' && admin ? admin.nama : '' %>" required class="w-full pl-9 pr-4 py-2 text-sm border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl focus:ring-2 focus:ring-red-500 outline-none">
