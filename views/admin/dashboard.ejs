                        <i data-lucide="moon" class="w-4 h-4"></i>
                    </button>
                    <!-- Tombol Pengaturan Profil / Akun -->
                    <button type="button" onclick="openModalAdminProfile()" class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-700 transition-colors cursor-pointer" title="Pengaturan Akun & Kata Sandi">
                        <i data-lucide="settings" class="w-4 h-4"></i>
                    </button>
                    <!-- Tombol Keluar -->
                    <a href="/admin-diskominfo/logout" class="text-slate-400 hover:text-rose-400 p-1.5 rounded-lg hover:bg-slate-700 transition-colors" title="Keluar Sistem">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                    </a>
                </div>
            </div>
        </div>
    </aside>

    <!-- MAIN CONTENT (Kanan - Responsif di Layar Ponsel & Desktop) -->
    <main class="lg:ml-72 ml-0 flex-1 min-h-screen flex flex-col w-full min-w-0 relative transition-all duration-300 overflow-x-hidden">
        
        <!-- ========================================================= -->
        <!-- TOP BAR GLOBAL PERSISTEN & FREEZE (STICKY HEADER) -->
        <!-- ========================================================= -->
        <header class="admin-topbar-sticky w-full px-4 sm:px-6 lg:px-8 py-3 sm:py-3.5">
