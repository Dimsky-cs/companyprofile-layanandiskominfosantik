<%
    const currentActiveTab = (typeof activeTab !== 'undefined' && activeTab) ? activeTab : 'dashboard';
    const tabTitleMapServer = {
        'dashboard': 'Panel Utama',
        'aduan': 'Pengaduan Warga',
        'surat': 'Pelayanan Surat',
        'berita': 'Berita & Publikasi',
        'galeri': 'Galeri Multimedia',
        'profil': 'Profil & Struktur Organisasi',
        'statistik': 'Satu Data Daerah',
        'laporan': 'Pusat Laporan & Rekapitulasi',
        'pengaturan': 'Pengaturan & Identitas Web'
    };
    const currentTabTitle = tabTitleMapServer[currentActiveTab] || 'Panel Utama';
    const activeSidebarClass = "bg-gradient-to-r from-orange-500 via-orange-600 to-red-600 text-white font-semibold shadow-md shadow-orange-500/25";
    const inactiveSidebarClass = "text-slate-400 hover:bg-slate-800/80 hover:text-white";
%>
<!DOCTYPE html>
<html lang="id" class="transition-colors duration-200">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
    <title><%= typeof title !== 'undefined' ? title : 'Panel Administrator' %> - DISKOMINFOSANTIK</title>
    <!-- Favicon Icon Tab Browser -->
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Script Deteksi Mode Dark Navy Awal (Mencegah Layar Kedip) -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('adminTheme');
            if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
                document.documentElement.setAttribute('data-theme', 'dark');
            } else {
                document.documentElement.classList.remove('dark');
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: ['class', '[data-theme="dark"]'],
            theme: {
                extend: {
                    fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
                    colors: {
                        navy: {
                            600: '#254B77',
                            700: '#1B3557',
                            800: '#13253F',
                            900: '#0B1528',
                            950: '#060B15'
                        },
                        red: {
                            50: '#FEF2F2',
                            100: '#FEE2E2',
                            200: '#FECACA',
                            300: '#FCA5A5',
                            400: '#F87171',
                            500: '#EF4444',
                            600: '#DC2626',
                            700: '#B91C1C',
                            800: '#991B1B',
                            900: '#7F1D1D'
                        },
                        // Palet Oranye Asli Diskominfo Kab. Bekasi
                        orange: {
                            50: '#FFF7ED',
                            100: '#FFEDD5',
                            200: '#FED7AA',
                            300: '#FDBA74',
                            400: '#FB923C',
                            500: '#FF6B00',
                            600: '#EA580C',
                            700: '#C2410C',
                            800: '#9A3412',
                            900: '#7C2D12'
                        }
                    }
                }
            }
        }
    </script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.ckeditor.com/ckeditor5/41.2.1/classic/ckeditor.js"></script>
    <style>
        /* THEME VARIABLES SYSTEM */
        :root {
            --adm-bg: #F8FAFC;
            --adm-card: #FFFFFF;
            --adm-card-sub: #F8FAFC;
            --adm-border: #E2E8F0;
            --adm-text: #0F172A;
            --adm-text-muted: #64748B;
            --adm-red-primary: #DC2626;
            --adm-red-hover: #B91C1C;
        }

        [data-theme="dark"], .dark {
            --adm-bg: #070E1B;
            --adm-card: #0E1B33;
            --adm-card-sub: #0A1426;
            --adm-border: #1E3557;
            --adm-text: #FFFFFF;
            --adm-text-muted: #94A3B8;
            --adm-red-primary: #EF4444;
            --adm-red-hover: #DC2626;
        }

        body { 
            background-color: var(--adm-bg); 
            color: var(--adm-text);
            transition: background-color 0.2s ease, color 0.2s ease;
            overflow-x: hidden; 
        }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .dark ::-webkit-scrollbar-thumb { background: #1e3557; }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-12px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fadeInDown { animation: fadeInDown 0.35s ease-out forwards; }

        /* TOP BAR STICKY / FREEZE ON SCROLL */
        .admin-topbar-sticky {
            position: sticky;
            top: 0;
            z-index: 40;
            background-color: rgba(248, 250, 252, 0.92);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.85);
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }
        .dark .admin-topbar-sticky,
        [data-theme="dark"] .admin-topbar-sticky {
            background-color: rgba(7, 14, 27, 0.92) !important;
            border-bottom: 1px solid #14233D !important;
        }

        /* TRANSISI TAB HALUS & FLUIDA (MODERN SPA ANIMATION) */
        .admin-tab-content {
            animation: adminTabEnter 0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        @keyframes adminTabEnter {
            from {
                opacity: 0;
                transform: translateY(12px) scale(0.995);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* EFEK KARTU KENDALI ADMIN LEBIH HIDUP */
        .admin-control-card {
            transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), 
                        box-shadow 0.28s cubic-bezier(0.16, 1, 0.3, 1), 
                        border-color 0.2s ease !important;
        }
        .admin-control-card:hover {
            transform: translateY(-4px) !important;
            box-shadow: 0 12px 24px -4px rgba(0, 0, 0, 0.08) !important;
        }
        .dark .admin-control-card:hover,
        [data-theme="dark"] .admin-control-card:hover {
            box-shadow: 0 12px 24px -4px rgba(0, 0, 0, 0.45) !important;
        }

        /* ANIMASI POP-IN MODAL */
        .modal-dialog-animated {
            animation: modalPopIn 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        @keyframes modalPopIn {
            from {
                opacity: 0;
                transform: scale(0.95) translateY(12px);
            }
            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        /* PUTARAN HALUS TOMBOL TEMA */
        .theme-btn-rotate {
            transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .theme-btn-rotate:active {
            transform: rotate(180deg) scale(0.92);
        }

        /* BARIS TABEL RESPONTIF HALUS */
        tbody tr {
            transition: background-color 0.15s ease;
        }

        /* ANIMASI PROGRESS BAR NOTIFIKASI AUTO-CLEAR */
        @keyframes alertShrink {
            from { width: 100%; }
            to { width: 0%; }
        }
        .alert-progress-bar {
            animation: alertShrink 4s linear forwards;
        }

        /* DARK MODE (NAVY) COMPREHENSIVE OVERRIDES */
        .dark body {
            background-color: #070E1B !important;
            color: #F8FAFC !important;
        }
        .dark aside {
            background-color: #060C18 !important;
            border-right: 1px solid #14233D !important;
        }
        .dark main,
        [data-theme="dark"] main {
            background-color: #070E1B !important;
        }
        .dark .bg-white,
        [data-theme="dark"] .bg-white {
            background-color: #0E1B33 !important;
            color: #F8FAFC !important;
            border-color: #1E3557 !important;
        }
        .dark .bg-slate-50,
        [data-theme="dark"] .bg-slate-50 {
            background-color: #0A1426 !important;
            border-color: #1E3557 !important;
        }
        .dark .bg-slate-100,
        [data-theme="dark"] .bg-slate-100 {
            background-color: #142542 !important;
            border-color: #1E3557 !important;
            color: #F8FAFC !important;
        }
        .dark .text-navy-900, 
        .dark .text-navy-800, 
        .dark .text-slate-900, 
        .dark .text-slate-800,
        [data-theme="dark"] .text-navy-900, 
        [data-theme="dark"] .text-navy-800, 
        [data-theme="dark"] .text-slate-900, 
        [data-theme="dark"] .text-slate-800 {
            color: #FFFFFF !important;
        }
        .dark .text-slate-700, 
        .dark .text-slate-600,
        [data-theme="dark"] .text-slate-700, 
        [data-theme="dark"] .text-slate-600 {
            color: #CBD5E1 !important;
        }
        .dark .text-slate-500, 
        .dark .text-slate-400,
        [data-theme="dark"] .text-slate-500, 
        [data-theme="dark"] .text-slate-400 {
            color: #94A3B8 !important;
        }
        .dark .border-slate-100, 
        .dark .border-slate-200, 
        .dark .border-slate-200\/70,
        .dark .border-slate-200\/80,
        .dark .border-slate-200\/90, 
        .dark .border-slate-300,
        [data-theme="dark"] .border-slate-100,
        [data-theme="dark"] .border-slate-200,
        [data-theme="dark"] .border-slate-200\/70,
        [data-theme="dark"] .border-slate-200\/80,
        [data-theme="dark"] .border-slate-200\/90,
        [data-theme="dark"] .border-slate-300 {
            border-color: #1E3557 !important;
        }

        .dark .bg-slate-50\/70,
        [data-theme="dark"] .bg-slate-50\/70 {
            background-color: #0A1426 !important;
            border-color: #1E3557 !important;
        }

        .dark .hover\:text-navy-900:hover,
        [data-theme="dark"] .hover\:text-navy-900:hover {
            color: #FFFFFF !important;
        }

        /* FORM CONTROLS IN DARK MODE */
        .dark input:not([type="checkbox"]):not([type="radio"]):not([type="range"]), 
        .dark select, 
        .dark textarea,
        [data-theme="dark"] input:not([type="checkbox"]):not([type="radio"]):not([type="range"]), 
        [data-theme="dark"] select, 
        [data-theme="dark"] textarea {
            background-color: #0A1426 !important;
            color: #FFFFFF !important;
            border-color: #1E3557 !important;
        }
        .dark input:focus, 
        .dark select:focus, 
        .dark textarea:focus,
        [data-theme="dark"] input:focus, 
        [data-theme="dark"] select:focus, 
        [data-theme="dark"] textarea:focus {
            border-color: #EF4444 !important;
            box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.25) !important;
        }

        /* TABLES IN DARK MODE */
        .dark table thead tr,
        .dark table thead tr.bg-slate-50,
        [data-theme="dark"] table thead tr,
        [data-theme="dark"] table thead tr.bg-slate-50 {
            background-color: #0A1426 !important;
            border-color: #1E3557 !important;
        }
        .dark table th,
        [data-theme="dark"] table th {
            color: #94A3B8 !important;
            border-color: #1E3557 !important;
        }
        .dark table td,
        [data-theme="dark"] table td {
            color: #E2E8F0 !important;
            border-color: #1E3557 !important;
        }
        .dark table tbody tr:hover,
        [data-theme="dark"] table tbody tr:hover {
            background-color: #142542 !important;
        }

        /* MODAL STYLING IN DARK MODE */
        .dark [id^="modal"]:not(#modalPrintReport) .bg-white:not(.printable-paper-doc):not(#printableReportContent),
        .dark #modalAdminProfile .bg-white,
        [data-theme="dark"] [id^="modal"]:not(#modalPrintReport) .bg-white:not(.printable-paper-doc):not(#printableReportContent),
        [data-theme="dark"] #modalAdminProfile .bg-white {
            background-color: #0E1B33 !important;
            border-color: #1E3557 !important;
            color: #FFFFFF !important;
        }

        /* EXCEPTION UNTUK KERTAS PRATINJAU DOKUMEN CETAK RESMI (TETAP PUTIH SEPERTI KERTAS ASLI) */
        .printable-paper-doc,
        #printableReportContent,
        .dark .printable-paper-doc,
        .dark #printableReportContent,
        [data-theme="dark"] .printable-paper-doc,
        [data-theme="dark"] #printableReportContent {
            background-color: #FFFFFF !important;
            color: #0F172A !important;
            border-color: #CBD5E1 !important;
        }

        .printable-paper-doc *,
        #printableReportContent *,
        .dark .printable-paper-doc *,
        .dark #printableReportContent *,
        [data-theme="dark"] .printable-paper-doc *,
        [data-theme="dark"] #printableReportContent * {
            color: #0F172A !important;
        }

        .printable-paper-doc th,
        #printableReportContent th,
        .dark .printable-paper-doc th,
        .dark #printableReportContent th,
        [data-theme="dark"] .printable-paper-doc th,
        [data-theme="dark"] #printableReportContent th {
            background-color: #F1F5F9 !important;
            color: #0F172A !important;
            border-color: #94A3B8 !important;
        }

        .printable-paper-doc td,
        #printableReportContent td,
        .dark .printable-paper-doc td,
        .dark #printableReportContent td,
        [data-theme="dark"] .printable-paper-doc td,
        [data-theme="dark"] #printableReportContent td {
            background-color: #FFFFFF !important;
            color: #0F172A !important;
            border-color: #CBD5E1 !important;
        }

        .printable-paper-doc tr:nth-child(even) td,
        #printableReportContent tr:nth-child(even) td,
        .dark .printable-paper-doc tr:nth-child(even) td,
        .dark #printableReportContent tr:nth-child(even) td,
        [data-theme="dark"] .printable-paper-doc tr:nth-child(even) td,
        [data-theme="dark"] #printableReportContent tr:nth-child(even) td {
            background-color: #F8FAFC !important;
        }

        .printable-paper-doc .paper-summary-card,
        #printableReportContent .paper-summary-card,
        .dark .printable-paper-doc .paper-summary-card,
        .dark #printableReportContent .paper-summary-card,
        [data-theme="dark"] .printable-paper-doc .paper-summary-card,
        [data-theme="dark"] #printableReportContent .paper-summary-card {
            background-color: #F8FAFC !important;
            border-color: #CBD5E1 !important;
            color: #0F172A !important;
        }

        /* CKEditor Custom Styling & Dark Mode */
        .ck-editor__editable_inline {
            min-height: 140px;
            border-bottom-left-radius: 0.75rem !important;
            border-bottom-right-radius: 0.75rem !important;
        }
        .ck.ck-toolbar {
            border-top-left-radius: 0.75rem !important;
            border-top-right-radius: 0.75rem !important;
            background: #F8FAFC !important;
            border-color: #E2E8F0 !important;
        }
        .ck.ck-editor__main>.ck-editor__editable {
            border-color: #E2E8F0 !important;
            font-size: 0.875rem;
            color: #0F172A;
        }
        .ck.ck-editor__main>.ck-editor__editable:focus {
            border-color: #DC2626 !important;
            box-shadow: 0 0 0 2px rgba(220, 38, 38, 0.2) !important;
        }
        .dark .ck.ck-toolbar {
            background: #0A1426 !important;
            border-color: #1E3557 !important;
        }
        .dark .ck.ck-editor__main>.ck-editor__editable {
            background: #070E1B !important;
            border-color: #1E3557 !important;
            color: #FFFFFF !important;
        }
        .dark .ck .ck-button {
            color: #CBD5E1 !important;
        }
        .dark .ck .ck-button:hover {
            background: #142542 !important;
        }

        /* SOTK TREE CANVAS IN DARK MODE */
        .dark .admin-viewport {
            background: #070E1B !important;
            background-image: radial-gradient(circle at 1px 1px, rgba(30, 53, 87, 0.6) 1px, transparent 0) !important;
            border-color: #1E3557 !important;
        }
        .dark .admin-svg-connectors line {
            stroke: #38BDF8 !important;
        }
        .dark .admin-node-card {
            background: #0E1B33 !important;
            border-color: #1E3557 !important;
            color: #FFFFFF !important;
        }
        .dark .admin-node-card.node-root {
            background: linear-gradient(135deg, #070E1B 0%, #0E1B33 100%) !important;
            border-color: #EF4444 !important;
            box-shadow: 0 8px 24px rgba(239, 68, 68, 0.35) !important;
        }
        .dark .admin-node-title {
            color: #FFFFFF !important;
        }
        .dark .admin-node-person {
            color: #FCA5A5 !important;
        }

        /* SMOOTH TAB TRANSITIONS & ANIMATIONS */
        .admin-tab-content {
            animation: tabFadeIn 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            will-change: opacity, transform;
        }
        @keyframes tabFadeIn {
            0% {
                opacity: 0;
                transform: translateY(6px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ALERT PROGRESS BAR & ANIMATIONS */
        .alert-progress-bar {
            animation: alertShrink 4.5s linear forwards;
        }
        @keyframes alertShrink {
            from { width: 100%; }
            to { width: 0%; }
        }
        @keyframes alertSlideIn {
            0% {
                opacity: 0;
                transform: translateY(-12px) scale(0.98);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        .animate-alert-in {
            animation: alertSlideIn 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>
<body class="text-slate-800 antialiased font-sans flex">

    <!-- MOBILE SIDEBAR BACKDROP OVERLAY -->
    <div id="adminSidebarBackdrop" onclick="toggleMobileSidebar(false)" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-40 hidden lg:hidden transition-opacity"></div>

    <!-- SIDEBAR NAVIGASI (RESPONSIF HP: SLIDING DRAWER) -->
    <aside id="adminSidebar" class="bg-navy-900 text-white w-72 h-screen fixed left-0 top-0 flex flex-col justify-between z-50 transition-transform duration-300 ease-in-out -translate-x-full lg:translate-x-0 shadow-2xl lg:shadow-none overflow-y-auto">
        <div>
            <!-- Brand Logo & Mobile Close Button -->
            <div class="px-6 py-5 lg:py-8 border-b border-slate-700/50 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center p-1 shadow-sm">
                        <img src="<%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.logo_url) ? siteSettings.logo_url : '/images/logo.png' %>" alt="Logo" class="w-full h-full object-contain">
                    </div>
                    <div>
                        <h1 class="font-bold text-sm leading-tight text-white tracking-wide"><%= (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.nama_instansi) ? siteSettings.nama_instansi : 'DISKOMINFOSANTIK' %></h1>
                        <span class="text-[11px] font-extrabold text-orange-400 tracking-wider flex items-center gap-1.5 mt-0.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span> PANEL ADMINISTRATOR
                        </span>
                    </div>
                </div>
                <button type="button" onclick="toggleMobileSidebar(false)" class="lg:hidden p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors" title="Tutup Menu">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Nav Menu (Perpaduan Oranye Diskominfo & Nuansa Merah Admin) -->
            <nav class="p-4 space-y-1.5 mt-2">
                <a href="?tab=dashboard" data-tab="dashboard" class="sidebar-link flex items-center gap-3 px-4 py-3 <%= currentActiveTab === 'dashboard' ? activeSidebarClass : inactiveSidebarClass %> rounded-xl transition-all">
                    <i data-lucide="layout-dashboard" class="w-5 h-5"></i> Panel Utama
                </a>
                <a href="?tab=surat" data-tab="surat" class="sidebar-link flex items-center justify-between px-4 py-3 <%= currentActiveTab === 'surat' ? activeSidebarClass : inactiveSidebarClass %> rounded-xl transition-all">
                    <div class="flex items-center gap-3"><i data-lucide="mail" class="w-5 h-5 text-orange-400"></i> Pelayanan Surat</div>
                    <% if (typeof suratList !== 'undefined' && suratList.length > 0) { %>
                        <span class="bg-orange-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full"><%= suratList.length %></span>
                    <% } %>
                </a>
                <a href="?tab=aduan" data-tab="aduan" class="sidebar-link flex items-center justify-between px-4 py-3 <%= currentActiveTab === 'aduan' ? activeSidebarClass : inactiveSidebarClass %> rounded-xl transition-all">
                    <div class="flex items-center gap-3"><i data-lucide="message-square-warning" class="w-5 h-5 text-red-400"></i> Pengaduan Warga</div>
                    <% if (typeof aduanList !== 'undefined' && aduanList.length > 0) { %>
                        <span class="bg-red-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-full"><%= aduanList.length %></span>
                    <% } %>
                </a>
                <a href="?tab=berita" data-tab="berita" class="sidebar-link flex items-center gap-3 px-4 py-3 <%= currentActiveTab === 'berita' ? activeSidebarClass : inactiveSidebarClass %> rounded-xl transition-all">
                    <i data-lucide="newspaper" class="w-5 h-5"></i> Berita & Publikasi
                </a>
                <a href="?tab=galeri" data-tab="galeri" class="sidebar-link flex items-center gap-3 px-4 py-3 <%= currentActiveTab === 'galeri' ? activeSidebarClass : inactiveSidebarClass %> rounded-xl transition-all">
                    <i data-lucide="images" class="w-5 h-5"></i> Galeri Multimedia
                </a>
                <a href="?tab=profil" data-tab="profil" class="sidebar-link flex items-center gap-3 px-4 py-3 <%= currentActiveTab === 'profil' ? activeSidebarClass : inactiveSidebarClass %> rounded-xl transition-all">
                    <i data-lucide="building-2" class="w-5 h-5"></i> Profil & Struktur
                </a>
                <a href="?tab=statistik" data-tab="statistik" class="sidebar-link flex items-center gap-3 px-4 py-3 <%= currentActiveTab === 'statistik' ? activeSidebarClass : inactiveSidebarClass %> rounded-xl transition-all">
                    <i data-lucide="bar-chart-3" class="w-5 h-5"></i> Statistik Daerah
                </a>
                <a href="?tab=laporan" data-tab="laporan" class="sidebar-link flex items-center justify-between px-4 py-3 <%= currentActiveTab === 'laporan' ? activeSidebarClass : inactiveSidebarClass %> rounded-xl transition-all">
                    <div class="flex items-center gap-3"><i data-lucide="file-text" class="w-5 h-5 text-orange-400"></i> Laporan & Rekap</div>
                    <span class="bg-gradient-to-r from-orange-500/20 to-red-500/20 text-orange-300 border border-orange-500/30 text-[10px] font-bold px-2 py-0.5 rounded-full">Cetak & Rekap</span>
                </a>
                <a href="?tab=pengaturan" data-tab="pengaturan" class="sidebar-link flex items-center justify-between px-4 py-3 <%= currentActiveTab === 'pengaturan' ? activeSidebarClass : inactiveSidebarClass %> rounded-xl transition-all">
