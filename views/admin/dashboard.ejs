                        </div>

                        <div class="space-y-2.5">
                            <div>
                                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">Kata Sandi Baru</label>
                                <div class="relative">
                                    <i data-lucide="lock" class="w-4 h-4 text-slate-400 dark:text-slate-500 absolute left-3 top-3"></i>
                                    <input type="password" name="password_baru" id="inputPasswordBaru" placeholder="Minimal 6 karakter unik" class="w-full pl-9 pr-10 py-2 text-sm border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl focus:ring-2 focus:ring-red-500 outline-none">
                                    <button type="button" onclick="togglePasswordVisibility('inputPasswordBaru', this)" class="absolute right-3 top-2.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
