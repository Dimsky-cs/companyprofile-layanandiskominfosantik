                        <div class="w-12 h-12 bg-sky-100 dark:bg-sky-950/40 text-sky-600 dark:text-sky-400 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                            <i data-lucide="newspaper" class="w-6 h-6"></i>
                        </div>
                        <h3 class="font-bold text-navy-900 dark:text-white text-lg mb-1">Berita & Publikasi</h3>
                        <p class="text-slate-500 dark:text-slate-400 text-sm">Terdapat <strong class="admin-stat-counter text-sky-600 dark:text-sky-400 font-bold" data-target="<%= totalBerita %>"><%= totalBerita %></strong> artikel dan siaran pers terbit.</p>
                    </div>
                    <a href="?tab=berita" data-tab="berita" class="mt-6 flex items-center text-sm font-semibold text-sky-600 dark:text-sky-400 group-hover:translate-x-1 transition-all">
                        Kelola Berita & Publikasi <i data-lucide="arrow-right" class="w-4 h-4 ml-1"></i>
                    </a>
                </div>

                <!-- Kotak 4: Galeri (Palet Violet Dokumentasi Multimedia) -->
