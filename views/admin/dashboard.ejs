                <div class="flex items-center gap-2 sm:gap-2.5 min-w-0">
                    <button type="button" id="btnAdminMobileSidebar" onclick="toggleMobileSidebar(true)" class="lg:hidden p-2 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-800 shadow-2xs hover:bg-slate-100 dark:hover:bg-slate-800 shrink-0" title="Buka Menu Navigasi" aria-label="Buka Menu Navigasi">
                        <i data-lucide="menu" class="w-5 h-5"></i>
                    </button>
                    <span class="w-2.5 h-2.5 rounded-full bg-red-600 animate-pulse hidden sm:inline-block shrink-0"></span>
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-wider hidden sm:inline-block truncate">Portal Administrator</span>
                    <span class="text-xs text-slate-300 dark:text-slate-700 hidden sm:inline-block">/</span>
                    <span id="globalTabBadge" class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-orange-50 text-orange-700 dark:bg-orange-950/40 dark:text-orange-400 border border-orange-200/80 dark:border-orange-900/40 transition-all duration-200 truncate">
                        <%= currentTabTitle %>
                    </span>
                </div>

                <!-- Kontrol Kanan: Jam, Dark Mode Toggle, Profile, Web Publik -->
                <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
                    <% if (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.is_maintenance) { %>
                    <a href="?tab=pengaturan" class="bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1.5 rounded-xl text-xs font-extrabold flex items-center gap-1 shadow-md shadow-amber-500/25 animate-pulse" title="Mode Pemeliharaan aktif. Klik untuk kelola pengaturan.">
                        <i data-lucide="cone" class="w-3.5 h-3.5"></i>
                        <span class="hidden sm:inline">Maintenance</span>
                    </a>
                    <% } %>

                    <!-- Jam Tanggal Langsung -->
                    <div class="hidden xl:flex items-center gap-2 bg-white dark:bg-slate-900 px-3 py-1.5 rounded-xl shadow-2xs border border-slate-200 dark:border-slate-800 text-xs font-medium text-slate-700 dark:text-slate-300">
                        <i data-lucide="calendar" class="w-3.5 h-3.5 text-orange-500"></i>
                        <span id="liveClock">Memuat Tanggal...</span>
                    </div>

                    <!-- TOMBOL TOGGLE THEME: HANYA IKON BULAN & MATAHARI SAJA (TANPA LABEL) -->
                    <button type="button" id="btnThemeToggleNav" onclick="toggleAdminTheme()" class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center rounded-xl bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 shadow-2xs hover:scale-105 active:scale-95 transition-all theme-btn-rotate shrink-0" title="Ganti Mode Tampilan (Gelap / Terang)">
                        <i data-lucide="moon" class="w-4 h-4 text-slate-700 dark:text-slate-200"></i>
                    </button>

                    <!-- Tombol Buka Portal Publik -->
                    <a href="/" target="_blank" class="bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-800 px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all shadow-2xs shrink-0" title="Buka Halaman Portal Publik">
                        <i data-lucide="external-link" class="w-3.5 h-3.5 text-slate-400"></i>
                        <span class="hidden md:inline">Portal Publik</span>
                    </a>

                    <!-- Ubah Profil Administrator -->
                    <button type="button" onclick="openModalAdminProfile()" class="bg-gradient-to-r from-orange-500 to-red-600 hover:from-orange-600 hover:to-red-700 text-white px-2.5 sm:px-3.5 py-1.5 rounded-xl text-xs font-bold shadow-md shadow-orange-500/20 flex items-center gap-1.5 transition-all hover:scale-105 active:scale-95 shrink-0">
                        <i data-lucide="user-cog" class="w-3.5 h-3.5"></i>
                        <span class="hidden sm:inline">Petugas</span>
                    </button>
                </div>
            </div>
        </header>

        <!-- KONTEN UTAMA HALAMAN ADMIN (PADDED) -->
        <div class="p-3.5 sm:p-6 lg:p-8 pt-4 sm:pt-6 flex-1 w-full max-w-full overflow-x-hidden">

        <!-- ========================================================= -->
        <!-- WADAH NOTIFIKASI ALERT SISTEM (MATCHING LIGHT & DARK) -->
        <!-- ========================================================= -->
        <div id="globalAlertContainer">
        <% if (typeof successMsg !== 'undefined' && successMsg) { %>
            <div id="globalNotificationBox" class="bg-white/95 dark:bg-slate-900/90 border border-emerald-300 dark:border-emerald-500/40 text-emerald-950 dark:text-emerald-100 px-5 py-3.5 rounded-2xl mb-6 shadow-lg shadow-emerald-500/10 dark:shadow-emerald-950/50 flex items-center justify-between backdrop-blur-md animate-alert-in transition-all duration-300 relative overflow-hidden group">
                <div class="flex items-center gap-3 text-sm font-semibold">
                    <div class="w-8 h-8 rounded-xl bg-emerald-100 dark:bg-emerald-950/70 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-200 dark:border-emerald-700/60 shadow-2xs">
                        <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <span class="font-bold text-xs uppercase tracking-wider text-emerald-600 dark:text-emerald-400 block mb-0.5">Operasi Berhasil</span>
                        <span class="text-xs sm:text-sm font-medium"><%= successMsg %></span>
                    </div>
                </div>
                <button type="button" onclick="closeNotificationBox()" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-1.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" title="Tutup Notifikasi">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
                <div class="absolute bottom-0 left-0 h-1 bg-emerald-500 dark:bg-emerald-400 alert-progress-bar w-full"></div>
            </div>
        <% } %>

        <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
            <div id="globalNotificationBox" class="bg-white/95 dark:bg-slate-900/90 border border-rose-300 dark:border-rose-500/40 text-rose-950 dark:text-rose-100 px-5 py-3.5 rounded-2xl mb-6 shadow-lg shadow-rose-500/10 dark:shadow-rose-950/50 flex items-center justify-between backdrop-blur-md animate-alert-in transition-all duration-300 relative overflow-hidden group">
                <div class="flex items-center gap-3 text-sm font-semibold">
                    <div class="w-8 h-8 rounded-xl bg-rose-100 dark:bg-rose-950/70 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0 border border-rose-200 dark:border-rose-700/60 shadow-2xs">
                        <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <span class="font-bold text-xs uppercase tracking-wider text-rose-600 dark:text-rose-400 block mb-0.5">Peringatan / Gagal</span>
                        <span class="text-xs sm:text-sm font-medium"><%= errorMsg %></span>
                    </div>
                </div>
                <button type="button" onclick="closeNotificationBox()" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-1.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" title="Tutup Notifikasi">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
                <div class="absolute bottom-0 left-0 h-1 bg-rose-500 dark:bg-rose-400 alert-progress-bar w-full"></div>
            </div>
        <% } %>
        </div>

        <!-- TAB 1: PANEL UTAMA -->
        <div id="tab-dashboard" class="admin-tab-content <%= currentActiveTab === 'dashboard' ? '' : 'hidden' %>">
            <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-navy-900">Pusat Kendali Sistem</h2>
                    <p class="text-slate-500 text-sm mt-0.5">Dinas Komunikasi, Informatika, Persandian dan Statistik Kabupaten Bekasi</p>
                </div>
            </header>

            <!-- 7 KARTU PANEL KENDALI TERPADU -->
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-6">
                <% 
                   let totalSurat = typeof suratList !== 'undefined' ? suratList.length : 0;
                   let totalAduan = typeof aduanList !== 'undefined' ? aduanList.length : 0;
                   let totalBerita = typeof beritaList !== 'undefined' ? beritaList.length : 0;
                   let totalGaleri = typeof galeriList !== 'undefined' ? galeriList.length : 0;
                %>
                
                <!-- Kotak 1: Surat (Palet Oranye Hangat Khas Kedinasan) -->
                <div class="group admin-control-card bg-white dark:bg-slate-900 rounded-2xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-slate-100 dark:border-slate-800 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 bg-orange-100 dark:bg-orange-950/40 text-orange-600 dark:text-orange-400 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                            <i data-lucide="mail-open" class="w-6 h-6"></i>
                        </div>
                        <h3 class="font-bold text-navy-900 dark:text-white text-lg mb-1">Pelayanan Surat</h3>
                        <p class="text-slate-500 dark:text-slate-400 text-sm">Terdapat <strong class="admin-stat-counter text-orange-600 dark:text-orange-400 font-bold" data-target="<%= totalSurat %>"><%= totalSurat %></strong> permohonan surat masuk di sistem.</p>
                    </div>
                    <a href="?tab=surat" data-tab="surat" class="mt-6 flex items-center text-sm font-semibold text-orange-600 dark:text-orange-400 group-hover:translate-x-1 transition-all">
                        Periksa Permohonan Surat <i data-lucide="arrow-right" class="w-4 h-4 ml-1"></i>
                    </a>
                </div>

                <!-- Kotak 2: Pengaduan (Palet Mawar Merah Tanggap Warga) -->
                <div class="group admin-control-card bg-white dark:bg-slate-900 rounded-2xl p-6 shadow-sm hover:shadow-md transition-all duration-300 border border-slate-100 dark:border-slate-800 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 bg-rose-100 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                            <i data-lucide="message-square-warning" class="w-6 h-6"></i>
