            </form>
        </div>
    </div>

    <!-- Script Logika UI & Theme Mode Switcher -->
    <script>
        // 1. Initial Icon Rendering
        lucide.createIcons();

        // 2. SISTEM MANAJEMEN TEMA (NUANSA MERAH vs DARK NAVY)
        function initAdminTheme() {
            const savedTheme = localStorage.getItem('adminTheme') || 'light';
            setAdminTheme(savedTheme, false);
        }

        function setAdminTheme(theme, save = true) {
            const isDark = theme === 'dark';
            if (isDark) {
                document.documentElement.classList.add('dark');
                document.documentElement.setAttribute('data-theme', 'dark');
            } else {
                document.documentElement.classList.remove('dark');
                document.documentElement.setAttribute('data-theme', 'light');
            }
            if (save) {
                localStorage.setItem('adminTheme', theme);
            }
            updateThemeToggleUI(theme);
        }

        function toggleAdminTheme() {
            const isCurrentlyDark = document.documentElement.classList.contains('dark') || document.documentElement.getAttribute('data-theme') === 'dark';
            const newTheme = isCurrentlyDark ? 'light' : 'dark';
            setAdminTheme(newTheme, true);
        }

        function updateThemeToggleUI(theme) {
            const isDark = theme === 'dark';
            
            // 1. Topbar Toggle (Hanya ikon tanpa teks)
            const btnNav = document.getElementById('btnThemeToggleNav');
            if (btnNav) {
                btnNav.innerHTML = isDark 
                    ? '<i data-lucide="sun" class="w-4 h-4 text-amber-400"></i>'
                    : '<i data-lucide="moon" class="w-4 h-4 text-slate-700 dark:text-slate-200"></i>';
                btnNav.title = isDark ? 'Beralih ke Mode Terang' : 'Beralih ke Mode Navy (Gelap)';
            }

            // 2. Sidebar Toggle (Hanya ikon di samping tombol profil)
            const btnSidebar = document.getElementById('btnThemeToggleSidebar');
            if (btnSidebar) {
                btnSidebar.innerHTML = isDark
                    ? '<i data-lucide="sun" class="w-4 h-4 text-amber-400"></i>'
                    : '<i data-lucide="moon" class="w-4 h-4 text-slate-400"></i>';
                btnSidebar.title = isDark ? 'Beralih ke Mode Terang' : 'Beralih ke Mode Navy (Gelap)';
            }

            if (window.lucide) lucide.createIcons();
        }

        // Jalankan sinkronisasi tema UI segera
        initAdminTheme();

        // 3. Live Date Clock
        const clockEl = document.getElementById('liveClock');
        if(clockEl) {
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            clockEl.innerText = new Date().toLocaleDateString('id-ID', options);
        }

        // 4. Fungsi Tutup Notifikasi
        function closeNotificationBox() {
            const box = document.getElementById('globalNotificationBox');
            if (box) {
                box.style.opacity = '0';
                box.style.transform = 'translateY(-10px)';
                setTimeout(() => box.remove(), 300);
            }
        }

        // 5. Pemetaan Nama Tab untuk Breadcrumb Topbar
        const tabTitleMap = {
            'dashboard': 'Panel Utama',
            'aduan': 'Pengaduan Warga',
            'surat': 'Pelayanan Surat',
            'berita': 'Berita & Publikasi',
            'galeri': 'Galeri Multimedia',
            'profil': 'Profil & Struktur Organisasi',
            'statistik': 'Satu Data Daerah',
            'laporan': 'Pusat Laporan & Rekapitulasi',
            'pengaturan': 'Pengaturan & Identitas Web'
        };

        // 5.b. Helper Animasi Counter Angka Panel Kendali
        function animateAdminCounters() {
            document.querySelectorAll('.admin-stat-counter').forEach(el => {
                const target = parseInt(el.getAttribute('data-target') || el.innerText, 10);
                if (isNaN(target)) return;
                const duration = 850;
                const startTime = performance.now();
                function step(now) {
                    const progress = Math.min((now - startTime) / duration, 1);
                    const ease = 1 - Math.pow(1 - progress, 3);
                    el.innerText = Math.floor(ease * target);
                    if (progress < 1) {
                        requestAnimationFrame(step);
                    } else {
                        el.innerText = target;
                    }
                }
                requestAnimationFrame(step);
            });
        }
        window.animateAdminCounters = animateAdminCounters;

        // 5.c. Helper Buka/Tutup Sidebar di Layar HP (Mobile Offcanvas Drawer)
        function toggleMobileSidebar(open) {
            const sidebar = document.getElementById('adminSidebar');
            const backdrop = document.getElementById('adminSidebarBackdrop');
            if (!sidebar || !backdrop) return;
            
            const isClosed = sidebar.classList.contains('-translate-x-full');
            const shouldOpen = (open !== undefined) ? open : isClosed;
            
            if (shouldOpen) {
                sidebar.classList.remove('-translate-x-full');
                backdrop.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
            } else {
                sidebar.classList.add('-translate-x-full');
                backdrop.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }
            if (window.lucide) lucide.createIcons();
        }
        window.toggleMobileSidebar = toggleMobileSidebar;

        // 6. FUNGSI PERPINDAHAN TAB HALUS TANPA KEDIP & TANPA RELOAD (SPA SMOOTH TRANSITION)
        function switchAdminTab(targetTab, updateHistory = true) {
            if (!targetTab) targetTab = 'dashboard';

            // Otomatis tutup sidebar di layar HP setelah memilih tab
            if (window.innerWidth < 1024) {
                toggleMobileSidebar(false);
            }

            // Sembunyikan semua tab & tampilkan tab yang dipilih
            document.querySelectorAll(".admin-tab-content").forEach(el => {
                if (el.id === "tab-" + targetTab) {
                    el.classList.remove("hidden");
                    // Trigger reflow & re-apply animation
                    el.style.animation = 'none';
                    el.offsetHeight; /* trigger reflow */
                    el.style.animation = '';
                } else {
                    el.classList.add("hidden");
                }
            });

            // Update Breadcrumb Global Topbar
            const globalBadge = document.getElementById("globalTabBadge");
            if (globalBadge && tabTitleMap[targetTab]) {
                globalBadge.innerText = tabTitleMap[targetTab];
            }

            // Update status link sidebar seketika
            const activeClasses = ["bg-gradient-to-r", "from-orange-500", "via-orange-600", "to-red-600", "text-white", "font-semibold", "shadow-md", "shadow-orange-500/25"];
            const inactiveClasses = ["text-slate-400", "hover:bg-slate-800/80", "hover:text-white"];

            document.querySelectorAll(".sidebar-link").forEach(link => {
                const linkTab = link.getAttribute("data-tab");
                const isActive = (linkTab === targetTab);

                if (isActive) {
                    link.classList.remove(...inactiveClasses);
                    link.classList.add(...activeClasses);
                } else {
                    link.classList.remove(...activeClasses);
                    link.classList.add(...inactiveClasses);
                }
            });

            // Update hidden tab input di modal profil agar jika disimpan kembali ke tab aktif
            const tabInput = document.getElementById('profileCurrentTab');
            if (tabInput) tabInput.value = targetTab;

            // Jalankan animasi hitung angka jika membuka dashboard
            if (targetTab === 'dashboard') {
                animateAdminCounters();
            }

            // Push state ke browser history jika dipanggil dari klik user
            if (updateHistory) {
                const currentUrl = new URL(window.location.href);
                currentUrl.searchParams.set("tab", targetTab);
                // Bersihkan parameter 'success' dan 'error' saat berpindah tab
                currentUrl.searchParams.delete("success");
                currentUrl.searchParams.delete("error");
                window.history.pushState({ tab: targetTab }, "", currentUrl.toString());
            }

            // Refresh icon Lucide jika ada elemen baru yang dirender
            if (window.lucide) lucide.createIcons();

            // Pindahkan modal ke body agar tidak terpotong container tab
            if (typeof teleportAllAdminModals === 'function') teleportAllAdminModals();

            // Broadcast event untuk modul tertentu jika butuh re-render (misal grafik Chart.js atau rekap)
            window.dispatchEvent(new CustomEvent('adminTabSwitch', { detail: { tab: targetTab } }));
        }
        window.switchAdminTab = switchAdminTab;

        // Tangani navigasi tombol Back/Forward browser
        window.addEventListener('popstate', (e) => {
            const params = new URLSearchParams(window.location.search);
            const tab = params.get('tab') || 'dashboard';
            switchAdminTab(tab, false);
        });

        // 7. SISTEM ALERT UNIVERSAL (MATCHING LIGHT & DARK)
        function showAdminAlert(message, type = 'success', duration = 4000) {
            const container = document.getElementById('globalAlertContainer');
            if (!container) return;

            // Konfigurasi style matching untuk Light Mode & Dark Mode Navy
            const configs = {
                success: {
                    title: 'Operasi Berhasil',
                    icon: 'check-circle-2',
                    badgeBg: 'bg-emerald-100 dark:bg-emerald-950/70 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-700/60',
                    border: 'border-emerald-300 dark:border-emerald-500/40',
                    text: 'text-emerald-950 dark:text-emerald-100',
                    titleColor: 'text-emerald-600 dark:text-emerald-400',
                    barColor: 'bg-emerald-500 dark:bg-emerald-400',
                    shadow: 'shadow-emerald-500/10 dark:shadow-emerald-950/50'
                },
                error: {
                    title: 'Peringatan / Tindakan Gagal',
                    icon: 'alert-triangle',
                    badgeBg: 'bg-rose-100 dark:bg-rose-950/70 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-700/60',
                    border: 'border-rose-300 dark:border-rose-500/40',
                    text: 'text-rose-950 dark:text-rose-100',
                    titleColor: 'text-rose-600 dark:text-rose-400',
                    barColor: 'bg-rose-500 dark:bg-rose-400',
                    shadow: 'shadow-rose-500/10 dark:shadow-rose-950/50'
                },
                info: {
                    title: 'Informasi Sistem',
                    icon: 'info',
                    badgeBg: 'bg-blue-100 dark:bg-blue-950/70 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-700/60',
                    border: 'border-blue-300 dark:border-blue-500/40',
                    text: 'text-blue-950 dark:text-blue-100',
                    titleColor: 'text-blue-600 dark:text-blue-400',
                    barColor: 'bg-blue-500 dark:bg-blue-400',
                    shadow: 'shadow-blue-500/10 dark:shadow-blue-950/50'
                }
            };

            const cfg = configs[type] || configs.success;

            // Render alert beranimasi
            container.innerHTML = `
                <div id="globalNotificationBox" class="bg-white/95 dark:bg-slate-900/90 border ${cfg.border} ${cfg.text} px-5 py-3.5 rounded-2xl mb-6 shadow-lg ${cfg.shadow} flex items-center justify-between backdrop-blur-md animate-alert-in transition-all duration-300 relative overflow-hidden group">
                    <div class="flex items-center gap-3 text-sm font-semibold">
                        <div class="w-8 h-8 rounded-xl ${cfg.badgeBg} flex items-center justify-center shrink-0 shadow-2xs">
                            <i data-lucide="${cfg.icon}" class="w-4 h-4"></i>
                        </div>
                        <div>
                            <span class="font-bold text-xs uppercase tracking-wider ${cfg.titleColor} block mb-0.5">${cfg.title}</span>
                            <span class="text-xs sm:text-sm font-medium">${message}</span>
                        </div>
                    </div>
                    <button type="button" onclick="closeNotificationBox()" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-1.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" title="Tutup Notifikasi">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                    <div class="absolute bottom-0 left-0 h-1 ${cfg.barColor} alert-progress-bar w-full"></div>
                </div>
            `;

            if (window.lucide) lucide.createIcons();

            if (window._alertTimer) clearTimeout(window._alertTimer);
            if (duration > 0) {
                window._alertTimer = setTimeout(() => {
                    closeNotificationBox();
                }, duration);
            }
        }
        window.showAdminAlert = showAdminAlert;

        // 8. Inisialisasi DOM & Delegasi Klik Tab
        document.addEventListener("DOMContentLoaded", () => {
            const params = new URLSearchParams(window.location.search);
            const activeTab = params.get("tab") || "dashboard";

            // Inisialisasi teks badge breadcrumb jika belum diset
            const globalBadge = document.getElementById("globalTabBadge");
            if (globalBadge && tabTitleMap[activeTab]) {
                globalBadge.innerText = tabTitleMap[activeTab];
            }

            // Jalankan animasi hitung awal jika berada di tab dashboard
            if (activeTab === "dashboard") {
                animateAdminCounters();
            }

            // Delegasi klik link [data-tab] untuk transisi instan tanpa reload browser
            document.addEventListener("click", (e) => {
                const tabTarget = e.target.closest("[data-tab]");
                if (tabTarget) {
                    const tabName = tabTarget.getAttribute("data-tab");
                    if (tabName) {
                        e.preventDefault();
                        switchAdminTab(tabName, true);
                    }
                }
            });

            // Pembersihan parameter URL 'success' / 'error' setelah alert dirender oleh server
            if (params.has("success") || params.has("error")) {
                const cleanParams = new URLSearchParams();
                if (params.has("tab")) cleanParams.set("tab", params.get("tab"));
                if (params.has("subtab")) cleanParams.set("subtab", params.get("subtab"));
                const newQuery = cleanParams.toString() ? '?' + cleanParams.toString() : '';
                window.history.replaceState({ tab: activeTab }, document.title, window.location.pathname + newQuery);

                if (window._alertTimer) clearTimeout(window._alertTimer);
                window._alertTimer = setTimeout(() => {
                    closeNotificationBox();
                }, 4500);
            }
        });

        // 7. Universal Modal Teleportation & Body Lock Helper
        function safeTeleportModal(el) {
            if (el && el.parentElement !== document.body) {
                document.body.appendChild(el);
            }
        }

        function teleportAllAdminModals() {
            document.querySelectorAll('[id^="modal"]').forEach(modalEl => {
                if (modalEl && modalEl.parentElement !== document.body) {
                    document.body.appendChild(modalEl);
                }
            });
        }
        window.addEventListener('DOMContentLoaded', teleportAllAdminModals);
        setTimeout(teleportAllAdminModals, 300);

        // Helper Modal Aduan Beranimasi Pop-In
        function openModalAduan(id) {
            const modal = document.getElementById('modalAduan-' + id);
            if(modal) {
                safeTeleportModal(modal);
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.classList.add('overflow-hidden');
                const dialog = modal.querySelector('.bg-white, .relative');
                if (dialog) {
                    dialog.classList.remove('modal-dialog-animated');
                    dialog.offsetHeight;
                    dialog.classList.add('modal-dialog-animated');
                }
                if (window.lucide) lucide.createIcons();
            }
        }
        function closeModalAduan(id) {
            const modal = document.getElementById('modalAduan-' + id);
            if(modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.classList.remove('overflow-hidden');
            }
        }

        // Helper Modal Edit Profil Administrator Beranimasi Pop-In
        function openModalAdminProfile() {
            const modal = document.getElementById('modalAdminProfile');
            if(modal) {
                safeTeleportModal(modal);
                const params = new URLSearchParams(window.location.search);
                const currentTab = params.get('tab') || 'dashboard';
                const tabInput = document.getElementById('profileCurrentTab');
                if(tabInput) tabInput.value = currentTab;

                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.classList.add('overflow-hidden');
                const dialog = modal.querySelector('.bg-white, .relative');
                if (dialog) {
                    dialog.classList.remove('modal-dialog-animated');
                    dialog.offsetHeight;
                    dialog.classList.add('modal-dialog-animated');
                }
                if (window.lucide) lucide.createIcons();
            }
        }

        function closeModalAdminProfile() {
            const modal = document.getElementById('modalAdminProfile');
            if(modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.classList.remove('overflow-hidden');
            }
        }

        function togglePasswordVisibility(inputId, btnEl) {
            const input = document.getElementById(inputId);
            if(!input) return;
            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';
            btnEl.innerHTML = isPassword ? '<i data-lucide="eye-off" class="w-4 h-4"></i>' : '<i data-lucide="eye" class="w-4 h-4"></i>';
            if (window.lucide) lucide.createIcons();
        }
    </script>
    <!-- SweetAlert2 & Custom Alert Engine -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/site-alerts.js"></script>
</body>
