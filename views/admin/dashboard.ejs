                    <a href="?tab=pengaturan" data-tab="pengaturan" class="mt-6 flex items-center text-sm font-semibold text-amber-600 dark:text-amber-400 group-hover:translate-x-1 transition-all">
                        Atur Branding & Tampilan <i data-lucide="arrow-right" class="w-4 h-4 ml-1"></i>
                    </a>
