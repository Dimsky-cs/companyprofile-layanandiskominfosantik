                        <label class="block text-xs font-bold text-amber-900 dark:text-amber-300 mb-1">
                            Kata Sandi Saat Ini <span class="text-red-600 dark:text-red-400">* (Wajib)</span>
                        </label>
                        <p class="text-[11px] text-amber-700 dark:text-amber-400 mb-2">Konfirmasi kata sandi aktif untuk menyimpan perubahan.</p>
                        <div class="relative">
                            <i data-lucide="shield-check" class="w-4 h-4 text-amber-600 dark:text-amber-400 absolute left-3 top-3"></i>
                            <input type="password" name="password_lama" id="inputPasswordLama" required placeholder="Masukkan kata sandi saat ini" class="w-full pl-9 pr-10 py-2 text-sm bg-white dark:bg-slate-800 border border-amber-300 dark:border-amber-700 text-navy-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl focus:ring-2 focus:ring-red-500 outline-none">
                            <button type="button" onclick="togglePasswordVisibility('inputPasswordLama', this)" class="absolute right-3 top-2.5 text-amber-600 dark:text-amber-400 hover:text-amber-800 dark:hover:text-amber-200">
