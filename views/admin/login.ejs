<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
    <title>Masuk Portal Administrator - DISKOMINFOSANTIK Kab. Bekasi</title>
    <!-- Favicon Icon Tab Browser -->
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: radial-gradient(circle at top, #1E0E1B 0%, #070E1B 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            background: #ffffff;
            border-radius: 22px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.4), 0 0 0 1px rgba(220, 38, 38, 0.1);
            width: 100%;
            max-width: 440px;
            overflow: hidden;
        }
        .btn-red {
            background: linear-gradient(135deg, #DC2626 0%, #B91C1C 100%);
            color: #fff;
            font-weight: 600;
            border: none;
            box-shadow: 0 4px 14px rgba(220, 38, 38, 0.35);
            transition: all 0.2s ease;
        }
        .btn-red:hover {
            background: linear-gradient(135deg, #B91C1C 0%, #991B1B 100%);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(220, 38, 38, 0.45);
        }
        .form-control:focus {
            border-color: #DC2626;
            box-shadow: 0 0 0 0.25rem rgba(220, 38, 38, 0.15);
        }
    </style>
</head>
<body class="p-3">

    <div class="login-card p-4 p-md-5">
        <div class="text-center mb-4">
            <img src="/images/logo.png" alt="Logo Kab. Bekasi" height="60" class="mb-3" onerror="this.src='/images/hero-bg.png'">
            <h5 class="fw-bold mb-1" style="color: #0a2540;">Portal Administrator</h5>
            <span class="small text-muted">DISKOMINFOSANTIK Kabupaten Bekasi</span>
        </div>

        <% const err = (typeof errorMsg !== 'undefined' && errorMsg) ? errorMsg : ((typeof error !== 'undefined' && error) ? error : null); %>
        <% if (err) { %>
            <div class="alert alert-danger py-2 small mb-4 border-0 rounded-3">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= err %>
            </div>
        <% } %>

        <form action="/admin-diskominfo/login" method="POST">
            <div class="mb-3">
                <label class="form-label small fw-bold text-dark">Alamat Surel Kedinasan</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                    <input type="email" name="email" class="form-control" placeholder="admin@bekasikab.go.id" required>
                </div>
            </div>
            <div class="mb-4">
                <label class="form-label small fw-bold text-dark">Kata Sandi</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                    <input type="password" name="password" class="form-control" placeholder="••••••••" required>
                </div>
            </div>
            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-red py-2 rounded-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Masuk Sistem
                </button>
            </div>
            <div class="text-center">
                <a href="/" class="small text-muted text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Kembali ke Beranda Publik
                </a>
            </div>
        </form>
    </div>

</body>
</html>