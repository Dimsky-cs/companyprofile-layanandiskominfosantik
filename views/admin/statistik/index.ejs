<% 
    const ringkasan = (typeof statistikRingkasan !== 'undefined' && statistikRingkasan) ? statistikRingkasan : {};
    const listKecamatan = (typeof statistikKecamatan !== 'undefined' && Array.isArray(statistikKecamatan)) ? statistikKecamatan : [];
    const listPenduduk = (typeof statistikPendudukList !== 'undefined' && Array.isArray(statistikPendudukList)) ? statistikPendudukList : [];

    const usiaItems = listPenduduk.filter(p => p.kategori === 'usia');
    const pekerjaanItems = listPenduduk.filter(p => p.kategori === 'pekerjaan');
    const pendidikanItems = listPenduduk.filter(p => p.kategori === 'pendidikan');
    const sosialItems = listPenduduk.filter(p => p.kategori === 'sosial');
%>

<!-- HEADER ATAS -->
<header class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div>
        <div class="flex items-center gap-2 mb-1">
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-orange-100 text-orange-700 border border-orange-200">
                Satu Data Kependudukan
            </span>
            <span class="text-xs text-slate-400">• Open Data Kabupaten Bekasi</span>
        </div>
        <h2 class="text-2xl font-bold text-navy-900 mb-1">Statistik & Satu Data Masyarakat</h2>
        <p class="text-slate-500 text-sm">Kelola indikator makro kependudukan, demografi 23 kecamatan, dan grafik analitik daerah.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        <!-- Tombol Sinkronkan Otomatis 23 Kecamatan -->
        <form action="/admin-diskominfo/statistik/sync" method="POST" onsubmit="return confirm('Sinkronkan total penduduk, KK, luas wilayah, dan rata-rata kepadatan secara otomatis dari agregasi data 23 kecamatan?');">
            <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2.5 rounded-xl flex items-center gap-2 text-xs transition-all shadow-sm" title="Hitung otomatis total penduduk dari 23 kecamatan">
                <i data-lucide="refresh-cw" class="w-4 h-4"></i> Sinkronkan Otomatis 23 Kecamatan
            </button>
        </form>

        <a href="/statistik/export-csv" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold px-4 py-2.5 rounded-xl flex items-center gap-2 text-xs transition-all border border-slate-200 shadow-sm" download>
            <i data-lucide="download" class="w-4 h-4 text-emerald-600"></i> Unduh CSV
        </a>
        <a href="/statistik" target="_blank" class="bg-navy-900 hover:bg-slate-800 text-white font-bold px-4 py-2.5 rounded-xl flex items-center gap-2 text-xs transition-all shadow-sm">
            <i data-lucide="external-link" class="w-4 h-4 text-orange-400"></i> Portal Publik
        </a>
    </div>
</header>

<!-- TAB KONTROL ADMIN -->
<div class="flex items-center gap-2 border-b border-slate-200 dark:border-slate-800 mb-6 pb-2 overflow-x-auto whitespace-nowrap">
    <button onclick="switchStatistikSubTab('ringkasan', this)" data-subtab="ringkasan" class="btn-statistik-tab px-4 py-2 text-sm font-bold text-orange-600 dark:text-orange-400 border-b-2 border-orange-500 transition-all flex items-center gap-2">
        <i data-lucide="bar-chart-2" class="w-4 h-4"></i> Indikator Makro Daerah
    </button>
    <button onclick="switchStatistikSubTab('kecamatan', this)" data-subtab="kecamatan" class="btn-statistik-tab px-4 py-2 text-sm font-bold text-slate-500 hover:text-navy-900 dark:hover:text-white border-b-2 border-transparent transition-all flex items-center gap-2">
        <i data-lucide="map-pin" class="w-4 h-4"></i> Data Induk Kecamatan (<%= listKecamatan.length %>)
    </button>
    <button onclick="switchStatistikSubTab('grafik', this)" data-subtab="grafik" class="btn-statistik-tab px-4 py-2 text-sm font-bold text-slate-500 hover:text-navy-900 dark:hover:text-white border-b-2 border-transparent transition-all flex items-center gap-2">
        <i data-lucide="pie-chart" class="w-4 h-4"></i> Grafik Demografi & Sosial (<%= listPenduduk.length %>)
    </button>
</div>

<!-- ============================================================== -->
<!-- SUB-TAB 1: FORM INDIKATOR MAKRO KEPENDUDUKAN -->
<!-- ============================================================== -->
<div id="subtab-ringkasan" class="statistik-subtab-pane space-y-6">

    <!-- 1. QUICK STATS CARDS INDIKATOR MAKRO KEPENDUDUKAN -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Penduduk -->
        <div class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Jumlah Penduduk</span>
                <div class="w-9 h-9 bg-orange-100 text-orange-600 rounded-xl flex items-center justify-center">
                    <i data-lucide="users" class="w-5 h-5"></i>
                </div>
            </div>
            <div>
                <h3 class="text-2xl font-black text-navy-900 mb-1"><%= ringkasan.total_penduduk || '3.249.750' %> <span class="text-xs font-bold text-slate-400">Jiwa</span></h3>
                <div class="flex items-center gap-2 text-xs text-slate-500 border-t border-slate-100 pt-2.5">
                    <span class="text-blue-600 font-bold">♂ <%= ringkasan.rasio_laki || '51%' %></span>
                    <span>•</span>
                    <span class="text-pink-600 dark:text-pink-400 font-bold">♀ <%= ringkasan.rasio_perempuan || '49%' %></span>
                </div>
            </div>
        </div>

        <!-- Kepala Keluarga -->
        <div class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Kepala Keluarga (KK)</span>
                <div class="w-9 h-9 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center">
                    <i data-lucide="home" class="w-5 h-5"></i>
                </div>
            </div>
            <div>
                <h3 class="text-2xl font-black text-navy-900 mb-1"><%= ringkasan.total_kk || '992.950' %> <span class="text-xs font-bold text-slate-400">KK</span></h3>
                <div class="text-xs text-slate-500 border-t border-slate-100 pt-2.5 truncate">
                    <span><%= ringkasan.cakupan_wilayah || '23 Kecamatan • 187 Desa/Kel.' %></span>
                </div>
            </div>
        </div>

        <!-- Indeks Pembangunan Manusia (IPM) -->
        <div class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Skor IPM Daerah</span>
                <div class="w-9 h-9 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center">
                    <i data-lucide="trending-up" class="w-5 h-5"></i>
                </div>
            </div>
            <div>
                <h3 class="text-2xl font-black text-navy-900 mb-1"><%= ringkasan.skor_ipm || '75.80' %></h3>
                <div class="flex items-center gap-1.5 text-xs text-slate-500 border-t border-slate-100 pt-2.5">
                    <span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded-full font-bold text-[10px]">Predikat <%= ringkasan.predikat_ipm || 'Tinggi' %></span>
                </div>
            </div>
        </div>

        <!-- Kepadatan Wilayah -->
        <div class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Kepadatan Penduduk</span>
                <div class="w-9 h-9 bg-purple-100 text-purple-600 rounded-xl flex items-center justify-center">
                    <i data-lucide="map" class="w-5 h-5"></i>
                </div>
            </div>
            <div>
                <h3 class="text-2xl font-black text-navy-900 mb-1"><%= ringkasan.kepadatan || '2.551' %> <span class="text-xs font-bold text-slate-400">Jiwa/km²</span></h3>
                <div class="text-xs text-slate-500 border-t border-slate-100 pt-2.5 truncate">
                    <span>Luas: <%= ringkasan.luas_wilayah || '1.273,88 km²' %></span>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. FORM PENGATURAN INDIKATOR MAKRO KEPENDUDUKAN -->
    <div class="bg-white rounded-3xl border border-slate-100 p-8 shadow-sm">
        <div class="max-w-4xl">
            <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100">
                <div>
                    <h3 class="font-bold text-navy-900 text-base">Indikator Kependudukan & Sosial Agregat</h3>
                    <p class="text-xs text-slate-400 mt-0.5">Nilai yang Anda simpan di sini akan langsung tampil pada kartu metrik teratas halaman /statistik dan beranda.</p>
                </div>
                <div class="flex items-center gap-2">
                    <span class="px-3 py-1 bg-orange-50 text-orange-700 text-xs font-bold rounded-full border border-orange-200">
                        Tahun <%= ringkasan.tahun_data || '2026' %>
                    </span>
                </div>
            </div>

            <!-- BANNER CALLOUT AUTO SYNC -->
            <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-emerald-900">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0">
                        <i data-lucide="calculator" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <span class="font-bold block">Sinkronisasi Otomatis dari Database Wilayah</span>
                        <span class="text-emerald-700">Hitung total populasi, KK, dan kepadatan langsung dari penjumlahan 23 kecamatan.</span>
                    </div>
                </div>
                <form action="/admin-diskominfo/statistik/sync" method="POST" onsubmit="return confirm('Hitung ulang dan sinkronkan total makro dari 23 kecamatan?');">
                    <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-sm transition-all flex items-center gap-1.5 whitespace-nowrap">
                        <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Hitung Ulang Total
                    </button>
                </form>
            </div>

            <form action="/admin-diskominfo/statistik/ringkasan/update" method="POST" class="space-y-6">
                
                <!-- Section 1: Demografi Pokok -->
                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-orange-600 mb-3 flex items-center gap-1.5">
                        <i data-lucide="users" class="w-4 h-4"></i> 1. Kependudukan & Rumah Tangga
                    </h4>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-slate-50/70 p-5 rounded-2xl border border-slate-200/70">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Jumlah Penduduk (Jiwa)</label>
                            <input type="text" name="total_penduduk" value="<%= ringkasan.total_penduduk || '3.249.750' %>" placeholder="Contoh: 3.249.750" required class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none font-bold text-navy-900 bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Rasio Laki-laki</label>
                            <input type="text" name="rasio_laki" value="<%= ringkasan.rasio_laki || '51%' %>" placeholder="Contoh: 51%" required class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none font-medium bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Rasio Perempuan</label>
                            <input type="text" name="rasio_perempuan" value="<%= ringkasan.rasio_perempuan || '49%' %>" placeholder="Contoh: 49%" required class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none font-medium bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Jumlah Kepala Keluarga (KK)</label>
                            <input type="text" name="total_kk" value="<%= ringkasan.total_kk || '992.950' %>" placeholder="Contoh: 992.950" required class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none font-bold text-orange-600 bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Persentase Usia Produktif</label>
                            <input type="text" name="usia_produktif" value="<%= ringkasan.usia_produktif || '66.8%' %>" placeholder="Contoh: 66.8%" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Cakupan Wilayah</label>
                            <input type="text" name="cakupan_wilayah" value="<%= ringkasan.cakupan_wilayah || '23 Kecamatan • 187 Desa/Kel.' %>" placeholder="Contoh: 23 Kecamatan • 187 Desa/Kel." class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none bg-white">
                        </div>
                    </div>
                </div>

                <!-- Section 2: IPM & Geografis -->
                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-blue-600 mb-3 flex items-center gap-1.5">
                        <i data-lucide="award" class="w-4 h-4"></i> 2. Indeks Pembangunan Manusia (IPM) & Wilayah
                    </h4>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 bg-slate-50/70 p-5 rounded-2xl border border-slate-200/70">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Skor IPM</label>
                            <input type="text" name="skor_ipm" value="<%= ringkasan.skor_ipm || '75.80' %>" placeholder="Contoh: 75.80" required class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none font-bold text-navy-900 bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Predikat IPM</label>
                            <select name="predikat_ipm" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none font-semibold bg-white">
                                <option value="Sangat Tinggi" <%= (ringkasan.predikat_ipm === 'Sangat Tinggi') ? 'selected' : '' %>>Sangat Tinggi</option>
                                <option value="Tinggi" <%= (ringkasan.predikat_ipm === 'Tinggi' || !ringkasan.predikat_ipm) ? 'selected' : '' %>>Tinggi</option>
                                <option value="Sedang" <%= (ringkasan.predikat_ipm === 'Sedang') ? 'selected' : '' %>>Sedang</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Kepadatan Rata-rata</label>
                            <input type="text" name="kepadatan" value="<%= ringkasan.kepadatan || '2.551' %>" placeholder="Contoh: 2.551" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Luas Wilayah Keseluruhan</label>
                            <input type="text" name="luas_wilayah" value="<%= ringkasan.luas_wilayah || '1.273,88 km²' %>" placeholder="Contoh: 1.273,88 km²" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none bg-white">
                        </div>
                    </div>
                </div>

                <!-- Section 3: Sosial & Ketenagakerjaan -->
                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-600 mb-3 flex items-center gap-1.5">
                        <i data-lucide="heart-pulse" class="w-4 h-4"></i> 3. Kesehatan, Pendidikan & Ketenagakerjaan
                    </h4>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-slate-50/70 p-5 rounded-2xl border border-slate-200/70">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Jaminan Kesehatan (UHC Rate)</label>
                            <input type="text" name="uhc_rate" value="<%= ringkasan.uhc_rate || '99.1%' %>" placeholder="Contoh: 99.1%" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none font-bold text-emerald-600 bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Angka Melek Huruf</label>
                            <input type="text" name="melek_huruf" value="<%= ringkasan.melek_huruf || '99.2%' %>" placeholder="Contoh: 99.2%" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Tingkat Partisipasi Kerja (TPAK)</label>
                            <input type="text" name="tpak" value="<%= ringkasan.tpak || '68.5%' %>" placeholder="Contoh: 68.5%" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none bg-white">
                        </div>
                    </div>
                </div>

                <!-- Section 4: Metadata Sumber & Rilis -->
                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-600 mb-3 flex items-center gap-1.5">
                        <i data-lucide="info" class="w-4 h-4"></i> 4. Metadata & Catatan Sumber Data
                    </h4>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-slate-50/70 p-5 rounded-2xl border border-slate-200/70">
                        <div class="md:col-span-2">
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Lembaga Sumber Data</label>
                            <input type="text" name="sumber_data" value="<%= ringkasan.sumber_data || 'Disdukcapil & BPS Kabupaten Bekasi' %>" placeholder="Contoh: Disdukcapil & BPS Kabupaten Bekasi" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Tahun Rilis Data</label>
                            <input type="text" name="tahun_data" value="<%= ringkasan.tahun_data || '2026' %>" placeholder="Contoh: 2026" class="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none font-bold bg-white">
                        </div>
                    </div>
                </div>

                <!-- Tombol Simpan -->
                <div class="pt-4 flex items-center justify-end border-t border-slate-100">
                    <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white font-bold px-8 py-3 rounded-xl shadow-lg shadow-orange-500/25 transition-all text-sm flex items-center gap-2">
                        <i data-lucide="save" class="w-4 h-4"></i> Simpan Indikator Makro
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- SUB-TAB 2: MASTER DATA 23 KECAMATAN -->
<!-- ============================================================== -->
<div id="subtab-kecamatan" class="statistik-subtab-pane hidden">
    <div class="bg-white rounded-3xl border border-slate-100 p-8 shadow-sm">
        
        <!-- Header Filter & Tambah Kecamatan -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-100">
            <div>
                <h3 class="font-bold text-navy-900 text-base">Tabel Data Induk Wilayah Kecamatan (<%= listKecamatan.length %>)</h3>
                <p class="text-xs text-slate-400 mt-0.5">Kelola data camat, kependudukan, fasilitas, zona, serta koordinat peta GPS setiap kecamatan.</p>
            </div>
            
            <div class="flex flex-wrap items-center gap-3">
                <!-- Search Input -->
                <div class="relative min-w-[220px]">
                    <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="adminKecamatanSearch" placeholder="Cari nama kecamatan / camat..." class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-orange-500 outline-none">
                </div>

                <!-- Filter Zona -->
                <select id="adminZonaFilter" class="border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-700 focus:ring-2 focus:ring-orange-500 outline-none">
                    <option value="">Semua Zona</option>
                    <option value="Sangat Padat">Sangat Padat</option>
                    <option value="Padat">Padat</option>
                    <option value="Sedang">Sedang</option>
                    <option value="Berkembang">Berkembang</option>
                    <option value="Pesisir">Pesisir / Konservasi</option>
                </select>

                <!-- Tombol Tambah Kecamatan -->
                <button type="button" onclick="openModalTambahKecamatan()" class="bg-orange-500 hover:bg-orange-600 text-white font-bold px-4 py-2 rounded-xl text-xs transition-all shadow-md shadow-orange-500/25 flex items-center gap-1.5">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i> Tambah Kecamatan
                </button>
            </div>
        </div>

        <!-- Tabel Kecamatan -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="adminTabelKecamatan">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-100 text-xs text-slate-500 uppercase tracking-wider">
                        <th class="px-5 py-4 font-bold">Kecamatan</th>
                        <th class="px-5 py-4 font-bold">Nama Camat</th>
                        <th class="px-5 py-4 font-bold text-right">Penduduk</th>
                        <th class="px-5 py-4 font-bold text-right">Jumlah KK</th>
                        <th class="px-5 py-4 font-bold text-right">Luas (km²)</th>
                        <th class="px-5 py-4 font-bold text-right">Kepadatan</th>
                        <th class="px-5 py-4 font-bold text-center">Fasilitas</th>
                        <th class="px-5 py-4 font-bold text-center">Zona</th>
                        <th class="px-5 py-4 font-bold text-right">Tindakan</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    <% if (listKecamatan.length > 0) { %>
                        <% listKecamatan.forEach(k => { %>
                            <tr class="hover:bg-slate-50/80 transition-colors row-kecamatan">
                                <td class="px-5 py-4 font-bold text-navy-900 whitespace-nowrap">
                                    <%= k.nama %>
                                </td>
                                <td class="px-5 py-4 text-slate-700 whitespace-nowrap">
                                    <div class="flex items-center gap-1.5">
                                        <i data-lucide="user-check" class="w-3.5 h-3.5 text-orange-500"></i>
                                        <span class="font-medium"><%= k.camat || '—' %></span>
                                    </div>
                                </td>
                                <td class="px-5 py-4 text-right font-bold text-navy-900 whitespace-nowrap">
                                    <%= Number(k.penduduk).toLocaleString('id-ID') %>
                                </td>
                                <td class="px-5 py-4 text-right text-slate-600 whitespace-nowrap">
                                    <%= Number(k.kk).toLocaleString('id-ID') %>
                                </td>
                                <td class="px-5 py-4 text-right text-slate-600 whitespace-nowrap">
                                    <%= Number(k.luas).toLocaleString('id-ID') %>
                                </td>
                                <td class="px-5 py-4 text-right font-semibold text-slate-700 dark:text-slate-200 whitespace-nowrap">
                                    <%= Number(k.kepadatan).toLocaleString('id-ID') %>/km²
                                </td>
                                <td class="px-5 py-4 text-center whitespace-nowrap">
                                    <div class="inline-flex items-center gap-2 text-xs text-slate-600 bg-slate-100 px-2.5 py-1 rounded-lg">
                                        <span title="Puskesmas"><i data-lucide="activity" class="w-3 h-3 text-emerald-600 inline"></i> <%= k.puskesmas %></span>
                                        <span>•</span>
                                        <span title="Sekolah"><i data-lucide="graduation-cap" class="w-3 h-3 text-blue-600 inline"></i> <%= k.sekolah %></span>
                                        <span>•</span>
                                        <span title="Kantor Desa"><i data-lucide="home" class="w-3 h-3 text-amber-600 inline"></i> <%= k.kantor_desa %></span>
                                    </div>
                                </td>
                                <td class="px-5 py-4 text-center whitespace-nowrap">
                                    <% 
                                        let zonaClass = "bg-slate-100 text-slate-700 border-slate-200";
                                        if (k.zona === 'Sangat Padat') zonaClass = "bg-rose-100 text-rose-700 border-rose-200";
                                        else if (k.zona === 'Padat') zonaClass = "bg-orange-100 text-orange-700 border-orange-200";
                                        else if (k.zona === 'Sedang') zonaClass = "bg-blue-100 text-blue-700 border-blue-200";
                                        else if (k.zona === 'Berkembang') zonaClass = "bg-emerald-100 text-emerald-700 border-emerald-200";
                                        else if (k.zona && k.zona.includes('Pesisir')) zonaClass = "bg-indigo-100 text-indigo-700 border-indigo-200";
                                    %>
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold border <%= zonaClass %>">
                                        <%= k.zona %>
                                    </span>
                                </td>
                                <td class="px-5 py-4 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <button type="button" 
                                                class="btn-edit-kecamatan px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold transition-all inline-flex items-center gap-1 shadow-sm"
                                                data-id="<%= k.id %>"
                                                data-nama="<%= k.nama %>"
                                                data-camat="<%= k.camat %>"
                                                data-penduduk="<%= k.penduduk %>"
                                                data-kk="<%= k.kk %>"
                                                data-luas="<%= k.luas %>"
                                                data-kepadatan="<%= k.kepadatan %>"
                                                data-puskesmas="<%= k.puskesmas %>"
                                                data-sekolah="<%= k.sekolah %>"
                                                data-desa="<%= k.kantor_desa %>"
                                                data-zona="<%= k.zona %>"
                                                data-lat="<%= k.lat %>"
                                                data-lng="<%= k.lng %>">
                                            <i data-lucide="edit-3" class="w-3.5 h-3.5"></i> Ubah
                                        </button>
                                        <button type="button"
                                                data-id="<%= k.id %>"
                                                data-nama="<%= k.nama %>"
                                                onclick="openModalHapusKecamatan(this.dataset.id, this.dataset.nama)"
                                                class="px-2.5 py-1.5 bg-slate-100 hover:bg-rose-50 text-slate-500 hover:text-rose-600 dark:bg-slate-800 dark:hover:bg-rose-950/30 dark:text-slate-400 dark:hover:text-rose-400 border border-slate-200 dark:border-slate-700 hover:border-rose-200 rounded-xl text-xs font-bold transition-all inline-flex items-center gap-1"
                                                title="Hapus Kecamatan <%= k.nama %>">
                                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="9" class="text-center py-10 text-slate-400 text-xs">
                                Belum ada data kecamatan di database.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- SUB-TAB 3: GRAFIK DEMOGRAFI & SOSIAL (CHART.JS DATA) -->
<!-- ============================================================== -->
<div id="subtab-grafik" class="statistik-subtab-pane hidden space-y-6">
    
    <div class="bg-gradient-to-r from-navy-900 to-slate-900 text-white p-6 rounded-3xl shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-orange-500 text-white tracking-wider mb-2 inline-block">
                Grafik Analitik Dinamis
            </span>
            <h3 class="text-lg font-bold text-white mb-1">Pengaturan 4 Grafik Visual Demografi & Sosial</h3>
            <p class="text-xs text-slate-300">Setiap perubahan nilai di bawah ini langsung memperbarui tampilan grafik analitik di portal publik.</p>
        </div>
        <div class="text-xs text-slate-400">
            Jumlah <strong><%= listPenduduk.length %></strong> Indikator Terdaftar
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- CARD 1: KELOMPOK USIA -->
        <div class="bg-white rounded-3xl border border-slate-100 p-6 shadow-sm flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-xl bg-orange-50 text-orange-600 border border-orange-200 flex items-center justify-center font-bold text-xs">
                            📊
                        </div>
                        <div>
                            <h4 class="font-bold text-navy-900 text-sm">Piramida Kelompok Usia</h4>
                            <span class="text-[11px] text-slate-400">Kategori: usia (Horizontal Bar)</span>
                        </div>
                    </div>
                </div>

                <div class="space-y-2">
                    <% usiaItems.forEach(item => { %>
                        <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/70 text-xs">
                            <div>
                                <span class="font-bold text-navy-900 block"><%= item.label %></span>
                                <span class="text-[10px] text-slate-400">Tahun: <%= item.tahun %></span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="font-extrabold text-orange-600 font-mono text-sm">
                                    <%= Number(item.jumlah).toLocaleString('id-ID') %> Jiwa
                                </span>
                                <button type="button" 
                                        data-id="<%= item.id %>"
                                        data-label="<%= item.label %>"
                                        data-jumlah="<%= item.jumlah %>"
                                        data-tahun="<%= item.tahun %>"
                                        onclick="openModalEditGrafik(this.dataset.id, this.dataset.label, this.dataset.jumlah, this.dataset.tahun)"
                                        class="p-1.5 bg-white hover:bg-slate-100 text-navy-900 rounded-lg border border-slate-200 transition-all shadow-sm">
                                    <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                                </button>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>

        <!-- CARD 2: MATA PENCAHARIAN / PEKERJAAN -->
        <div class="bg-white rounded-3xl border border-slate-100 p-6 shadow-sm flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-xl bg-blue-50 text-blue-600 border border-blue-200 flex items-center justify-center font-bold text-xs">
                            🏭
                        </div>
                        <div>
                            <h4 class="font-bold text-navy-900 text-sm">Sektor Profesi & Ketenagakerjaan</h4>
                            <span class="text-[11px] text-slate-400">Kategori: pekerjaan (Bar Chart)</span>
                        </div>
                    </div>
                </div>

                <div class="space-y-2">
                    <% pekerjaanItems.forEach(item => { %>
                        <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/70 text-xs">
                            <div>
                                <span class="font-bold text-navy-900 block"><%= item.label %></span>
                                <span class="text-[10px] text-slate-400">Tahun: <%= item.tahun %></span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="font-extrabold text-navy-900 font-mono text-sm">
                                    <%= Number(item.jumlah).toLocaleString('id-ID') %>
                                </span>
                                <button type="button" 
                                        data-id="<%= item.id %>"
                                        data-label="<%= item.label %>"
                                        data-jumlah="<%= item.jumlah %>"
                                        data-tahun="<%= item.tahun %>"
                                        onclick="openModalEditGrafik(this.dataset.id, this.dataset.label, this.dataset.jumlah, this.dataset.tahun)"
                                        class="p-1.5 bg-white hover:bg-slate-100 text-navy-900 rounded-lg border border-slate-200 transition-all shadow-sm">
                                    <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                                </button>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>

        <!-- CARD 3: PENDIDIKAN TERAKHIR -->
        <div class="bg-white rounded-3xl border border-slate-100 p-6 shadow-sm flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-200 flex items-center justify-center font-bold text-xs">
                            🎓
                        </div>
                        <div>
                            <h4 class="font-bold text-navy-900 text-sm">Tingkat Pendidikan Terakhir</h4>
                            <span class="text-[11px] text-slate-400">Kategori: pendidikan (Doughnut Chart)</span>
                        </div>
                    </div>
                </div>

                <div class="space-y-2">
                    <% pendidikanItems.forEach(item => { %>
                        <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/70 text-xs">
                            <div>
                                <span class="font-bold text-navy-900 block"><%= item.label %></span>
                                <span class="text-[10px] text-slate-400">Tahun: <%= item.tahun %></span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="font-extrabold text-emerald-600 font-mono text-sm">
                                    <%= Number(item.jumlah) %>%
                                </span>
                                <button type="button" 
                                        data-id="<%= item.id %>"
                                        data-label="<%= item.label %>"
                                        data-jumlah="<%= item.jumlah %>"
                                        data-tahun="<%= item.tahun %>"
                                        onclick="openModalEditGrafik(this.dataset.id, this.dataset.label, this.dataset.jumlah, this.dataset.tahun)"
                                        class="p-1.5 bg-white hover:bg-slate-100 text-navy-900 rounded-lg border border-slate-200 transition-all shadow-sm">
                                    <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                                </button>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>

        <!-- CARD 4: KESEHATAN & BANSOS -->
        <div class="bg-white rounded-3xl border border-slate-100 p-6 shadow-sm flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-xl bg-purple-50 text-purple-600 border border-purple-200 flex items-center justify-center font-bold text-xs">
                            🏥
                        </div>
                        <div>
                            <h4 class="font-bold text-navy-900 text-sm">Kesehatan (UHC) & Bansos</h4>
                            <span class="text-[11px] text-slate-400">Kategori: sosial (Bar Chart)</span>
                        </div>
                    </div>
                </div>

                <div class="space-y-2">
                    <% sosialItems.forEach(item => { %>
                        <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/70 text-xs">
                            <div>
                                <span class="font-bold text-navy-900 block"><%= item.label %></span>
                                <span class="text-[10px] text-slate-400">Tahun: <%= item.tahun %></span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="font-extrabold text-purple-700 font-mono text-sm">
                                    <%= item.label.includes('%') ? Number(item.jumlah) + '%' : Number(item.jumlah).toLocaleString('id-ID') %>
                                </span>
                                <button type="button" 
                                        data-id="<%= item.id %>"
                                        data-label="<%= item.label %>"
                                        data-jumlah="<%= item.jumlah %>"
                                        data-tahun="<%= item.tahun %>"
                                        onclick="openModalEditGrafik(this.dataset.id, this.dataset.label, this.dataset.jumlah, this.dataset.tahun)"
                                        class="p-1.5 bg-white hover:bg-slate-100 text-navy-900 rounded-lg border border-slate-200 transition-all shadow-sm">
                                    <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                                </button>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>

    </div>
</div>

