<!-- ============================================================== -->
<!-- SCRIPT LOGIKA SUB-TAB & MODAL CMS STATISTIK -->
<!-- ============================================================== -->
<script>
    function activateStatistikSubTab(tabName) {
        if (!tabName) tabName = 'ringkasan';

        document.querySelectorAll('.btn-statistik-tab').forEach(b => {
            b.classList.remove('text-orange-600', 'border-orange-500', 'dark:text-orange-400');
            b.classList.add('text-slate-500', 'border-transparent');
            if (b.getAttribute('data-subtab') === tabName) {
                b.classList.add('text-orange-600', 'border-orange-500', 'dark:text-orange-400');
                b.classList.remove('text-slate-500', 'border-transparent');
            }
        });

        document.querySelectorAll('.statistik-subtab-pane').forEach(el => el.classList.add('hidden'));
        const target = document.getElementById('subtab-' + tabName);
        if (target) {
            target.classList.remove('hidden');
        } else {
            const fallback = document.getElementById('subtab-ringkasan');
            if (fallback) fallback.classList.remove('hidden');
        }

        localStorage.setItem('active_statistik_subtab', tabName);
    }

    function switchStatistikSubTab(tabName, btn) {
        activateStatistikSubTab(tabName);
    }

    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const subtabParam = urlParams.get('subtab');
        const savedSubtab = subtabParam || localStorage.getItem('active_statistik_subtab') || 'ringkasan';
        activateStatistikSubTab(savedSubtab);
    });

    // Pindahkan modal statistik ke document.body agar tidak terperangkap transform parent tab
    function teleportModalStatistik(el) {
        if (el && el.parentElement !== document.body) {
            document.body.appendChild(el);
        }
    }
    ['modalTambahKecamatan', 'modalEditKecamatan', 'modalHapusKecamatan', 'modalEditGrafik'].forEach(id => {
        const el = document.getElementById(id);
        if (el) teleportModalStatistik(el);
    });

    // MODAL TAMBAH KECAMATAN
    function openModalTambahKecamatan() {
        const m = document.getElementById('modalTambahKecamatan');
        if (!m) return;
        teleportModalStatistik(m);
        m.classList.remove('hidden');
        m.classList.add('flex');
        document.body.classList.add('overflow-hidden');
        if (window.lucide) lucide.createIcons();
    }
    function closeModalTambahKecamatan() {
        const m = document.getElementById('modalTambahKecamatan');
        if (!m) return;
        m.classList.add('hidden');
        m.classList.remove('flex');
        document.body.classList.remove('overflow-hidden');
    }

    // AUTO CALC KEPADATAN SAAT TAMBAH KECAMATAN
    function autoCalcKepadatanTambah() {
        const p = parseFloat(document.getElementById("tambahKecamatanPenduduk").value) || 0;
        const l = parseFloat(document.getElementById("tambahKecamatanLuas").value) || 0;
        if (l > 0) {
            const kep = Math.round(p / l);
            document.getElementById("tambahKecamatanKepadatan").value = kep;

            const zonaSelect = document.getElementById("tambahKecamatanZona");
            if (kep >= 5000) zonaSelect.value = "Sangat Padat";
            else if (kep >= 3000) zonaSelect.value = "Padat";
            else if (kep >= 1500) zonaSelect.value = "Sedang";
            else if (!zonaSelect.value.includes("Pesisir")) zonaSelect.value = "Berkembang";
        }
    }
    document.querySelectorAll(".calc-tambah").forEach(input => {
        input.addEventListener("input", autoCalcKepadatanTambah);
    });

    // MODAL EDIT KECAMATAN
    function openModalEditKecamatan() {
        const m = document.getElementById('modalEditKecamatan');
        if (!m) return;
        teleportModalStatistik(m);
        m.classList.remove('hidden');
        m.classList.add('flex');
        document.body.classList.add('overflow-hidden');
        if (window.lucide) lucide.createIcons();
    }
    function closeModalEditKecamatan() {
        const m = document.getElementById('modalEditKecamatan');
        if (!m) return;
        m.classList.add('hidden');
        m.classList.remove('flex');
        document.body.classList.remove('overflow-hidden');
    }

    document.addEventListener("click", function(e) {
        const btn = e.target.closest(".btn-edit-kecamatan");
        if (btn) {
            const d = btn.dataset;
            document.getElementById("editKecamatanId").value = d.id;
            document.getElementById("editKecamatanNama").value = d.nama;
            document.getElementById("displayKecamatanNama").value = d.nama;
            document.getElementById("modalKecamatanTitle").textContent = d.nama;
            document.getElementById("editKecamatanCamat").value = d.camat;
            document.getElementById("editKecamatanPenduduk").value = d.penduduk;
            document.getElementById("editKecamatanKK").value = d.kk;
            document.getElementById("editKecamatanLuas").value = d.luas;
            document.getElementById("editKecamatanKepadatan").value = d.kepadatan;
            document.getElementById("editKecamatanPuskesmas").value = d.puskesmas;
            document.getElementById("editKecamatanSekolah").value = d.sekolah;
            document.getElementById("editKecamatanDesa").value = d.desa;
            document.getElementById("editKecamatanZona").value = d.zona;
            document.getElementById("editKecamatanLat").value = d.lat;
            document.getElementById("editKecamatanLng").value = d.lng;

            openModalEditKecamatan();
        }
    });

    // AUTO CALC KEPADATAN SAAT EDIT KECAMATAN
    function autoCalcKepadatan() {
        const p = parseFloat(document.getElementById("editKecamatanPenduduk").value) || 0;
        const l = parseFloat(document.getElementById("editKecamatanLuas").value) || 0;
        if (l > 0) {
            const kep = Math.round(p / l);
            document.getElementById("editKecamatanKepadatan").value = kep;

            const zonaSelect = document.getElementById("editKecamatanZona");
            if (kep >= 5000) zonaSelect.value = "Sangat Padat";
            else if (kep >= 3000) zonaSelect.value = "Padat";
            else if (kep >= 1500) zonaSelect.value = "Sedang";
            else if (!zonaSelect.value.includes("Pesisir")) zonaSelect.value = "Berkembang";
        }
    }
    document.querySelectorAll(".calc-trigger").forEach(input => {
        input.addEventListener("input", autoCalcKepadatan);
    });

    // MODAL HAPUS KECAMATAN
    function openModalHapusKecamatan(id, nama) {
        document.getElementById("deleteKecamatanTitle").textContent = `Kecamatan "${nama}"`;
        document.getElementById("btnConfirmDeleteKecamatan").href = `/admin-diskominfo/statistik/kecamatan/hapus/${id}`;
        const m = document.getElementById('modalHapusKecamatan');
        if (!m) return;
        teleportModalStatistik(m);
        m.classList.remove('hidden');
        m.classList.add('flex');
        document.body.classList.add('overflow-hidden');
        if (window.lucide) lucide.createIcons();
    }
    function closeModalHapusKecamatan() {
        const m = document.getElementById('modalHapusKecamatan');
        if (!m) return;
        m.classList.add('hidden');
        m.classList.remove('flex');
        document.body.classList.remove('overflow-hidden');
    }

    // MODAL EDIT GRAFIK
    function openModalEditGrafik(id, label, jumlah, tahun) {
        document.getElementById("editGrafikId").value = id;
        document.getElementById("editGrafikLabel").value = label;
        document.getElementById("editGrafikJumlah").value = jumlah;
        document.getElementById("editGrafikTahun").value = tahun;
        const m = document.getElementById('modalEditGrafik');
        if (!m) return;
        teleportModalStatistik(m);
        m.classList.remove('hidden');
        m.classList.add('flex');
        document.body.classList.add('overflow-hidden');
        if (window.lucide) lucide.createIcons();
    }
    function closeModalEditGrafik() {
        const m = document.getElementById('modalEditGrafik');
        if (!m) return;
        m.classList.add('hidden');
        m.classList.remove('flex');
        document.body.classList.remove('overflow-hidden');
    }

    // SEARCH & FILTER TABEL KECAMATAN ADMIN
    const searchAdmin = document.getElementById('adminKecamatanSearch');
    const filterZonaAdmin = document.getElementById('adminZonaFilter');

    function filterAdminKecamatan() {
        const q = (searchAdmin.value || '').toLowerCase();
        const z = filterZonaAdmin.value;
        const rows = document.querySelectorAll('#adminTabelKecamatan tbody tr.row-kecamatan');

        rows.forEach(r => {
            const text = r.textContent.toLowerCase();
            const matchQ = text.includes(q);
            const matchZ = !z || text.includes(z.toLowerCase());
            r.style.display = (matchQ && matchZ) ? '' : 'none';
        });
    }

    if (searchAdmin) searchAdmin.addEventListener('keyup', filterAdminKecamatan);
    if (filterZonaAdmin) filterZonaAdmin.addEventListener('change', filterAdminKecamatan);

    if (window.lucide) {
        lucide.createIcons();
    }
</script>
