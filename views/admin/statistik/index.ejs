<!-- MODAL TAMBAH KECAMATAN -->
<!-- ============================================================== -->
<div id="modalTambahKecamatan" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-slate-950/75 backdrop-blur-md p-3 sm:p-4 md:p-6 transition-all duration-300">
    <div class="fixed inset-0" onclick="closeModalTambahKecamatan()"></div>
    <div class="relative z-10 bg-white dark:bg-slate-900 rounded-3xl w-full max-w-xl max-h-[90vh] sm:max-h-[88vh] flex flex-col overflow-hidden shadow-2xl border border-slate-100 dark:border-slate-800 my-auto">
        
        <div class="shrink-0 px-6 py-4 sm:py-5 bg-navy-900 text-white flex items-center justify-between border-b border-slate-800">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-orange-500 inline-block"></span>
                <h3 class="text-base font-bold text-white leading-none">Tambah Wilayah Kecamatan Baru</h3>
            </div>
            <button type="button" onclick="closeModalTambahKecamatan()" class="w-8 h-8 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition-all">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <form action="/admin-diskominfo/statistik/kecamatan/tambah" method="POST" class="flex-1 flex flex-col min-h-0 overflow-hidden">
            <div class="p-5 sm:p-6 space-y-4 flex-1 min-h-0 overflow-y-auto overscroll-contain">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1.5">Nama Kecamatan</label>
                        <input type="text" name="nama" required placeholder="Contoh: Cikarang Selatan" class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none font-bold placeholder:text-slate-400 dark:placeholder:text-slate-500">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1.5">Nama Camat</label>
                        <input type="text" name="camat" placeholder="Contoh: Drs. H. Ahmad Fauzi" class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none font-medium placeholder:text-slate-400 dark:placeholder:text-slate-500">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 bg-slate-50 dark:bg-slate-800/50 p-4 rounded-2xl border border-slate-200/70 dark:border-slate-700">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 mb-1">Jumlah Warga (Jiwa)</label>
                        <input type="number" id="tambahKecamatanPenduduk" name="penduduk" required min="0" value="0" class="calc-tambah w-full border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 outline-none font-bold bg-white dark:bg-slate-800 text-navy-900 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 mb-1">Kepala Keluarga (KK)</label>
                        <input type="number" name="kk" required min="0" value="0" class="w-full border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 outline-none bg-white dark:bg-slate-800 text-navy-900 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 mb-1">Luas Wilayah (km²)</label>
                        <input type="number" step="0.01" id="tambahKecamatanLuas" name="luas" required min="0.01" value="10.00" class="calc-tambah w-full border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 outline-none bg-white dark:bg-slate-800 text-navy-900 dark:text-white">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider">Kepadatan (Jiwa/km²)</label>
                            <span class="text-[11px] text-slate-400 font-semibold">(Otomatis Terhitung)</span>
                        </div>
                        <input type="number" id="tambahKecamatanKepadatan" name="kepadatan" readonly value="0" class="w-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-800 dark:text-slate-100">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1.5">Klasifikasi Zona</label>
                        <select id="tambahKecamatanZona" name="zona" class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-orange-500 outline-none font-bold">
                            <option value="Sangat Padat">Sangat Padat (≥ 5.000)</option>
                            <option value="Padat">Padat (3.000 - 4.999)</option>
                            <option value="Sedang" selected>Sedang (1.500 - 2.999)</option>
                            <option value="Berkembang">Berkembang (< 1.500)</option>
                            <option value="Pesisir / Konservasi">Pesisir / Konservasi</option>
                        </select>
                    </div>
                </div>

                <!-- Fasilitas Publik -->
                <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-200/70 dark:border-slate-700">
                    <span class="block text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-2.5">Jumlah Fasilitas Layanan Publik</span>
                    <div class="grid grid-cols-3 gap-3">
                        <div>
                            <label class="block text-[11px] text-slate-500 dark:text-slate-400 mb-1">Puskesmas / Faskes</label>
                            <input type="number" name="puskesmas" min="0" value="1" class="w-full border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 outline-none bg-white dark:bg-slate-800 text-navy-900 dark:text-white">
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-500 dark:text-slate-400 mb-1">Gedung Sekolah</label>
                            <input type="number" name="sekolah" min="0" value="20" class="w-full border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 outline-none bg-white dark:bg-slate-800 text-navy-900 dark:text-white">
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-500 dark:text-slate-400 mb-1">Kantor Desa / Kel.</label>
                            <input type="number" name="kantor_desa" min="0" value="7" class="w-full border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-orange-500 outline-none bg-white dark:bg-slate-800 text-navy-900 dark:text-white">
                        </div>
                    </div>
                </div>

                <!-- Titik Peta GIS -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 mb-1">Koordinat Latitude (Peta)</label>
                        <input type="number" step="0.000001" name="lat" value="-6.280000" placeholder="-6.xxxx" class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-orange-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 mb-1">Koordinat Longitude (Peta)</label>
                        <input type="number" step="0.000001" name="lng" value="107.150000" placeholder="107.xxxx" class="w-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-navy-900 dark:text-white rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-orange-500 outline-none">
                    </div>
                </div>
            </div>

