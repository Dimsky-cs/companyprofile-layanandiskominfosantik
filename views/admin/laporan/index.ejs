<!-- SCRIPT PENGENDALI MODUL LAPORAN & EKSPOR EXCEL/CSV -->
<script>
    // 1. Toggle Export Dropdown
    function toggleExportMenu() {
        const menu = document.getElementById('exportMenu');
        if (menu) menu.classList.toggle('hidden');
    }

    document.addEventListener('click', (e) => {
        const wrap = document.getElementById('exportDropdownWrap');
        const menu = document.getElementById('exportMenu');
        if (wrap && menu && !wrap.contains(e.target)) {
            menu.classList.add('hidden');
        }
    });

    // 2. Filter Dinamis Tabel Laporan
    function applyReportFilter() {
        const filterTipe = document.getElementById('reportFilterTipe').value;
        const filterStatus = document.getElementById('reportFilterStatus').value;
        const startDate = document.getElementById('reportFilterStartDate').value;
        const endDate = document.getElementById('reportFilterEndDate').value;
        const searchQuery = (document.getElementById('reportSearchInput').value || '').toLowerCase().trim();

        const rows = document.querySelectorAll('.report-row');
        let visibleCount = 0;

        rows.forEach(row => {
            const tipe = row.getAttribute('data-tipe');
            const status = row.getAttribute('data-status');
            const rowDateStr = row.getAttribute('data-date');
            const searchData = row.getAttribute('data-search') || '';

            let matchTipe = (filterTipe === 'ALL' || tipe === filterTipe);
            let matchStatus = (filterStatus === 'ALL' || status.toLowerCase() === filterStatus.toLowerCase());
            let matchSearch = (!searchQuery || searchData.includes(searchQuery));
            let matchDate = true;

            if (startDate || endDate) {
                const rowDate = new Date(rowDateStr);
                if (startDate) {
                    const start = new Date(startDate);
                    start.setHours(0, 0, 0, 0);
                    if (rowDate < start) matchDate = false;
                }
                if (endDate) {
                    const end = new Date(endDate);
                    end.setHours(23, 59, 59, 999);
                    if (rowDate > end) matchDate = false;
                }
            }

            if (matchTipe && matchStatus && matchSearch && matchDate) {
                row.classList.remove('hidden');
                visibleCount++;
            } else {
                row.classList.add('hidden');
            }
        });

        const countEl = document.getElementById('reportRowCount');
        if (countEl) countEl.textContent = `${visibleCount} Data`;
    }

    function resetReportFilter() {
        document.getElementById('reportFilterTipe').value = 'ALL';
        document.getElementById('reportFilterStatus').value = 'ALL';
        document.getElementById('reportFilterStartDate').value = '';
        document.getElementById('reportFilterEndDate').value = '';
        document.getElementById('reportSearchInput').value = '';
        applyReportFilter();
    }

    // 3. Modal Pratinjau Cetak & Tutup (Keyboard Escape Support)
    function openPrintReportModal() {
        const modal = document.getElementById('modalPrintReport');
        if (modal) {
            if (modal.parentElement !== document.body) {
                document.body.appendChild(modal);
            }
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.classList.add('overflow-hidden');
            if (window.lucide) lucide.createIcons();

            // Selalu kembalikan scroll ke titik 0 paling atas (Kop Surat) saat dibuka
            const scrollContainer = modal.querySelector('main');
            if (scrollContainer) scrollContainer.scrollTop = 0;

            // Set nomor acak berkas jika belum terisi
            const randEl = document.getElementById('reportPrintRandom');
            if (randEl && !randEl.getAttribute('data-seeded')) {
                const pad = (num, size) => ('0000' + num).substr(-size);
                randEl.textContent = pad(Math.floor(Math.random() * 9000) + 1000, 4);
                randEl.setAttribute('data-seeded', 'true');
            }
        }
    }

    function closePrintReportModal() {
        const modal = document.getElementById('modalPrintReport');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.classList.remove('overflow-hidden');
        }
    }

    function printOfficialReportPDF() {
        window.print();
    }

    // Listener tombol Esc keyboard
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' || e.key === 'Esc') {
            const modal = document.getElementById('modalPrintReport');
            if (modal && !modal.classList.contains('hidden')) {
                closePrintReportModal();
            }
        }
    });

    // 4. EKSPOR LEMBAR KERJA EXCEL RESMI (.XLS) BER-KOP SURAT & ANTI NOTASI ILMIAH
    function exportReportToExcel(targetTipe) {
        const allRows = document.querySelectorAll('.report-row');
        let items = [];
        let counter = 1;

        allRows.forEach(row => {
            const tipe = row.getAttribute('data-tipe');
            if (targetTipe === 'SEMUA' || tipe === targetTipe) {
                const cols = row.querySelectorAll('td');
                const kode = row.getAttribute('data-kode') || (cols[2] ? cols[2].innerText.trim() : '-');
                const nama = row.getAttribute('data-nama') || (cols[3] ? cols[3].innerText.trim() : '-');
                const nik = row.getAttribute('data-nik') || '-';
                const kontak = row.getAttribute('data-kontak') || '-';
                const perihal = row.getAttribute('data-perihal') || (cols[5] ? cols[5].innerText.trim() : '-');
                const tanggal = row.getAttribute('data-tanggal') || (cols[6] ? cols[6].innerText.trim().replace(/\n/g, ' ') : '-');
                const status = row.getAttribute('data-status') || (cols[7] ? cols[7].innerText.trim() : '-');

                items.push({
                    no: counter++,
                    tipe: tipe,
                    kode: kode,
                    nama: nama,
                    nik: nik,
                    kontak: kontak,
                    perihal: perihal,
                    tanggal: tanggal,
                    status: status
                });
            }
        });

        if (items.length === 0) {
            if (typeof showAdminAlert === 'function') {
                showAdminAlert('Tidak ada data yang dapat diekspor pada filter ini.', 'error');
            } else {
                alert('Tidak ada data yang dapat diekspor.');
            }
            return;
        }

        // Statistik Ringkasan untuk Header Excel
        const countTotal = items.length;
        const countSurat = items.filter(i => i.tipe === 'SURAT').length;
        const countAduan = items.filter(i => i.tipe === 'ADUAN').length;
        const countSelesai = items.filter(i => i.status === 'Disetujui' || i.status === 'Selesai').length;
        const percentSelesai = countTotal > 0 ? Math.round((countSelesai / countTotal) * 100) : 0;

        const todayStr = new Date().toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        const todaySimple = new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

        let rowsHtml = '';
        items.forEach((item, idx) => {
