    // 5. Ekspor Format CSV Data Mentah
    function exportReportToCSV(targetTipe) {
        let rowsData = [];
        
        // Header Kolom CSV
        rowsData.push([
            "No",
            "Tipe Layanan",
            "Nomor Registrasi / Tiket",
            "Nama Pemohon / Pelapor",
            "NIK",
            "No Kontak",
            "Perihal / Keperluan",
            "Tanggal Masuk",
            "Status Akhir"
        ]);

        const allRows = document.querySelectorAll('.report-row');
        let counter = 1;

        allRows.forEach(row => {
            const tipe = row.getAttribute('data-tipe');
            if (targetTipe === 'SEMUA' || tipe === targetTipe) {
                const cols = row.querySelectorAll('td');
                if (cols.length >= 8) {
                    const kode = cols[2].innerText.trim();
                    const nama = cols[3].innerText.trim();
                    const nik = cols[4].querySelector('span') ? cols[4].querySelector('span').innerText.trim() : '-';
                    const kontak = cols[4].querySelectorAll('span')[1] ? cols[4].querySelectorAll('span')[1].innerText.trim() : '-';
                    const perihal = cols[5].innerText.trim();
                    const tanggal = cols[6].innerText.trim().replace(/\n/g, ' ');
                    const status = cols[7].innerText.trim();

                    // Prefix tab (\t) pada NIK & Kontak agar saat dibuka di Excel tidak dikonversi ke notasi ilmiah
                    rowsData.push([
                        counter++,
                        tipe,
                        `"${kode}"`,
                        `"${nama}"`,
                        `"\t${nik}"`,
                        `"\t${kontak}"`,
                        `"${perihal.replace(/"/g, '""')}"`,
                        `"${tanggal}"`,
                        `"${status}"`
                    ]);
                }
            }
        });

        if (rowsData.length <= 1) {
            if (typeof showAdminAlert === 'function') {
                showAdminAlert('Tidak ada data yang dapat diekspor pada filter ini.', 'error');
            } else {
                alert('Tidak ada data yang dapat diekspor.');
            }
            return;
        }

        const csvContent = "data:text/csv;charset=utf-8,\uFEFF" + rowsData.map(e => e.join(",")).join("\n");
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        const dateStr = new Date().toISOString().slice(0, 10);
        link.setAttribute("download", `Laporan_Rekapitulasi_Diskominfo_${targetTipe}_${dateStr}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        const menu = document.getElementById('exportMenu');
        if (menu) menu.classList.add('hidden');

        if (typeof showAdminAlert === 'function') {
            showAdminAlert('Berkas rekapitulasi format CSV berhasil diunduh ke perangkat Anda.', 'success');
        }
    }
</script>
