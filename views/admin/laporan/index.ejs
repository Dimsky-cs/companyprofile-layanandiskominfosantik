<% 
    const listSurat = (typeof suratList !== 'undefined' && Array.isArray(suratList)) ? suratList : [];
    const listAduan = (typeof aduanList !== 'undefined' && Array.isArray(aduanList)) ? aduanList : [];
    const instansiInfo = (typeof profil !== 'undefined' && profil) ? profil : {};

    // Agregasi Statistik Surat
    const totalSurat = listSurat.length;
    const suratDisetujui = listSurat.filter(s => s.status === 'Disetujui').length;
    const suratDiproses = listSurat.filter(s => s.status === 'Diproses').length;
    const suratMenunggu = listSurat.filter(s => s.status === 'Menunggu').length;
    const suratDitolak = listSurat.filter(s => s.status === 'Ditolak').length;
    const rateSuratDisetujui = totalSurat > 0 ? Math.round((suratDisetujui / totalSurat) * 100) : 0;

    // Agregasi Statistik Aduan
    const totalAduan = listAduan.length;
    const aduanSelesai = listAduan.filter(a => a.status === 'Selesai').length;
    const aduanDiproses = listAduan.filter(a => a.status === 'Diproses').length;
    const aduanTerkirim = listAduan.filter(a => a.status === 'Terkirim').length;
    const aduanDitolak = listAduan.filter(a => a.status === 'Ditolak').length;
    const rateAduanSelesai = totalAduan > 0 ? Math.round((aduanSelesai / totalAduan) * 100) : 0;

    // Agregasi Total Gabungan & SPBE Ketuntasan
    const totalGabungan = totalSurat + totalAduan;
    const totalTuntas = suratDisetujui + aduanSelesai;
    const overallSuccessRate = totalGabungan > 0 ? Math.round((totalTuntas / totalGabungan) * 100) : 0;

    // Gabungan Semua Transaksi untuk Rekap
    const allRecords = [
        ...listSurat.map(s => ({
            tipe: 'SURAT',
            kode: s.nomor_surat,
            nama: s.nama_pemohon,
            nik: s.nik,
            kontak: s.no_hp,
            perihal: s.jenis_surat + ' (' + (s.keperluan ? s.keperluan.substring(0, 50) + '...' : '-') + ')',
            status: s.status,
            tanggal: new Date(s.created_at),
            rawDate: s.created_at
        })),
        ...listAduan.map(a => ({
            tipe: 'ADUAN',
            kode: a.kode_tiket,
            nama: a.nama_pelapor,
            nik: a.nik_pelapor,
            kontak: a.no_telp,
            perihal: '[' + a.kategori_aduan + '] ' + a.judul_aduan,
            status: a.status,
            tanggal: new Date(a.created_at),
            rawDate: a.created_at
        }))
    ].sort((a, b) => b.tanggal - a.tanggal);
%>

<!-- HEADER MODUL LAPORAN -->
<header class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div>
        <div class="flex items-center gap-2 mb-1 flex-wrap">
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-orange-100 text-orange-700 border border-orange-200">
                Laporan & Rekapitulasi Kinerja
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300">
                Format Resmi Ber-KOP (Terbaru)
            </span>
            <span class="text-xs text-slate-400">• Standar Akuntabilitas SPBE</span>
        </div>
        <h2 class="text-2xl font-bold text-navy-900 mb-1">Pusat Laporan & Rekapitulasi Kedinasan</h2>
        <p class="text-slate-500 text-sm">Unduh rekapitulasi data permohonan persuratan, pengaduan masyarakat, serta cetak laporan resmi ber-Kop Surat dinas.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2.5">
        <!-- 1. Tombol Cetak Dokumen Resmi PDF -->
        <button type="button" onclick="openPrintReportModal()" class="bg-navy-900 hover:bg-slate-800 text-white font-bold px-4 py-2.5 rounded-xl flex items-center gap-2 text-xs transition-all shadow-md active:scale-95">
            <i data-lucide="printer" class="w-4 h-4 text-orange-400"></i> Cetak Laporan Resmi (PDF)
        </button>

        <!-- 2. Tombol Unduh Lembar Kerja Excel Langsung (Sekali Klik) -->
        <button type="button" onclick="exportReportToExcel('SEMUA')" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2.5 rounded-xl flex items-center gap-2 text-xs transition-all shadow-md shadow-emerald-600/20 active:scale-95" title="Unduh berkas Excel resmi ber-Kop Surat dan anti-notasi ilmiah">
            <i data-lucide="file-spreadsheet" class="w-4 h-4"></i> Unduh Excel Resmi (.xls)
        </button>

        <!-- 3. Dropdown Opsi Filter / Format Lain -->
        <div class="relative inline-block text-left" id="exportDropdownWrap">
            <button type="button" onclick="toggleExportMenu()" class="bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold px-3 py-2.5 rounded-xl flex items-center gap-1.5 text-xs transition-all border border-slate-200 dark:border-slate-700 active:scale-95">
                <i data-lucide="filter" class="w-3.5 h-3.5 text-slate-500"></i> Filter Ekspor <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
            </button>
            <div id="exportMenu" class="hidden absolute right-0 mt-2 w-72 rounded-2xl shadow-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 ring-1 ring-black/5 z-30 py-2 divide-y divide-slate-100 dark:divide-slate-800">
                <div class="px-4 py-2 bg-slate-50 dark:bg-slate-800/50">
                    <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">Filter Khusus Lembar Excel (.xls)</span>
                    <p class="text-[10px] text-slate-400 mt-0.5">Ber-Kop Surat Pemkab Bekasi & anti notasi ilmiah</p>
                </div>
                <div class="py-1">
                    <button type="button" onclick="exportReportToExcel('SURAT')" class="w-full text-left px-4 py-2 text-xs text-slate-700 dark:text-slate-200 hover:bg-orange-50 dark:hover:bg-orange-950/30 hover:text-orange-600 flex items-center gap-2.5 font-medium transition-colors">
                        <i data-lucide="mail" class="w-4 h-4 text-orange-500"></i> Hanya Rekap Persuratan Mandiri (.xls)
                    </button>
                    <button type="button" onclick="exportReportToExcel('ADUAN')" class="w-full text-left px-4 py-2 text-xs text-slate-700 dark:text-slate-200 hover:bg-orange-50 dark:hover:bg-orange-950/30 hover:text-orange-600 flex items-center gap-2.5 font-medium transition-colors">
                        <i data-lucide="message-square-warning" class="w-4 h-4 text-orange-500"></i> Hanya Rekap Pengaduan Warga (.xls)
                    </button>
                </div>
                <div class="px-4 py-1.5 bg-slate-50 dark:bg-slate-800/50">
                    <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">Format Mentah Alternatif</span>
                </div>
                <div class="py-1">
                    <button type="button" onclick="exportReportToCSV('SEMUA')" class="w-full text-left px-4 py-2 text-xs text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2.5 font-medium transition-colors">
                        <i data-lucide="file-text" class="w-4 h-4 text-slate-400"></i> Ekspor CSV Mentah (Semua)
                    </button>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- 4 KARTU METRIK RINGKASAN KPI -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <!-- Card 1: Surat Masuk -->
    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Persuratan Mandiri</span>
            <div class="w-9 h-9 bg-orange-100 text-orange-600 rounded-xl flex items-center justify-center">
                <i data-lucide="mail-check" class="w-5 h-5"></i>
            </div>
        </div>
        <div>
            <div class="flex items-baseline gap-2">
                <h3 class="text-2xl font-black text-navy-900"><%= totalSurat %></h3>
                <span class="text-xs text-slate-500 font-semibold">Berkas Masuk</span>
            </div>
            <div class="mt-3 flex items-center justify-between text-xs text-slate-500 border-t border-slate-100 pt-2.5">
                <span class="text-emerald-600 font-bold"><%= suratDisetujui %> Disetujui (<%= rateSuratDisetujui %>%)</span>
                <span class="text-amber-600 font-semibold"><%= suratDiproses + suratMenunggu %> Proses</span>
            </div>
        </div>
    </div>

    <!-- Card 2: Pengaduan Warga -->
    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Aduan & Lapor Warga</span>
            <div class="w-9 h-9 bg-rose-100 text-rose-600 rounded-xl flex items-center justify-center">
                <i data-lucide="megaphone" class="w-5 h-5"></i>
            </div>
        </div>
        <div>
            <div class="flex items-baseline gap-2">
                <h3 class="text-2xl font-black text-navy-900"><%= totalAduan %></h3>
                <span class="text-xs text-slate-500 font-semibold">Laporan Masuk</span>
            </div>
            <div class="mt-3 flex items-center justify-between text-xs text-slate-500 border-t border-slate-100 pt-2.5">
                <span class="text-emerald-600 font-bold"><%= aduanSelesai %> Selesai (<%= rateAduanSelesai %>%)</span>
                <span class="text-amber-600 font-semibold"><%= aduanDiproses + aduanTerkirim %> Proses</span>
            </div>
        </div>
    </div>

    <!-- Card 3: SLA Penyelesaian -->
    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Rasio Ketuntasan</span>
            <div class="w-9 h-9 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center">
                <i data-lucide="check-check" class="w-5 h-5"></i>
            </div>
        </div>
        <div>
            <% /* Variabel totalGabungan, totalTuntas & overallSuccessRate telah diagregasi secara terpusat di blok atas */ %>
            <div class="flex items-baseline gap-2">
                <h3 class="text-2xl font-black text-emerald-600"><%= overallSuccessRate %>%</h3>
                <span class="text-xs text-slate-500 font-semibold">Tuntas Dilayani</span>
            </div>
            <div class="mt-3 flex items-center justify-between text-xs text-slate-500 border-t border-slate-100 pt-2.5">
                <span><%= totalTuntas %> dari <%= totalGabungan %> Berkas</span>
                <span class="text-emerald-600 font-bold">Kinerja Prima</span>
            </div>
        </div>
    </div>

    <!-- Card 4: Periode & Wilayah -->
    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Cakupan Wilayah</span>
            <div class="w-9 h-9 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center">
                <i data-lucide="map-pin" class="w-5 h-5"></i>
            </div>
        </div>
        <div>
            <div class="flex items-baseline gap-2">
                <h3 class="text-2xl font-black text-navy-900">23</h3>
                <span class="text-xs text-slate-500 font-semibold">Kecamatan Aktif</span>
            </div>
            <div class="mt-3 flex items-center justify-between text-xs text-slate-500 border-t border-slate-100 pt-2.5">
                <span>Kab. Bekasi • 187 Desa</span>
                <span class="text-orange-500 font-bold">Tahun 2026</span>
            </div>
        </div>
    </div>
</div>

<!-- FILTER DINAMIS & SEARCH BAR -->
<div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm mb-6">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        
        <!-- Filter Kategori & Status -->
        <div class="flex flex-wrap items-center gap-3">
            <div>
                <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Jenis Layanan</label>
                <select id="reportFilterTipe" onchange="applyReportFilter()" class="border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold focus:ring-2 focus:ring-orange-500 outline-none bg-white">
                    <option value="ALL">Semua Layanan (Surat & Aduan)</option>
                    <option value="SURAT">Layanan Persuratan Saja</option>
                    <option value="ADUAN">Pengaduan Warga Saja</option>
                </select>
            </div>

            <div>
                <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Status Berkas</label>
                <select id="reportFilterStatus" onchange="applyReportFilter()" class="border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold focus:ring-2 focus:ring-orange-500 outline-none bg-white">
                    <option value="ALL">Semua Status</option>
                    <option value="Disetujui">Disetujui / Selesai</option>
                    <option value="Diproses">Sedang Diproses</option>
                    <option value="Menunggu">Menunggu / Terkirim</option>
                    <option value="Ditolak">Ditolak</option>
                </select>
            </div>

            <div>
                <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Rentang Tanggal</label>
                <div class="flex items-center gap-2">
                    <input type="date" id="reportFilterStartDate" onchange="applyReportFilter()" class="border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-medium focus:ring-2 focus:ring-orange-500 outline-none bg-white">
                    <span class="text-slate-400 text-xs">s/d</span>
                    <input type="date" id="reportFilterEndDate" onchange="applyReportFilter()" class="border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-medium focus:ring-2 focus:ring-orange-500 outline-none bg-white">
                </div>
            </div>
        </div>

        <!-- Search Bar & Tombol Reset -->
        <div class="flex items-end gap-2">
            <div class="w-full sm:w-64">
                <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Cari Data</label>
                <div class="relative">
                    <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-2.5"></i>
                    <input type="text" id="reportSearchInput" onkeyup="applyReportFilter()" placeholder="Cari nama, NIK, kode tiket..." class="w-full pl-9 pr-4 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-orange-500 outline-none">
                </div>
            </div>
            <button type="button" onclick="resetReportFilter()" class="px-3.5 py-2 text-xs font-bold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-xl transition-all flex items-center gap-1.5 whitespace-nowrap" title="Atur ulang filter">
                <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> Atur Ulang
            </button>
        </div>

    </div>
</div>

<!-- TABEL REKAPITULASI DOKUMEN -->
<div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden mb-8">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
        <div class="flex items-center gap-2">
            <h3 class="font-bold text-navy-900 text-sm">Daftar Transaksi Rekapitulasi</h3>
            <span id="reportRowCount" class="bg-slate-100 text-slate-600 text-xs font-bold px-2.5 py-0.5 rounded-full"><%= allRecords.length %> Data</span>
        </div>
        <span class="text-xs text-slate-400">Diperbarui langsung dari pangkalan data</span>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full min-w-[780px] text-left border-collapse" id="reportTable">
            <thead>
                <tr class="bg-slate-50/80 border-b border-slate-100 text-[11px] font-extrabold uppercase tracking-wider text-slate-500">
                    <th class="py-3.5 px-4 text-center w-12">No</th>
                    <th class="py-3.5 px-4">Jenis</th>
                    <th class="py-3.5 px-4">No. Registrasi / Tiket</th>
                    <th class="py-3.5 px-4">Nama Pemohon / Pelapor</th>
                    <th class="py-3.5 px-4">NIK & Kontak</th>
                    <th class="py-3.5 px-4">Perihal / Keperluan</th>
                    <th class="py-3.5 px-4">Tanggal Masuk</th>
                    <th class="py-3.5 px-4 text-center">Status</th>
                    <th class="py-3.5 px-4 text-center">Tindakan</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-xs">
                <% if (allRecords.length === 0) { %>
                    <tr>
                        <td colspan="9" class="py-12 text-center text-slate-400">
                            <i data-lucide="folder-x" class="w-10 h-10 mx-auto text-slate-300 mb-2"></i>
                            <p class="font-medium">Belum ada transaksi surat atau pengaduan masuk di sistem.</p>
                        </td>
                    </tr>
                <% } else { %>
                    <% allRecords.forEach((item, idx) => { %>
                        <tr class="report-row hover:bg-slate-50/60 transition-colors" 
                            data-tipe="<%= item.tipe %>" 
                            data-status="<%= item.status %>" 
                            data-date="<%= item.rawDate %>"
                            data-kode="<%= item.kode %>"
                            data-nama="<%= item.nama %>"
                            data-nik="<%= item.nik || '-' %>"
                            data-kontak="<%= item.kontak || '-' %>"
                            data-perihal="<%= item.perihal %>"
                            data-tanggal="<%= item.tanggal.toLocaleDateString('id-ID') %>"
                            data-search="<%= (item.kode + ' ' + item.nama + ' ' + item.nik + ' ' + item.perihal).toLowerCase() %>">
                            <td class="py-3.5 px-4 text-center font-bold text-slate-400"><%= idx + 1 %></td>
                            <td class="py-3.5 px-4">
                                <% if (item.tipe === 'SURAT') { %>
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">
                                        <i data-lucide="mail" class="w-3 h-3"></i> Surat
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                        <i data-lucide="megaphone" class="w-3 h-3"></i> Aduan
                                    </span>
                                <% } %>
                            </td>
                            <td class="py-3.5 px-4 font-bold text-navy-900 font-mono text-xs"><%= item.kode %></td>
                            <td class="py-3.5 px-4 font-semibold text-slate-800"><%= item.nama %></td>
                            <td class="py-3.5 px-4 text-slate-500">
                                <span class="font-mono text-[11px]"><%= item.nik ? item.nik.substring(0, 6) + '******' + item.nik.substring(12) : '-' %></span>
                                <span class="block text-[11px] text-slate-400"><%= item.kontak || '-' %></span>
                            </td>
                            <td class="py-3.5 px-4 text-slate-600 max-w-xs truncate" title="<%= item.perihal %>"><%= item.perihal %></td>
                            <td class="py-3.5 px-4 text-slate-500 whitespace-nowrap">
                                <%= item.tanggal.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                <span class="block text-[10px] text-slate-400"><%= item.tanggal.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB</span>
                            </td>
                            <td class="py-3.5 px-4 text-center">
                                <% if (item.status === 'Disetujui' || item.status === 'Selesai') { %>
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 inline-block">
                                        <%= item.status %>
                                    </span>
                                <% } else if (item.status === 'Diproses') { %>
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200 inline-block">
                                        Diproses
                                    </span>
                                <% } else if (item.status === 'Ditolak') { %>
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-rose-50 text-rose-700 border border-rose-200 inline-block">
                                        Ditolak
                                    </span>
                                <% } else { %>
                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 text-slate-700 border border-slate-200 inline-block">
                                        Menunggu
                                    </span>
                                <% } %>
                            </td>
                            <td class="py-3.5 px-4 text-center">
                                <% if (item.tipe === 'SURAT') { %>
                                    <a href="/surat/cetak/<%= item.kode %>" target="_blank" class="p-1.5 text-slate-400 hover:text-navy-900 rounded-lg hover:bg-slate-100 transition-colors inline-block" title="Lihat Tanda Terima">
                                        <i data-lucide="printer" class="w-4 h-4"></i>
                                    </a>
                                <% } else { %>
                                    <button type="button" onclick="if(typeof switchAdminTab === 'function'){ switchAdminTab('aduan'); } else { window.location.href='?tab=aduan'; }" class="p-1.5 text-slate-400 hover:text-navy-900 rounded-lg hover:bg-slate-100 transition-colors inline-block" title="Buka Rincian Pengaduan">
                                        <i data-lucide="eye" class="w-4 h-4"></i>
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- ============================================================== -->
<!-- MODAL CETAK LAPORAN RESMI BER-KOP SURAT (FULL VIEWPORT VIEWER) -->
<!-- ============================================================== -->
<div id="modalPrintReport" 
     class="fixed inset-0 z-[999999] hidden flex-col w-screen h-screen bg-slate-950/95 backdrop-blur-md transition-all select-none overflow-hidden"
     role="dialog" 
     aria-modal="true"
     aria-labelledby="modalPrintTitle">
    
    <!-- 1. TOP BAR TERKUNCI PERMANEN DI PALING ATAS (TIDAK PERNAH HILANG / TERPOTONG DI ZOOM 100%) -->
    <header class="shrink-0 h-16 bg-slate-900 border-b border-slate-800 px-4 sm:px-8 flex items-center justify-between text-white shadow-xl z-50 no-print">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-orange-500/20 text-orange-400 border border-orange-500/30 flex items-center justify-center font-bold shrink-0">
                <i data-lucide="printer" class="w-5 h-5"></i>
            </div>
            <div>
                <h3 id="modalPrintTitle" class="font-extrabold text-sm sm:text-base text-white flex items-center gap-2">
                    Pratinjau Dokumen Kedinasan (PDF)
